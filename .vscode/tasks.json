{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",        
            "command": "make",
            "args": [],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Build the project using arm-none-eabi-gcc"
        },
        {
            "type": "shell",
            "label": "flash",
            "command": "openocd",
            "args": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f4x.cfg",
                "-c",
                "program ${workspaceFolder}/build/quadcopter.elf verify reset exit"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Flash the quadcopter firmware using OpenOCD"
        },
        {
            "type": "shell",
            "label": "clean",
            "command": "make clean",
            "args": [],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Clean up build files"
        }
    ]

}
