 203:./system/core_cmInstr.h ****     s--;
 204:./system/core_cmInstr.h ****   }
 205:./system/core_cmInstr.h ****   result <<= s;                       // shift when v's highest bits are zero
 206:./system/core_cmInstr.h ****   return(result);
 207:./system/core_cmInstr.h **** }
