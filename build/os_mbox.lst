 653:./ucos/Core/os_mbox.c **** /*
 654:./ucos/Core/os_mbox.c **** ***************************************************************************************************
 655:./ucos/Core/os_mbox.c **** *                                       QUERY A MESSAGE MAILBOX
 656:./ucos/Core/os_mbox.c **** *
 657:./ucos/Core/os_mbox.c **** * Description: This function obtains information about a message mailbox.
 658:./ucos/Core/os_mbox.c **** *
 659:./ucos/Core/os_mbox.c **** * Arguments  : pevent        is a pointer to the event control block associated with the desired ma
 660:./ucos/Core/os_mbox.c **** *
 661:./ucos/Core/os_mbox.c **** *              p_mbox_data   is a pointer to a structure that will contain information about the me
 662:./ucos/Core/os_mbox.c **** *                            mailbox.
 663:./ucos/Core/os_mbox.c **** *
 664:./ucos/Core/os_mbox.c **** * Returns    : OS_ERR_NONE         The call was successful and the message was sent
 665:./ucos/Core/os_mbox.c **** *              OS_ERR_EVENT_TYPE   If you are attempting to obtain data from a non mailbox.
 666:./ucos/Core/os_mbox.c **** *              OS_ERR_PEVENT_NULL  If 'pevent'      is a NULL pointer
 667:./ucos/Core/os_mbox.c **** *              OS_ERR_PDATA_NULL   If 'p_mbox_data' is a NULL pointer
 668:./ucos/Core/os_mbox.c **** ***************************************************************************************************
 669:./ucos/Core/os_mbox.c **** */
 670:./ucos/Core/os_mbox.c **** 
 671:./ucos/Core/os_mbox.c **** #if OS_MBOX_QUERY_EN > 0u
