  38:./ucos/Core/os_mbox.c **** /*
  39:./ucos/Core/os_mbox.c **** ***************************************************************************************************
  40:./ucos/Core/os_mbox.c **** *                                        ACCEPT MESSAGE FROM MAILBOX
  41:./ucos/Core/os_mbox.c **** *
  42:./ucos/Core/os_mbox.c **** * Description: This function checks the mailbox to see if a message is available.  Unlike OSMboxPen
  43:./ucos/Core/os_mbox.c **** *              OSMboxAccept() does not suspend the calling task if a message is not available.
  44:./ucos/Core/os_mbox.c **** *
  45:./ucos/Core/os_mbox.c **** * Arguments  : pevent        is a pointer to the event control block
  46:./ucos/Core/os_mbox.c **** *
  47:./ucos/Core/os_mbox.c **** * Returns    : != (void *)0  is the message in the mailbox if one is available.  The mailbox is cle
  48:./ucos/Core/os_mbox.c **** *                            so the next time OSMboxAccept() is called, the mailbox will be empty.
  49:./ucos/Core/os_mbox.c **** *              == (void *)0  if the mailbox is empty or,
  50:./ucos/Core/os_mbox.c **** *                            if 'pevent' is a NULL pointer or,
  51:./ucos/Core/os_mbox.c **** *                            if you didn't pass the proper event pointer.
  52:./ucos/Core/os_mbox.c **** ***************************************************************************************************
  53:./ucos/Core/os_mbox.c **** */
