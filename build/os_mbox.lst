 566:./ucos/Core/os_mbox.c **** /*
 567:./ucos/Core/os_mbox.c **** ***************************************************************************************************
 568:./ucos/Core/os_mbox.c **** *                                      POST MESSAGE TO A MAILBOX
 569:./ucos/Core/os_mbox.c **** *
 570:./ucos/Core/os_mbox.c **** * Description: This function sends a message to a mailbox
 571:./ucos/Core/os_mbox.c **** *
 572:./ucos/Core/os_mbox.c **** * Arguments  : pevent        is a pointer to the event control block associated with the desired ma
 573:./ucos/Core/os_mbox.c **** *
 574:./ucos/Core/os_mbox.c **** *              pmsg          is a pointer to the message to send.  You MUST NOT send a NULL pointer
 575:./ucos/Core/os_mbox.c **** *
 576:./ucos/Core/os_mbox.c **** *              opt           determines the type of POST performed:
 577:./ucos/Core/os_mbox.c **** *                            OS_POST_OPT_NONE         POST to a single waiting task
 578:./ucos/Core/os_mbox.c **** *                                                     (Identical to OSMboxPost())
 579:./ucos/Core/os_mbox.c **** *                            OS_POST_OPT_BROADCAST    POST to ALL tasks that are waiting on the mai
 580:./ucos/Core/os_mbox.c **** *
 581:./ucos/Core/os_mbox.c **** *                            OS_POST_OPT_NO_SCHED     Indicates that the scheduler will NOT be invo
 582:./ucos/Core/os_mbox.c **** *
 583:./ucos/Core/os_mbox.c **** * Returns    : OS_ERR_NONE          The call was successful and the message was sent
 584:./ucos/Core/os_mbox.c **** *              OS_ERR_MBOX_FULL     If the mailbox already contains a message.  You can can only se
 585:./ucos/Core/os_mbox.c **** *                                   message at a time and thus, the message MUST be consumed before
 586:./ucos/Core/os_mbox.c **** *                                   are allowed to send another one.
 587:./ucos/Core/os_mbox.c **** *              OS_ERR_EVENT_TYPE    If you are attempting to post to a non mailbox.
 588:./ucos/Core/os_mbox.c **** *              OS_ERR_PEVENT_NULL   If 'pevent' is a NULL pointer
 589:./ucos/Core/os_mbox.c **** *              OS_ERR_POST_NULL_PTR If you are attempting to post a NULL pointer
 590:./ucos/Core/os_mbox.c **** *
 591:./ucos/Core/os_mbox.c **** * Note(s)    : 1) HPT means Highest Priority Task
 592:./ucos/Core/os_mbox.c **** *
 593:./ucos/Core/os_mbox.c **** * Warning    : Interrupts can be disabled for a long time if you do a 'broadcast'.  In fact, the
 594:./ucos/Core/os_mbox.c **** *              interrupt disable time is proportional to the number of tasks waiting on the mailbox
 595:./ucos/Core/os_mbox.c **** ***************************************************************************************************
 596:./ucos/Core/os_mbox.c **** */
