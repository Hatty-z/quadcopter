 284:./ucos/Core/os_mbox.c **** /*
 285:./ucos/Core/os_mbox.c **** ***************************************************************************************************
 286:./ucos/Core/os_mbox.c **** *                                    PEND ON MAILBOX FOR A MESSAGE
 287:./ucos/Core/os_mbox.c **** *
 288:./ucos/Core/os_mbox.c **** * Description: This function waits for a message to be sent to a mailbox
 289:./ucos/Core/os_mbox.c **** *
 290:./ucos/Core/os_mbox.c **** * Arguments  : pevent        is a pointer to the event control block associated with the desired ma
 291:./ucos/Core/os_mbox.c **** *
 292:./ucos/Core/os_mbox.c **** *              timeout       is an optional timeout period (in clock ticks).  If non-zero, your tas
 293:./ucos/Core/os_mbox.c **** *                            wait for a message to arrive at the mailbox up to the amount of time
 294:./ucos/Core/os_mbox.c **** *                            specified by this argument.  If you specify 0, however, your task will
 295:./ucos/Core/os_mbox.c **** *                            forever at the specified mailbox or, until a message arrives.
 296:./ucos/Core/os_mbox.c **** *
 297:./ucos/Core/os_mbox.c **** *              perr          is a pointer to where an error message will be deposited.  Possible er
 298:./ucos/Core/os_mbox.c **** *                            messages are:
 299:./ucos/Core/os_mbox.c **** *
 300:./ucos/Core/os_mbox.c **** *                            OS_ERR_NONE         The call was successful and your task received a
 301:./ucos/Core/os_mbox.c **** *                                                message.
 302:./ucos/Core/os_mbox.c **** *                            OS_ERR_TIMEOUT      A message was not received within the specified 't
 303:./ucos/Core/os_mbox.c **** *                            OS_ERR_PEND_ABORT   The wait on the mailbox was aborted.
 304:./ucos/Core/os_mbox.c **** *                            OS_ERR_EVENT_TYPE   Invalid event type
 305:./ucos/Core/os_mbox.c **** *                            OS_ERR_PEND_ISR     If you called this function from an ISR and the re
 306:./ucos/Core/os_mbox.c **** *                                                would lead to a suspension.
 307:./ucos/Core/os_mbox.c **** *                            OS_ERR_PEVENT_NULL  If 'pevent' is a NULL pointer
 308:./ucos/Core/os_mbox.c **** *                            OS_ERR_PEND_LOCKED  If you called this function when the scheduler is 
 309:./ucos/Core/os_mbox.c **** *
 310:./ucos/Core/os_mbox.c **** * Returns    : != (void *)0  is a pointer to the message received
ARM GAS  /tmp/ccuhOAEu.s 			page 16


 311:./ucos/Core/os_mbox.c **** *              == (void *)0  if no message was received or,
 312:./ucos/Core/os_mbox.c **** *                            if 'pevent' is a NULL pointer or,
 313:./ucos/Core/os_mbox.c **** *                            if you didn't pass the proper pointer to the event control block.
 314:./ucos/Core/os_mbox.c **** ***************************************************************************************************
 315:./ucos/Core/os_mbox.c **** */
