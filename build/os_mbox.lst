 138:./ucos/Core/os_mbox.c **** /*
 139:./ucos/Core/os_mbox.c **** ***************************************************************************************************
ARM GAS  /tmp/ccuhOAEu.s 			page 7


 140:./ucos/Core/os_mbox.c **** *                                           DELETE A MAIBOX
 141:./ucos/Core/os_mbox.c **** *
 142:./ucos/Core/os_mbox.c **** * Description: This function deletes a mailbox and readies all tasks pending on the mailbox.
 143:./ucos/Core/os_mbox.c **** *
 144:./ucos/Core/os_mbox.c **** * Arguments  : pevent        is a pointer to the event control block associated with the desired
 145:./ucos/Core/os_mbox.c **** *                            mailbox.
 146:./ucos/Core/os_mbox.c **** *
 147:./ucos/Core/os_mbox.c **** *              opt           determines delete options as follows:
 148:./ucos/Core/os_mbox.c **** *                            opt == OS_DEL_NO_PEND   Delete the mailbox ONLY if no task pending
 149:./ucos/Core/os_mbox.c **** *                            opt == OS_DEL_ALWAYS    Deletes the mailbox even if tasks are waiting.
 150:./ucos/Core/os_mbox.c **** *                                                    In this case, all the tasks pending will be re
 151:./ucos/Core/os_mbox.c **** *
 152:./ucos/Core/os_mbox.c **** *              perr          is a pointer to an error code that can contain one of the following va
 153:./ucos/Core/os_mbox.c **** *                            OS_ERR_NONE                  The call was successful and the mailbox w
 154:./ucos/Core/os_mbox.c **** *                            OS_ERR_DEL_ISR               If you attempted to delete the mailbox fr
 155:./ucos/Core/os_mbox.c **** *                            OS_ERR_INVALID_OPT           An invalid option was specified
 156:./ucos/Core/os_mbox.c **** *                            OS_ERR_ILLEGAL_DEL_RUN_TIME  If you tried to delete a mailbox after sa
 157:./ucos/Core/os_mbox.c **** *                                                         critical operation started.
 158:./ucos/Core/os_mbox.c **** *                            OS_ERR_TASK_WAITING          One or more tasks were waiting on the mai
 159:./ucos/Core/os_mbox.c **** *                            OS_ERR_EVENT_TYPE            If you didn't pass a pointer to a mailbox
 160:./ucos/Core/os_mbox.c **** *                            OS_ERR_PEVENT_NULL           If 'pevent' is a NULL pointer.
 161:./ucos/Core/os_mbox.c **** *
 162:./ucos/Core/os_mbox.c **** * Returns    : pevent        upon error
 163:./ucos/Core/os_mbox.c **** *              (OS_EVENT *)0 if the mailbox was successfully deleted.
 164:./ucos/Core/os_mbox.c **** *
 165:./ucos/Core/os_mbox.c **** * Note(s)    : 1) This function must be used with care.  Tasks that would normally expect the prese
 166:./ucos/Core/os_mbox.c **** *                 the mailbox MUST check the return code of OSMboxPend().
 167:./ucos/Core/os_mbox.c **** *              2) OSMboxAccept() callers will not know that the intended mailbox has been deleted!
 168:./ucos/Core/os_mbox.c **** *              3) This call can potentially disable interrupts for a long time.  The interrupt disa
 169:./ucos/Core/os_mbox.c **** *                 time is directly proportional to the number of tasks waiting on the mailbox.
 170:./ucos/Core/os_mbox.c **** *              4) Because ALL tasks pending on the mailbox will be readied, you MUST be careful in
 171:./ucos/Core/os_mbox.c **** *                 applications where the mailbox is used for mutual exclusion because the resource(
 172:./ucos/Core/os_mbox.c **** *                 will no longer be guarded by the mailbox.
 173:./ucos/Core/os_mbox.c **** *              5) All tasks that were waiting for the mailbox will be readied and returned an
 174:./ucos/Core/os_mbox.c **** *                 OS_ERR_PEND_ABORT if OSMboxDel() was called with OS_DEL_ALWAYS
