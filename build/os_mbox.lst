 407:./ucos/Core/os_mbox.c **** /*
 408:./ucos/Core/os_mbox.c **** ***************************************************************************************************
 409:./ucos/Core/os_mbox.c **** *                                     ABORT WAITING ON A MESSAGE MAILBOX
 410:./ucos/Core/os_mbox.c **** *
 411:./ucos/Core/os_mbox.c **** * Description: This function aborts & readies any tasks currently waiting on a mailbox.  This funct
 412:./ucos/Core/os_mbox.c **** *              should be used to fault-abort the wait on the mailbox, rather than to normally signa
 413:./ucos/Core/os_mbox.c **** *              the mailbox via OSMboxPost() or OSMboxPostOpt().
 414:./ucos/Core/os_mbox.c **** *
 415:./ucos/Core/os_mbox.c **** * Arguments  : pevent        is a pointer to the event control block associated with the desired ma
 416:./ucos/Core/os_mbox.c **** *
 417:./ucos/Core/os_mbox.c **** *              opt           determines the type of ABORT performed:
 418:./ucos/Core/os_mbox.c **** *                            OS_PEND_OPT_NONE         ABORT wait for a single task (HPT) waiting on
ARM GAS  /tmp/ccuhOAEu.s 			page 24


 419:./ucos/Core/os_mbox.c **** *                                                     mailbox
 420:./ucos/Core/os_mbox.c **** *                            OS_PEND_OPT_BROADCAST    ABORT wait for ALL tasks that are  waiting on
 421:./ucos/Core/os_mbox.c **** *                                                     mailbox
 422:./ucos/Core/os_mbox.c **** *
 423:./ucos/Core/os_mbox.c **** *              perr          is a pointer to where an error message will be deposited.  Possible er
 424:./ucos/Core/os_mbox.c **** *                            messages are:
 425:./ucos/Core/os_mbox.c **** *
 426:./ucos/Core/os_mbox.c **** *                            OS_ERR_NONE         No tasks were     waiting on the mailbox.
 427:./ucos/Core/os_mbox.c **** *                            OS_ERR_PEND_ABORT   At least one task waiting on the mailbox was readi
 428:./ucos/Core/os_mbox.c **** *                                                and informed of the aborted wait; check return val
 429:./ucos/Core/os_mbox.c **** *                                                for the number of tasks whose wait on the mailbox
 430:./ucos/Core/os_mbox.c **** *                                                was aborted.
 431:./ucos/Core/os_mbox.c **** *                            OS_ERR_EVENT_TYPE   If you didn't pass a pointer to a mailbox.
 432:./ucos/Core/os_mbox.c **** *                            OS_ERR_PEVENT_NULL  If 'pevent' is a NULL pointer.
 433:./ucos/Core/os_mbox.c **** *
 434:./ucos/Core/os_mbox.c **** * Returns    : == 0          if no tasks were waiting on the mailbox, or upon error.
 435:./ucos/Core/os_mbox.c **** *              >  0          if one or more tasks waiting on the mailbox are now readied and inform
 436:./ucos/Core/os_mbox.c **** ***************************************************************************************************
 437:./ucos/Core/os_mbox.c **** */
