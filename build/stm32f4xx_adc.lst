 208:./Libraries/src/stm32f4xx_adc.c ****   * @brief  Deinitializes all ADCs peripherals registers to their default reset 
 209:./Libraries/src/stm32f4xx_adc.c ****   *         values.
 210:./Libraries/src/stm32f4xx_adc.c ****   * @param  None
 211:./Libraries/src/stm32f4xx_adc.c ****   * @retval None
 212:./Libraries/src/stm32f4xx_adc.c ****   */
 213:./Libraries/src/stm32f4xx_adc.c **** void ADC_DeInit(void)
 214:./Libraries/src/stm32f4xx_adc.c **** {
  29              		.loc 1 214 1 view -0
  30              		.cfi_startproc
  31              		@ args = 0, pretend = 0, frame = 0
  32              		@ frame_needed = 0, uses_anonymous_args = 0
  33 0000 08B5     		push	{r3, lr}
  34              	.LCFI0:
  35              		.cfi_def_cfa_offset 8
  36              		.cfi_offset 3, -8
  37              		.cfi_offset 14, -4
 215:./Libraries/src/stm32f4xx_adc.c ****   /* Enable all ADCs reset state */
 216:./Libraries/src/stm32f4xx_adc.c ****   RCC_APB2PeriphResetCmd(RCC_APB2Periph_ADC, ENABLE);
  38              		.loc 1 216 3 view .LVU1
  39 0002 0121     		movs	r1, #1
  40 0004 4FF48070 		mov	r0, #256
  41 0008 FFF7FEFF 		bl	RCC_APB2PeriphResetCmd
  42              	.LVL0:
 217:./Libraries/src/stm32f4xx_adc.c ****   
 218:./Libraries/src/stm32f4xx_adc.c ****   /* Release all ADCs from reset state */
 219:./Libraries/src/stm32f4xx_adc.c ****   RCC_APB2PeriphResetCmd(RCC_APB2Periph_ADC, DISABLE);
  43              		.loc 1 219 3 view .LVU2
  44 000c 0021     		movs	r1, #0
  45 000e 4FF48070 		mov	r0, #256
  46 0012 FFF7FEFF 		bl	RCC_APB2PeriphResetCmd
  47              	.LVL1:
 220:./Libraries/src/stm32f4xx_adc.c **** }
  48              		.loc 1 220 1 is_stmt 0 view .LVU3
  49 0016 08BD     		pop	{r3, pc}
