1652:./ucos/Core/os_core.c **** *                                       COPY A BLOCK OF MEMORY
1653:./ucos/Core/os_core.c **** *
1654:./ucos/Core/os_core.c **** * Description: This function is called by other uC/OS-II services to copy a block of memory from on
1655:./ucos/Core/os_core.c **** *              location to another.
1656:./ucos/Core/os_core.c **** *
1657:./ucos/Core/os_core.c **** * Arguments  : pdest    is a pointer to the 'destination' memory block
1658:./ucos/Core/os_core.c **** *
1659:./ucos/Core/os_core.c **** *              psrc     is a pointer to the 'source'      memory block
1660:./ucos/Core/os_core.c **** *
1661:./ucos/Core/os_core.c **** *              size     is the number of bytes to copy.
1662:./ucos/Core/os_core.c **** *
1663:./ucos/Core/os_core.c **** * Returns    : none
1664:./ucos/Core/os_core.c **** *
1665:./ucos/Core/os_core.c **** * Notes      : 1) This function is INTERNAL to uC/OS-II and your application should not call it.  T
1666:./ucos/Core/os_core.c **** *                 no provision to handle overlapping memory copy.  However, that's not a problem si
1667:./ucos/Core/os_core.c **** *                 is not a situation that will happen.
1668:./ucos/Core/os_core.c **** *              2) Note that we can only copy up to 64K bytes of RAM
1669:./ucos/Core/os_core.c **** *              3) The copy is done one byte at a time since this will work on any processor irrespe
1670:./ucos/Core/os_core.c **** *                 of the alignment of the source and destination.
1671:./ucos/Core/os_core.c **** ***************************************************************************************************
1672:./ucos/Core/os_core.c **** */
1673:./ucos/Core/os_core.c **** 
1674:./ucos/Core/os_core.c **** void  OS_MemCopy (INT8U  *pdest,
1675:./ucos/Core/os_core.c ****                   INT8U  *psrc,
1676:./ucos/Core/os_core.c ****                   INT16U  size)
1677:./ucos/Core/os_core.c **** {
1678:./ucos/Core/os_core.c ****     while (size > 0u) {
1679:./ucos/Core/os_core.c ****         *pdest++ = *psrc++;
1680:./ucos/Core/os_core.c ****         size--;
1681:./ucos/Core/os_core.c ****     }
1682:./ucos/Core/os_core.c **** }
