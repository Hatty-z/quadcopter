1856:./ucos/Core/os_core.c **** /*
1857:./ucos/Core/os_core.c **** ***************************************************************************************************
1858:./ucos/Core/os_core.c **** *                                           STATISTICS TASK
1859:./ucos/Core/os_core.c **** *
1860:./ucos/Core/os_core.c **** * Description: This task is internal to uC/OS-II and is used to compute some statistics about the
1861:./ucos/Core/os_core.c **** *              multitasking environment.  Specifically, OS_TaskStat() computes the CPU usage.
1862:./ucos/Core/os_core.c **** *              CPU usage is determined by:
1863:./ucos/Core/os_core.c **** *
1864:./ucos/Core/os_core.c **** *                                          OSIdleCtr
1865:./ucos/Core/os_core.c **** *                 OSCPUUsage = 100 * (1 - ------------)     (units are in %)
1866:./ucos/Core/os_core.c **** *                                         OSIdleCtrMax
1867:./ucos/Core/os_core.c **** *
1868:./ucos/Core/os_core.c **** * Arguments  : parg     this pointer is not used at this time.
1869:./ucos/Core/os_core.c **** *
1870:./ucos/Core/os_core.c **** * Returns    : none
1871:./ucos/Core/os_core.c **** *
1872:./ucos/Core/os_core.c **** * Notes      : 1) This task runs at a priority level higher than the idle task.  In fact, it runs a
1873:./ucos/Core/os_core.c **** *                 next higher priority, OS_TASK_IDLE_PRIO-1.
1874:./ucos/Core/os_core.c **** *              2) You can disable this task by setting the configuration #define OS_TASK_STAT_EN to
1875:./ucos/Core/os_core.c **** *              3) You MUST have at least a delay of 2/10 seconds to allow for the system to establi
1876:./ucos/Core/os_core.c **** *                 maximum value for the idle counter.
1877:./ucos/Core/os_core.c **** ***************************************************************************************************
1878:./ucos/Core/os_core.c **** */
1879:./ucos/Core/os_core.c **** 
1880:./ucos/Core/os_core.c **** #if OS_TASK_STAT_EN > 0u
1881:./ucos/Core/os_core.c **** void  OS_TaskStat (void *p_arg)
1882:./ucos/Core/os_core.c **** {
1883:./ucos/Core/os_core.c ****     INT8S  usage;
1884:./ucos/Core/os_core.c **** #if OS_CRITICAL_METHOD == 3u                     /* Allocate storage for CPU status register       
1885:./ucos/Core/os_core.c ****     OS_CPU_SR  cpu_sr = 0u;
1886:./ucos/Core/os_core.c **** #endif
1887:./ucos/Core/os_core.c **** 
1888:./ucos/Core/os_core.c **** 
1889:./ucos/Core/os_core.c **** 
1890:./ucos/Core/os_core.c ****     p_arg = p_arg;                               /* Prevent compiler warning for not using 'p_arg' 
1891:./ucos/Core/os_core.c ****     while (OSStatRdy == OS_FALSE) {
1892:./ucos/Core/os_core.c ****         OSTimeDly(2u * OS_TICKS_PER_SEC / 10u);  /* Wait until statistic task is ready             
ARM GAS  /tmp/ccMSGEvU.s 			page 105


1893:./ucos/Core/os_core.c ****     }
1894:./ucos/Core/os_core.c ****     OSIdleCtrMax /= 100uL;
1895:./ucos/Core/os_core.c ****     if (OSIdleCtrMax == 0uL) {
1896:./ucos/Core/os_core.c ****         OSCPUUsage = 0u;
1897:./ucos/Core/os_core.c **** #if OS_TASK_SUSPEND_EN > 0u
1898:./ucos/Core/os_core.c ****         (void)OSTaskSuspend(OS_PRIO_SELF);
1899:./ucos/Core/os_core.c **** #else
1900:./ucos/Core/os_core.c ****         for (;;) {
1901:./ucos/Core/os_core.c ****             OSTimeDly(OS_TICKS_PER_SEC);
1902:./ucos/Core/os_core.c ****         }
1903:./ucos/Core/os_core.c **** #endif
1904:./ucos/Core/os_core.c ****     }
1905:./ucos/Core/os_core.c ****     OS_ENTER_CRITICAL();
1906:./ucos/Core/os_core.c ****     OSIdleCtr = OSIdleCtrMax * 100uL;            /* Set initial CPU usage as 0%                    
1907:./ucos/Core/os_core.c ****     OS_EXIT_CRITICAL();
1908:./ucos/Core/os_core.c ****     for (;;) {
1909:./ucos/Core/os_core.c ****         OSTimeDly(1);                            /* Synchronize with clock tick                    
1910:./ucos/Core/os_core.c **** 
1911:./ucos/Core/os_core.c ****         OS_ENTER_CRITICAL();
1912:./ucos/Core/os_core.c ****         OSIdleCtr = 0uL;                        /* Reset the idle counter for the next second      
1913:./ucos/Core/os_core.c ****         OS_EXIT_CRITICAL();
1914:./ucos/Core/os_core.c **** 
1915:./ucos/Core/os_core.c ****         OSTimeDly(OS_TICKS_PER_SEC / 10u);       /* Accumulate OSIdleCtr for the next 1/10 second  
1916:./ucos/Core/os_core.c **** 
1917:./ucos/Core/os_core.c ****         OS_ENTER_CRITICAL();
1918:./ucos/Core/os_core.c ****         OSIdleCtrRun = OSIdleCtr;                /* Store number of cycles which elapsed while idle
1919:./ucos/Core/os_core.c ****         OS_EXIT_CRITICAL();
1920:./ucos/Core/os_core.c **** 
1921:./ucos/Core/os_core.c ****         usage            = 100 - (INT8S)(OSIdleCtrRun / OSIdleCtrMax);
1922:./ucos/Core/os_core.c ****         if (usage >= 0) {                        /* Make sure we don't have a negative percentage  
1923:./ucos/Core/os_core.c ****             OSCPUUsage   = (INT8U)usage;
1924:./ucos/Core/os_core.c ****         } else {
1925:./ucos/Core/os_core.c ****             OSCPUUsage   = 0u;
1926:./ucos/Core/os_core.c ****             OSIdleCtrMax = OSIdleCtrRun / 100uL; /* Update max counter value to current one        
1927:./ucos/Core/os_core.c ****         }
1928:./ucos/Core/os_core.c **** 
1929:./ucos/Core/os_core.c ****         OSTaskStatHook();                        /* Invoke user definable hook                     
1930:./ucos/Core/os_core.c **** #if (OS_TASK_STAT_STK_CHK_EN > 0u) && (OS_TASK_CREATE_EXT_EN > 0u)
1931:./ucos/Core/os_core.c ****         OS_TaskStatStkChk();                     /* Check the stacks for each task                 
1932:./ucos/Core/os_core.c **** #endif
