1624:./ucos/Core/os_core.c **** * Description: This function is called by other uC/OS-II services to clear a contiguous block of RA
1625:./ucos/Core/os_core.c **** *
1626:./ucos/Core/os_core.c **** * Arguments  : pdest    is the start of the RAM to clear (i.e. write 0x00 to)
1627:./ucos/Core/os_core.c **** *
1628:./ucos/Core/os_core.c **** *              size     is the number of bytes to clear.
1629:./ucos/Core/os_core.c **** *
1630:./ucos/Core/os_core.c **** * Returns    : none
1631:./ucos/Core/os_core.c **** *
1632:./ucos/Core/os_core.c **** * Notes      : 1) This function is INTERNAL to uC/OS-II and your application should not call it.
1633:./ucos/Core/os_core.c **** *              2) Note that we can only clear up to 64K bytes of RAM.  This is not an issue because
1634:./ucos/Core/os_core.c **** *                 of the uses of this function gets close to this limit.
1635:./ucos/Core/os_core.c **** *              3) The clear is done one byte at a time since this will work on any processor irresp
1636:./ucos/Core/os_core.c **** *                 of the alignment of the destination.
1637:./ucos/Core/os_core.c **** ***************************************************************************************************
1638:./ucos/Core/os_core.c **** */
1639:./ucos/Core/os_core.c **** 
1640:./ucos/Core/os_core.c **** void  OS_MemClr (INT8U  *pdest,
1641:./ucos/Core/os_core.c ****                  INT16U  size)
1642:./ucos/Core/os_core.c **** {
1643:./ucos/Core/os_core.c ****     while (size > 0u) {
1644:./ucos/Core/os_core.c ****         *pdest++ = (INT8U)0;
1645:./ucos/Core/os_core.c ****         size--;
1646:./ucos/Core/os_core.c ****     }
1647:./ucos/Core/os_core.c **** }
