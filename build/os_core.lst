 163:./ucos/Core/os_core.c ****     OS_EXIT_CRITICAL();
 164:./ucos/Core/os_core.c ****     *perr  = OS_ERR_NONE;
 165:./ucos/Core/os_core.c ****     return (len);
 166:./ucos/Core/os_core.c **** }
