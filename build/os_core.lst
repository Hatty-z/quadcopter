 147:./ucos/Core/os_core.c ****         return (0u);
 148:./ucos/Core/os_core.c ****     }
 149:./ucos/Core/os_core.c ****     switch (pevent->OSEventType) {
 150:./ucos/Core/os_core.c ****         case OS_EVENT_TYPE_SEM:
 151:./ucos/Core/os_core.c ****         case OS_EVENT_TYPE_MUTEX:
 152:./ucos/Core/os_core.c ****         case OS_EVENT_TYPE_MBOX:
 153:./ucos/Core/os_core.c ****         case OS_EVENT_TYPE_Q:
 154:./ucos/Core/os_core.c ****              break;
 155:./ucos/Core/os_core.c **** 
