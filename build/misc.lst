 171:./Libraries/src/misc.c **** /**
 172:./Libraries/src/misc.c ****   * @brief  Sets the vector table location and Offset.
 173:./Libraries/src/misc.c ****   * @param  NVIC_VectTab: specifies if the vector table is in RAM or FLASH memory.
 174:./Libraries/src/misc.c ****   *   This parameter can be one of the following values:
 175:./Libraries/src/misc.c ****   *     @arg NVIC_VectTab_RAM: Vector Table in internal SRAM.
 176:./Libraries/src/misc.c ****   *     @arg NVIC_VectTab_FLASH: Vector Table in internal FLASH.
 177:./Libraries/src/misc.c ****   * @param  Offset: Vector Table base offset field. This value must be a multiple of 0x200.
 178:./Libraries/src/misc.c ****   * @retval None
 179:./Libraries/src/misc.c ****   */
 180:./Libraries/src/misc.c **** void NVIC_SetVectorTable(uint32_t NVIC_VectTab, uint32_t Offset)
 181:./Libraries/src/misc.c **** { 
 184              		.loc 1 181 1 is_stmt 1 view -0
 185              		.cfi_startproc
 186              		@ args = 0, pretend = 0, frame = 0
 187              		@ frame_needed = 0, uses_anonymous_args = 0
