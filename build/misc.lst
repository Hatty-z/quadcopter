 100:./Libraries/src/misc.c **** /**
 101:./Libraries/src/misc.c ****   * @brief  Configures the priority grouping: pre-emption priority and subpriority.
 102:./Libraries/src/misc.c ****   * @param  NVIC_PriorityGroup: specifies the priority grouping bits length. 
 103:./Libraries/src/misc.c ****   *   This parameter can be one of the following values:
 104:./Libraries/src/misc.c ****   *     @arg NVIC_PriorityGroup_0: 0 bits for pre-emption priority
 105:./Libraries/src/misc.c ****   *                                4 bits for subpriority
 106:./Libraries/src/misc.c ****   *     @arg NVIC_PriorityGroup_1: 1 bits for pre-emption priority
 107:./Libraries/src/misc.c ****   *                                3 bits for subpriority
 108:./Libraries/src/misc.c ****   *     @arg NVIC_PriorityGroup_2: 2 bits for pre-emption priority
 109:./Libraries/src/misc.c ****   *                                2 bits for subpriority
 110:./Libraries/src/misc.c ****   *     @arg NVIC_PriorityGroup_3: 3 bits for pre-emption priority
 111:./Libraries/src/misc.c ****   *                                1 bits for subpriority
 112:./Libraries/src/misc.c ****   *     @arg NVIC_PriorityGroup_4: 4 bits for pre-emption priority
 113:./Libraries/src/misc.c ****   *                                0 bits for subpriority
 114:./Libraries/src/misc.c ****   * @note   When the NVIC_PriorityGroup_0 is selected, IRQ pre-emption is no more possible. 
 115:./Libraries/src/misc.c ****   *         The pending IRQ priority will be managed only by the subpriority. 
 116:./Libraries/src/misc.c ****   * @retval None
 117:./Libraries/src/misc.c ****   */
 118:./Libraries/src/misc.c **** void NVIC_PriorityGroupConfig(uint32_t NVIC_PriorityGroup)
