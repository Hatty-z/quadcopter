 295:./Libraries/src/stm32f4xx_tim.c ****   assert_param(IS_TIM_CKD_DIV(TIM_TimeBaseInitStruct->TIM_ClockDivision));
 296:./Libraries/src/stm32f4xx_tim.c **** 
 297:./Libraries/src/stm32f4xx_tim.c ****   tmpcr1 = TIMx->CR1;  
