2084:./Libraries/src/stm32f4xx_tim.c **** /**
2085:./Libraries/src/stm32f4xx_tim.c ****   * @brief  Sets the TIMx Input Capture 1 prescaler.
2086:./Libraries/src/stm32f4xx_tim.c ****   * @param  TIMx: where x can be 1 to 14 except 6 and 7, to select the TIM peripheral.
2087:./Libraries/src/stm32f4xx_tim.c ****   * @param  TIM_ICPSC: specifies the Input Capture1 prescaler new value.
2088:./Libraries/src/stm32f4xx_tim.c ****   *          This parameter can be one of the following values:
2089:./Libraries/src/stm32f4xx_tim.c ****   *            @arg TIM_ICPSC_DIV1: no prescaler
2090:./Libraries/src/stm32f4xx_tim.c ****   *            @arg TIM_ICPSC_DIV2: capture is done once every 2 events
2091:./Libraries/src/stm32f4xx_tim.c ****   *            @arg TIM_ICPSC_DIV4: capture is done once every 4 events
2092:./Libraries/src/stm32f4xx_tim.c ****   *            @arg TIM_ICPSC_DIV8: capture is done once every 8 events
2093:./Libraries/src/stm32f4xx_tim.c ****   * @retval None
2094:./Libraries/src/stm32f4xx_tim.c ****   */
2095:./Libraries/src/stm32f4xx_tim.c **** void TIM_SetIC1Prescaler(TIM_TypeDef* TIMx, uint16_t TIM_ICPSC)
2096:./Libraries/src/stm32f4xx_tim.c **** {
2097:./Libraries/src/stm32f4xx_tim.c ****   /* Check the parameters */
2098:./Libraries/src/stm32f4xx_tim.c ****   assert_param(IS_TIM_LIST1_PERIPH(TIMx));
2099:./Libraries/src/stm32f4xx_tim.c ****   assert_param(IS_TIM_IC_PRESCALER(TIM_ICPSC));
2100:./Libraries/src/stm32f4xx_tim.c **** 
2101:./Libraries/src/stm32f4xx_tim.c ****   /* Reset the IC1PSC Bits */
2102:./Libraries/src/stm32f4xx_tim.c ****   TIMx->CCMR1 &= (uint16_t)~TIM_CCMR1_IC1PSC;
2103:./Libraries/src/stm32f4xx_tim.c **** 
2104:./Libraries/src/stm32f4xx_tim.c ****   /* Set the IC1PSC value */
2105:./Libraries/src/stm32f4xx_tim.c ****   TIMx->CCMR1 |= TIM_ICPSC;
2106:./Libraries/src/stm32f4xx_tim.c **** }
