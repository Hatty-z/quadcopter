1014:./Libraries/src/stm32f4xx_tim.c **** void TIM_SelectOCxM(TIM_TypeDef* TIMx, uint16_t TIM_Channel, uint16_t TIM_OCMode)
1015:./Libraries/src/stm32f4xx_tim.c **** {
1016:./Libraries/src/stm32f4xx_tim.c ****   uint32_t tmp = 0;
1017:./Libraries/src/stm32f4xx_tim.c ****   uint16_t tmp1 = 0;
1018:./Libraries/src/stm32f4xx_tim.c **** 
1019:./Libraries/src/stm32f4xx_tim.c ****   /* Check the parameters */
1020:./Libraries/src/stm32f4xx_tim.c ****   assert_param(IS_TIM_LIST1_PERIPH(TIMx));
1021:./Libraries/src/stm32f4xx_tim.c ****   assert_param(IS_TIM_CHANNEL(TIM_Channel));
1022:./Libraries/src/stm32f4xx_tim.c ****   assert_param(IS_TIM_OCM(TIM_OCMode));
1023:./Libraries/src/stm32f4xx_tim.c **** 
1024:./Libraries/src/stm32f4xx_tim.c ****   tmp = (uint32_t) TIMx;
1025:./Libraries/src/stm32f4xx_tim.c ****   tmp += CCMR_OFFSET;
1026:./Libraries/src/stm32f4xx_tim.c **** 
1027:./Libraries/src/stm32f4xx_tim.c ****   tmp1 = CCER_CCE_SET << (uint16_t)TIM_Channel;
1028:./Libraries/src/stm32f4xx_tim.c **** 
1029:./Libraries/src/stm32f4xx_tim.c ****   /* Disable the Channel: Reset the CCxE Bit */
1030:./Libraries/src/stm32f4xx_tim.c ****   TIMx->CCER &= (uint16_t) ~tmp1;
1031:./Libraries/src/stm32f4xx_tim.c **** 
1032:./Libraries/src/stm32f4xx_tim.c ****   if((TIM_Channel == TIM_Channel_1) ||(TIM_Channel == TIM_Channel_3))
1033:./Libraries/src/stm32f4xx_tim.c ****   {
1034:./Libraries/src/stm32f4xx_tim.c ****     tmp += (TIM_Channel>>1);
1035:./Libraries/src/stm32f4xx_tim.c **** 
1036:./Libraries/src/stm32f4xx_tim.c ****     /* Reset the OCxM bits in the CCMRx register */
1037:./Libraries/src/stm32f4xx_tim.c ****     *(__IO uint32_t *) tmp &= CCMR_OC13M_MASK;
1038:./Libraries/src/stm32f4xx_tim.c ****    
1039:./Libraries/src/stm32f4xx_tim.c ****     /* Configure the OCxM bits in the CCMRx register */
1040:./Libraries/src/stm32f4xx_tim.c ****     *(__IO uint32_t *) tmp |= TIM_OCMode;
1041:./Libraries/src/stm32f4xx_tim.c ****   }
1042:./Libraries/src/stm32f4xx_tim.c ****   else
1043:./Libraries/src/stm32f4xx_tim.c ****   {
1044:./Libraries/src/stm32f4xx_tim.c ****     tmp += (uint16_t)(TIM_Channel - (uint16_t)4)>> (uint16_t)1;
1045:./Libraries/src/stm32f4xx_tim.c **** 
1046:./Libraries/src/stm32f4xx_tim.c ****     /* Reset the OCxM bits in the CCMRx register */
1047:./Libraries/src/stm32f4xx_tim.c ****     *(__IO uint32_t *) tmp &= CCMR_OC24M_MASK;
1048:./Libraries/src/stm32f4xx_tim.c ****     
1049:./Libraries/src/stm32f4xx_tim.c ****     /* Configure the OCxM bits in the CCMRx register */
1050:./Libraries/src/stm32f4xx_tim.c ****     *(__IO uint32_t *) tmp |= (uint16_t)(TIM_OCMode << 8);
1051:./Libraries/src/stm32f4xx_tim.c ****   }
1052:./Libraries/src/stm32f4xx_tim.c **** }
