 613:./Libraries/src/stm32f4xx_tim.c **** /** @defgroup TIM_Group2 Output Compare management functions
 614:./Libraries/src/stm32f4xx_tim.c ****  *  @brief    Output Compare management functions 
 615:./Libraries/src/stm32f4xx_tim.c ****  *
 616:./Libraries/src/stm32f4xx_tim.c **** @verbatim   
 617:./Libraries/src/stm32f4xx_tim.c ****  ===============================================================================
 618:./Libraries/src/stm32f4xx_tim.c ****               ##### Output Compare management functions #####
 619:./Libraries/src/stm32f4xx_tim.c ****  ===============================================================================  
 620:./Libraries/src/stm32f4xx_tim.c ****    
 621:./Libraries/src/stm32f4xx_tim.c ****       
 622:./Libraries/src/stm32f4xx_tim.c ****         ##### TIM Driver: how to use it in Output Compare Mode #####
 623:./Libraries/src/stm32f4xx_tim.c ****  ===============================================================================
 624:./Libraries/src/stm32f4xx_tim.c ****     [..] 
 625:./Libraries/src/stm32f4xx_tim.c ****     To use the Timer in Output Compare mode, the following steps are mandatory:
 626:./Libraries/src/stm32f4xx_tim.c ****        
 627:./Libraries/src/stm32f4xx_tim.c ****       (#) Enable TIM clock using RCC_APBxPeriphClockCmd(RCC_APBxPeriph_TIMx, ENABLE) 
 628:./Libraries/src/stm32f4xx_tim.c ****           function
 629:./Libraries/src/stm32f4xx_tim.c ****        
 630:./Libraries/src/stm32f4xx_tim.c ****       (#) Configure the TIM pins by configuring the corresponding GPIO pins
 631:./Libraries/src/stm32f4xx_tim.c ****        
 632:./Libraries/src/stm32f4xx_tim.c ****       (#) Configure the Time base unit as described in the first part of this driver, 
 633:./Libraries/src/stm32f4xx_tim.c ****         (++) if needed, else the Timer will run with the default configuration:
 634:./Libraries/src/stm32f4xx_tim.c ****             Autoreload value = 0xFFFF
 635:./Libraries/src/stm32f4xx_tim.c ****         (++) Prescaler value = 0x0000
 636:./Libraries/src/stm32f4xx_tim.c ****         (++) Counter mode = Up counting
 637:./Libraries/src/stm32f4xx_tim.c ****         (++) Clock Division = TIM_CKD_DIV1
 638:./Libraries/src/stm32f4xx_tim.c ****           
 639:./Libraries/src/stm32f4xx_tim.c ****       (#) Fill the TIM_OCInitStruct with the desired parameters including:
 640:./Libraries/src/stm32f4xx_tim.c ****         (++) The TIM Output Compare mode: TIM_OCMode
 641:./Libraries/src/stm32f4xx_tim.c ****         (++) TIM Output State: TIM_OutputState
 642:./Libraries/src/stm32f4xx_tim.c ****         (++) TIM Pulse value: TIM_Pulse
 643:./Libraries/src/stm32f4xx_tim.c ****         (++) TIM Output Compare Polarity : TIM_OCPolarity
 644:./Libraries/src/stm32f4xx_tim.c ****        
 645:./Libraries/src/stm32f4xx_tim.c ****       (#) Call TIM_OCxInit(TIMx, &TIM_OCInitStruct) to configure the desired 
 646:./Libraries/src/stm32f4xx_tim.c ****           channel with the corresponding configuration
 647:./Libraries/src/stm32f4xx_tim.c ****        
 648:./Libraries/src/stm32f4xx_tim.c ****       (#) Call the TIM_Cmd(ENABLE) function to enable the TIM counter.
 649:./Libraries/src/stm32f4xx_tim.c ****        
 650:./Libraries/src/stm32f4xx_tim.c ****       -@- All other functions can be used separately to modify, if needed,
 651:./Libraries/src/stm32f4xx_tim.c ****           a specific feature of the Timer. 
 652:./Libraries/src/stm32f4xx_tim.c ****           
 653:./Libraries/src/stm32f4xx_tim.c ****       -@- In case of PWM mode, this function is mandatory:
 654:./Libraries/src/stm32f4xx_tim.c ****           TIM_OCxPreloadConfig(TIMx, TIM_OCPreload_ENABLE); 
 655:./Libraries/src/stm32f4xx_tim.c ****               
 656:./Libraries/src/stm32f4xx_tim.c ****       -@- If the corresponding interrupt or DMA request are needed, the user should:
 657:./Libraries/src/stm32f4xx_tim.c ****         (+@) Enable the NVIC (or the DMA) to use the TIM interrupts (or DMA requests). 
ARM GAS  /tmp/cc0EAqnP.s 			page 13


 658:./Libraries/src/stm32f4xx_tim.c ****         (+@) Enable the corresponding interrupt (or DMA request) using the function 
 659:./Libraries/src/stm32f4xx_tim.c ****              TIM_ITConfig(TIMx, TIM_IT_CCx) (or TIM_DMA_Cmd(TIMx, TIM_DMA_CCx))   
 660:./Libraries/src/stm32f4xx_tim.c **** 
 661:./Libraries/src/stm32f4xx_tim.c **** @endverbatim
 662:./Libraries/src/stm32f4xx_tim.c ****   * @{
 663:./Libraries/src/stm32f4xx_tim.c ****   */
 664:./Libraries/src/stm32f4xx_tim.c **** 
 665:./Libraries/src/stm32f4xx_tim.c **** /**
 666:./Libraries/src/stm32f4xx_tim.c ****   * @brief  Initializes the TIMx Channel1 according to the specified parameters in
 667:./Libraries/src/stm32f4xx_tim.c ****   *         the TIM_OCInitStruct.
 668:./Libraries/src/stm32f4xx_tim.c ****   * @param  TIMx: where x can be 1 to 14 except 6 and 7, to select the TIM peripheral.
 669:./Libraries/src/stm32f4xx_tim.c ****   * @param  TIM_OCInitStruct: pointer to a TIM_OCInitTypeDef structure that contains
 670:./Libraries/src/stm32f4xx_tim.c ****   *         the configuration information for the specified TIM peripheral.
 671:./Libraries/src/stm32f4xx_tim.c ****   * @retval None
 672:./Libraries/src/stm32f4xx_tim.c ****   */
 673:./Libraries/src/stm32f4xx_tim.c **** void TIM_OC1Init(TIM_TypeDef* TIMx, TIM_OCInitTypeDef* TIM_OCInitStruct)
 674:./Libraries/src/stm32f4xx_tim.c **** {
 675:./Libraries/src/stm32f4xx_tim.c ****   uint16_t tmpccmrx = 0, tmpccer = 0, tmpcr2 = 0;
 676:./Libraries/src/stm32f4xx_tim.c ****    
 677:./Libraries/src/stm32f4xx_tim.c ****   /* Check the parameters */
 678:./Libraries/src/stm32f4xx_tim.c ****   assert_param(IS_TIM_LIST1_PERIPH(TIMx)); 
 679:./Libraries/src/stm32f4xx_tim.c ****   assert_param(IS_TIM_OC_MODE(TIM_OCInitStruct->TIM_OCMode));
 680:./Libraries/src/stm32f4xx_tim.c ****   assert_param(IS_TIM_OUTPUT_STATE(TIM_OCInitStruct->TIM_OutputState));
 681:./Libraries/src/stm32f4xx_tim.c ****   assert_param(IS_TIM_OC_POLARITY(TIM_OCInitStruct->TIM_OCPolarity));   
 682:./Libraries/src/stm32f4xx_tim.c **** 
 683:./Libraries/src/stm32f4xx_tim.c ****   /* Disable the Channel 1: Reset the CC1E Bit */
 684:./Libraries/src/stm32f4xx_tim.c ****   TIMx->CCER &= (uint16_t)~TIM_CCER_CC1E;
 685:./Libraries/src/stm32f4xx_tim.c ****   
 686:./Libraries/src/stm32f4xx_tim.c ****   /* Get the TIMx CCER register value */
 687:./Libraries/src/stm32f4xx_tim.c ****   tmpccer = TIMx->CCER;
 688:./Libraries/src/stm32f4xx_tim.c ****   /* Get the TIMx CR2 register value */
 689:./Libraries/src/stm32f4xx_tim.c ****   tmpcr2 =  TIMx->CR2;
 690:./Libraries/src/stm32f4xx_tim.c ****   
 691:./Libraries/src/stm32f4xx_tim.c ****   /* Get the TIMx CCMR1 register value */
 692:./Libraries/src/stm32f4xx_tim.c ****   tmpccmrx = TIMx->CCMR1;
 693:./Libraries/src/stm32f4xx_tim.c ****     
 694:./Libraries/src/stm32f4xx_tim.c ****   /* Reset the Output Compare Mode Bits */
 695:./Libraries/src/stm32f4xx_tim.c ****   tmpccmrx &= (uint16_t)~TIM_CCMR1_OC1M;
 696:./Libraries/src/stm32f4xx_tim.c ****   tmpccmrx &= (uint16_t)~TIM_CCMR1_CC1S;
 697:./Libraries/src/stm32f4xx_tim.c ****   /* Select the Output Compare Mode */
 698:./Libraries/src/stm32f4xx_tim.c ****   tmpccmrx |= TIM_OCInitStruct->TIM_OCMode;
 699:./Libraries/src/stm32f4xx_tim.c ****   
 700:./Libraries/src/stm32f4xx_tim.c ****   /* Reset the Output Polarity level */
 701:./Libraries/src/stm32f4xx_tim.c ****   tmpccer &= (uint16_t)~TIM_CCER_CC1P;
 702:./Libraries/src/stm32f4xx_tim.c ****   /* Set the Output Compare Polarity */
 703:./Libraries/src/stm32f4xx_tim.c ****   tmpccer |= TIM_OCInitStruct->TIM_OCPolarity;
 704:./Libraries/src/stm32f4xx_tim.c ****   
 705:./Libraries/src/stm32f4xx_tim.c ****   /* Set the Output State */
 706:./Libraries/src/stm32f4xx_tim.c ****   tmpccer |= TIM_OCInitStruct->TIM_OutputState;
 707:./Libraries/src/stm32f4xx_tim.c ****     
 708:./Libraries/src/stm32f4xx_tim.c ****   if((TIMx == TIM1) || (TIMx == TIM8))
 709:./Libraries/src/stm32f4xx_tim.c ****   {
 710:./Libraries/src/stm32f4xx_tim.c ****     assert_param(IS_TIM_OUTPUTN_STATE(TIM_OCInitStruct->TIM_OutputNState));
 711:./Libraries/src/stm32f4xx_tim.c ****     assert_param(IS_TIM_OCN_POLARITY(TIM_OCInitStruct->TIM_OCNPolarity));
 712:./Libraries/src/stm32f4xx_tim.c ****     assert_param(IS_TIM_OCNIDLE_STATE(TIM_OCInitStruct->TIM_OCNIdleState));
 713:./Libraries/src/stm32f4xx_tim.c ****     assert_param(IS_TIM_OCIDLE_STATE(TIM_OCInitStruct->TIM_OCIdleState));
 714:./Libraries/src/stm32f4xx_tim.c ****     
ARM GAS  /tmp/cc0EAqnP.s 			page 14


 715:./Libraries/src/stm32f4xx_tim.c ****     /* Reset the Output N Polarity level */
 716:./Libraries/src/stm32f4xx_tim.c ****     tmpccer &= (uint16_t)~TIM_CCER_CC1NP;
 717:./Libraries/src/stm32f4xx_tim.c ****     /* Set the Output N Polarity */
 718:./Libraries/src/stm32f4xx_tim.c ****     tmpccer |= TIM_OCInitStruct->TIM_OCNPolarity;
 719:./Libraries/src/stm32f4xx_tim.c ****     /* Reset the Output N State */
 720:./Libraries/src/stm32f4xx_tim.c ****     tmpccer &= (uint16_t)~TIM_CCER_CC1NE;
 721:./Libraries/src/stm32f4xx_tim.c ****     
 722:./Libraries/src/stm32f4xx_tim.c ****     /* Set the Output N State */
 723:./Libraries/src/stm32f4xx_tim.c ****     tmpccer |= TIM_OCInitStruct->TIM_OutputNState;
 724:./Libraries/src/stm32f4xx_tim.c ****     /* Reset the Output Compare and Output Compare N IDLE State */
 725:./Libraries/src/stm32f4xx_tim.c ****     tmpcr2 &= (uint16_t)~TIM_CR2_OIS1;
 726:./Libraries/src/stm32f4xx_tim.c ****     tmpcr2 &= (uint16_t)~TIM_CR2_OIS1N;
 727:./Libraries/src/stm32f4xx_tim.c ****     /* Set the Output Idle state */
 728:./Libraries/src/stm32f4xx_tim.c ****     tmpcr2 |= TIM_OCInitStruct->TIM_OCIdleState;
 729:./Libraries/src/stm32f4xx_tim.c ****     /* Set the Output N Idle state */
 730:./Libraries/src/stm32f4xx_tim.c ****     tmpcr2 |= TIM_OCInitStruct->TIM_OCNIdleState;
 731:./Libraries/src/stm32f4xx_tim.c ****   }
 732:./Libraries/src/stm32f4xx_tim.c ****   /* Write to TIMx CR2 */
 733:./Libraries/src/stm32f4xx_tim.c ****   TIMx->CR2 = tmpcr2;
 734:./Libraries/src/stm32f4xx_tim.c ****   
 735:./Libraries/src/stm32f4xx_tim.c ****   /* Write to TIMx CCMR1 */
 736:./Libraries/src/stm32f4xx_tim.c ****   TIMx->CCMR1 = tmpccmrx;
 737:./Libraries/src/stm32f4xx_tim.c ****   
 738:./Libraries/src/stm32f4xx_tim.c ****   /* Set the Capture Compare Register value */
 739:./Libraries/src/stm32f4xx_tim.c ****   TIMx->CCR1 = TIM_OCInitStruct->TIM_Pulse;
 740:./Libraries/src/stm32f4xx_tim.c ****   
 741:./Libraries/src/stm32f4xx_tim.c ****   /* Write to TIMx CCER */
 742:./Libraries/src/stm32f4xx_tim.c ****   TIMx->CCER = tmpccer;
 743:./Libraries/src/stm32f4xx_tim.c **** }
