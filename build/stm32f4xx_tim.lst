 160:./Libraries/src/stm32f4xx_tim.c **** /** @defgroup TIM_Group1 TimeBase management functions
 161:./Libraries/src/stm32f4xx_tim.c ****  *  @brief   TimeBase management functions 
 162:./Libraries/src/stm32f4xx_tim.c ****  *
 163:./Libraries/src/stm32f4xx_tim.c **** @verbatim   
 164:./Libraries/src/stm32f4xx_tim.c ****  ===============================================================================
 165:./Libraries/src/stm32f4xx_tim.c ****                      ##### TimeBase management functions #####
 166:./Libraries/src/stm32f4xx_tim.c ****  ===============================================================================  
 167:./Libraries/src/stm32f4xx_tim.c ****   
 168:./Libraries/src/stm32f4xx_tim.c ****      
 169:./Libraries/src/stm32f4xx_tim.c ****             ##### TIM Driver: how to use it in Timing(Time base) Mode #####
 170:./Libraries/src/stm32f4xx_tim.c ****  ===============================================================================
 171:./Libraries/src/stm32f4xx_tim.c ****     [..] 
 172:./Libraries/src/stm32f4xx_tim.c ****     To use the Timer in Timing(Time base) mode, the following steps are mandatory:
 173:./Libraries/src/stm32f4xx_tim.c ****        
 174:./Libraries/src/stm32f4xx_tim.c ****       (#) Enable TIM clock using RCC_APBxPeriphClockCmd(RCC_APBxPeriph_TIMx, ENABLE) function
 175:./Libraries/src/stm32f4xx_tim.c ****                     
 176:./Libraries/src/stm32f4xx_tim.c ****       (#) Fill the TIM_TimeBaseInitStruct with the desired parameters.
 177:./Libraries/src/stm32f4xx_tim.c ****        
 178:./Libraries/src/stm32f4xx_tim.c ****       (#) Call TIM_TimeBaseInit(TIMx, &TIM_TimeBaseInitStruct) to configure the Time Base unit
 179:./Libraries/src/stm32f4xx_tim.c ****           with the corresponding configuration
 180:./Libraries/src/stm32f4xx_tim.c ****           
 181:./Libraries/src/stm32f4xx_tim.c ****       (#) Enable the NVIC if you need to generate the update interrupt. 
 182:./Libraries/src/stm32f4xx_tim.c ****           
 183:./Libraries/src/stm32f4xx_tim.c ****       (#) Enable the corresponding interrupt using the function TIM_ITConfig(TIMx, TIM_IT_Update) 
 184:./Libraries/src/stm32f4xx_tim.c ****        
 185:./Libraries/src/stm32f4xx_tim.c ****       (#) Call the TIM_Cmd(ENABLE) function to enable the TIM counter.
 186:./Libraries/src/stm32f4xx_tim.c ****              
 187:./Libraries/src/stm32f4xx_tim.c ****        -@- All other functions can be used separately to modify, if needed,
 188:./Libraries/src/stm32f4xx_tim.c ****            a specific feature of the Timer. 
 189:./Libraries/src/stm32f4xx_tim.c **** 
 190:./Libraries/src/stm32f4xx_tim.c **** @endverbatim
 191:./Libraries/src/stm32f4xx_tim.c ****   * @{
 192:./Libraries/src/stm32f4xx_tim.c ****   */
 193:./Libraries/src/stm32f4xx_tim.c ****   
 194:./Libraries/src/stm32f4xx_tim.c **** /**
 195:./Libraries/src/stm32f4xx_tim.c ****   * @brief  Deinitializes the TIMx peripheral registers to their default reset values.
 196:./Libraries/src/stm32f4xx_tim.c ****   * @param  TIMx: where x can be 1 to 14 to select the TIM peripheral.
 197:./Libraries/src/stm32f4xx_tim.c ****   * @retval None
 198:./Libraries/src/stm32f4xx_tim.c **** 
 199:./Libraries/src/stm32f4xx_tim.c ****   */
 200:./Libraries/src/stm32f4xx_tim.c **** void TIM_DeInit(TIM_TypeDef* TIMx)
 201:./Libraries/src/stm32f4xx_tim.c **** {
ARM GAS  /tmp/cc0EAqnP.s 			page 5


 202:./Libraries/src/stm32f4xx_tim.c ****   /* Check the parameters */
 203:./Libraries/src/stm32f4xx_tim.c ****   assert_param(IS_TIM_ALL_PERIPH(TIMx)); 
 204:./Libraries/src/stm32f4xx_tim.c ****  
 205:./Libraries/src/stm32f4xx_tim.c ****   if (TIMx == TIM1)
 206:./Libraries/src/stm32f4xx_tim.c ****   {
 207:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB2PeriphResetCmd(RCC_APB2Periph_TIM1, ENABLE);
 208:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB2PeriphResetCmd(RCC_APB2Periph_TIM1, DISABLE);  
 209:./Libraries/src/stm32f4xx_tim.c ****   } 
 210:./Libraries/src/stm32f4xx_tim.c ****   else if (TIMx == TIM2) 
 211:./Libraries/src/stm32f4xx_tim.c ****   {     
 212:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_TIM2, ENABLE);
 213:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_TIM2, DISABLE);
 214:./Libraries/src/stm32f4xx_tim.c ****   }  
 215:./Libraries/src/stm32f4xx_tim.c ****   else if (TIMx == TIM3)
 216:./Libraries/src/stm32f4xx_tim.c ****   { 
 217:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_TIM3, ENABLE);
 218:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_TIM3, DISABLE);
 219:./Libraries/src/stm32f4xx_tim.c ****   }  
 220:./Libraries/src/stm32f4xx_tim.c ****   else if (TIMx == TIM4)
 221:./Libraries/src/stm32f4xx_tim.c ****   { 
 222:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_TIM4, ENABLE);
 223:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_TIM4, DISABLE);
 224:./Libraries/src/stm32f4xx_tim.c ****   }  
 225:./Libraries/src/stm32f4xx_tim.c ****   else if (TIMx == TIM5)
 226:./Libraries/src/stm32f4xx_tim.c ****   {      
 227:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_TIM5, ENABLE);
 228:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_TIM5, DISABLE);
 229:./Libraries/src/stm32f4xx_tim.c ****   }  
 230:./Libraries/src/stm32f4xx_tim.c ****   else if (TIMx == TIM6)  
 231:./Libraries/src/stm32f4xx_tim.c ****   {    
 232:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_TIM6, ENABLE);
 233:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_TIM6, DISABLE);
 234:./Libraries/src/stm32f4xx_tim.c ****   }  
 235:./Libraries/src/stm32f4xx_tim.c ****   else if (TIMx == TIM7)
 236:./Libraries/src/stm32f4xx_tim.c ****   {      
 237:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_TIM7, ENABLE);
 238:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_TIM7, DISABLE);
 239:./Libraries/src/stm32f4xx_tim.c ****   }  
 240:./Libraries/src/stm32f4xx_tim.c ****   else if (TIMx == TIM8)
 241:./Libraries/src/stm32f4xx_tim.c ****   {      
 242:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB2PeriphResetCmd(RCC_APB2Periph_TIM8, ENABLE);
 243:./Libraries/src/stm32f4xx_tim.c ****     RCC_APB2PeriphResetCmd(RCC_APB2Periph_TIM8, DISABLE);  
 244:./Libraries/src/stm32f4xx_tim.c ****   }  
