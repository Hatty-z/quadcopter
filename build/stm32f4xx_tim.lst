   1:./Libraries/src/stm32f4xx_tim.c **** /**
   2:./Libraries/src/stm32f4xx_tim.c ****   ******************************************************************************
   3:./Libraries/src/stm32f4xx_tim.c ****   * @file    stm32f4xx_tim.c
   4:./Libraries/src/stm32f4xx_tim.c ****   * @author  MCD Application Team
   5:./Libraries/src/stm32f4xx_tim.c ****   * @version V1.8.0
   6:./Libraries/src/stm32f4xx_tim.c ****   * @date    04-November-2016
   7:./Libraries/src/stm32f4xx_tim.c ****   * @brief   This file provides firmware functions to manage the following 
   8:./Libraries/src/stm32f4xx_tim.c ****   *          functionalities of the TIM peripheral:
   9:./Libraries/src/stm32f4xx_tim.c ****   *            + TimeBase management
  10:./Libraries/src/stm32f4xx_tim.c ****   *            + Output Compare management
  11:./Libraries/src/stm32f4xx_tim.c ****   *            + Input Capture management
  12:./Libraries/src/stm32f4xx_tim.c ****   *            + Advanced-control timers (TIM1 and TIM8) specific features  
  13:./Libraries/src/stm32f4xx_tim.c ****   *            + Interrupts, DMA and flags management
  14:./Libraries/src/stm32f4xx_tim.c ****   *            + Clocks management
  15:./Libraries/src/stm32f4xx_tim.c ****   *            + Synchronization management
  16:./Libraries/src/stm32f4xx_tim.c ****   *            + Specific interface management
  17:./Libraries/src/stm32f4xx_tim.c ****   *            + Specific remapping management      
  18:./Libraries/src/stm32f4xx_tim.c ****   *              
  19:./Libraries/src/stm32f4xx_tim.c ****   @verbatim   
  20:./Libraries/src/stm32f4xx_tim.c ****  ===============================================================================
  21:./Libraries/src/stm32f4xx_tim.c ****                    #####  How to use this driver #####
  22:./Libraries/src/stm32f4xx_tim.c ****  ===============================================================================
  23:./Libraries/src/stm32f4xx_tim.c ****     [..]
  24:./Libraries/src/stm32f4xx_tim.c ****     This driver provides functions to configure and program the TIM 
  25:./Libraries/src/stm32f4xx_tim.c ****     of all STM32F4xx devices.
  26:./Libraries/src/stm32f4xx_tim.c ****     These functions are split in 9 groups: 
  27:./Libraries/src/stm32f4xx_tim.c ****      
  28:./Libraries/src/stm32f4xx_tim.c ****       (#) TIM TimeBase management: this group includes all needed functions 
  29:./Libraries/src/stm32f4xx_tim.c ****           to configure the TM Timebase unit:
  30:./Libraries/src/stm32f4xx_tim.c ****         (++) Set/Get Prescaler
ARM GAS  /tmp/cc0EAqnP.s 			page 2


  31:./Libraries/src/stm32f4xx_tim.c ****         (++) Set/Get Autoreload  
  32:./Libraries/src/stm32f4xx_tim.c ****         (++) Counter modes configuration
  33:./Libraries/src/stm32f4xx_tim.c ****         (++) Set Clock division  
  34:./Libraries/src/stm32f4xx_tim.c ****         (++) Select the One Pulse mode
  35:./Libraries/src/stm32f4xx_tim.c ****         (++) Update Request Configuration
  36:./Libraries/src/stm32f4xx_tim.c ****         (++) Update Disable Configuration
  37:./Libraries/src/stm32f4xx_tim.c ****         (++) Auto-Preload Configuration 
  38:./Libraries/src/stm32f4xx_tim.c ****         (++) Enable/Disable the counter     
  39:./Libraries/src/stm32f4xx_tim.c ****                    
  40:./Libraries/src/stm32f4xx_tim.c ****       (#) TIM Output Compare management: this group includes all needed 
  41:./Libraries/src/stm32f4xx_tim.c ****           functions to configure the Capture/Compare unit used in Output 
  42:./Libraries/src/stm32f4xx_tim.c ****           compare mode: 
  43:./Libraries/src/stm32f4xx_tim.c ****         (++) Configure each channel, independently, in Output Compare mode
  44:./Libraries/src/stm32f4xx_tim.c ****         (++) Select the output compare modes
  45:./Libraries/src/stm32f4xx_tim.c ****         (++) Select the Polarities of each channel
  46:./Libraries/src/stm32f4xx_tim.c ****         (++) Set/Get the Capture/Compare register values
  47:./Libraries/src/stm32f4xx_tim.c ****         (++) Select the Output Compare Fast mode 
  48:./Libraries/src/stm32f4xx_tim.c ****         (++) Select the Output Compare Forced mode  
  49:./Libraries/src/stm32f4xx_tim.c ****         (++) Output Compare-Preload Configuration 
  50:./Libraries/src/stm32f4xx_tim.c ****         (++) Clear Output Compare Reference
  51:./Libraries/src/stm32f4xx_tim.c ****         (++) Select the OCREF Clear signal
  52:./Libraries/src/stm32f4xx_tim.c ****         (++) Enable/Disable the Capture/Compare Channels    
  53:./Libraries/src/stm32f4xx_tim.c ****                      
  54:./Libraries/src/stm32f4xx_tim.c ****       (#) TIM Input Capture management: this group includes all needed 
  55:./Libraries/src/stm32f4xx_tim.c ****           functions to configure the Capture/Compare unit used in 
  56:./Libraries/src/stm32f4xx_tim.c ****           Input Capture mode:
  57:./Libraries/src/stm32f4xx_tim.c ****         (++) Configure each channel in input capture mode
  58:./Libraries/src/stm32f4xx_tim.c ****         (++) Configure Channel1/2 in PWM Input mode
  59:./Libraries/src/stm32f4xx_tim.c ****         (++) Set the Input Capture Prescaler
  60:./Libraries/src/stm32f4xx_tim.c ****         (++) Get the Capture/Compare values      
  61:./Libraries/src/stm32f4xx_tim.c ****                      
  62:./Libraries/src/stm32f4xx_tim.c ****       (#) Advanced-control timers (TIM1 and TIM8) specific features
  63:./Libraries/src/stm32f4xx_tim.c ****         (++) Configures the Break input, dead time, Lock level, the OSSI,
  64:./Libraries/src/stm32f4xx_tim.c ****              the OSSR State and the AOE(automatic output enable)
  65:./Libraries/src/stm32f4xx_tim.c ****         (++) Enable/Disable the TIM peripheral Main Outputs
  66:./Libraries/src/stm32f4xx_tim.c ****         (++) Select the Commutation event
  67:./Libraries/src/stm32f4xx_tim.c ****         (++) Set/Reset the Capture Compare Preload Control bit
  68:./Libraries/src/stm32f4xx_tim.c ****                                 
  69:./Libraries/src/stm32f4xx_tim.c ****       (#) TIM interrupts, DMA and flags management
  70:./Libraries/src/stm32f4xx_tim.c ****         (++) Enable/Disable interrupt sources
  71:./Libraries/src/stm32f4xx_tim.c ****         (++) Get flags status
  72:./Libraries/src/stm32f4xx_tim.c ****         (++) Clear flags/ Pending bits
  73:./Libraries/src/stm32f4xx_tim.c ****         (++) Enable/Disable DMA requests 
  74:./Libraries/src/stm32f4xx_tim.c ****         (++) Configure DMA burst mode
  75:./Libraries/src/stm32f4xx_tim.c ****         (++) Select CaptureCompare DMA request  
  76:./Libraries/src/stm32f4xx_tim.c ****                 
  77:./Libraries/src/stm32f4xx_tim.c ****       (#) TIM clocks management: this group includes all needed functions 
  78:./Libraries/src/stm32f4xx_tim.c ****           to configure the clock controller unit:
  79:./Libraries/src/stm32f4xx_tim.c ****         (++) Select internal/External clock
  80:./Libraries/src/stm32f4xx_tim.c ****         (++) Select the external clock mode: ETR(Mode1/Mode2), TIx or ITRx
  81:./Libraries/src/stm32f4xx_tim.c ****            
  82:./Libraries/src/stm32f4xx_tim.c ****       (#) TIM synchronization management: this group includes all needed 
  83:./Libraries/src/stm32f4xx_tim.c ****           functions to configure the Synchronization unit:
  84:./Libraries/src/stm32f4xx_tim.c ****         (++) Select Input Trigger  
  85:./Libraries/src/stm32f4xx_tim.c ****         (++) Select Output Trigger  
  86:./Libraries/src/stm32f4xx_tim.c ****         (++) Select Master Slave Mode 
  87:./Libraries/src/stm32f4xx_tim.c ****         (++) ETR Configuration when used as external trigger   
ARM GAS  /tmp/cc0EAqnP.s 			page 3


  88:./Libraries/src/stm32f4xx_tim.c ****        
  89:./Libraries/src/stm32f4xx_tim.c ****       (#) TIM specific interface management, this group includes all 
  90:./Libraries/src/stm32f4xx_tim.c ****           needed functions to use the specific TIM interface:
  91:./Libraries/src/stm32f4xx_tim.c ****         (++) Encoder Interface Configuration
  92:./Libraries/src/stm32f4xx_tim.c ****         (++) Select Hall Sensor   
  93:./Libraries/src/stm32f4xx_tim.c ****            
  94:./Libraries/src/stm32f4xx_tim.c ****       (#) TIM specific remapping management includes the Remapping 
  95:./Libraries/src/stm32f4xx_tim.c ****           configuration of specific timers               
  96:./Libraries/src/stm32f4xx_tim.c ****      
  97:./Libraries/src/stm32f4xx_tim.c ****   @endverbatim    
  98:./Libraries/src/stm32f4xx_tim.c ****   ******************************************************************************
