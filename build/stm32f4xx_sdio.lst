 158:./Libraries/src/stm32f4xx_sdio.c **** 
 159:./Libraries/src/stm32f4xx_sdio.c **** /** @addtogroup STM32F4xx_StdPeriph_Driver
 160:./Libraries/src/stm32f4xx_sdio.c ****   * @{
 161:./Libraries/src/stm32f4xx_sdio.c ****   */
 162:./Libraries/src/stm32f4xx_sdio.c **** 
 163:./Libraries/src/stm32f4xx_sdio.c **** /** @defgroup SDIO 
 164:./Libraries/src/stm32f4xx_sdio.c ****   * @brief SDIO driver modules
 165:./Libraries/src/stm32f4xx_sdio.c ****   * @{
 166:./Libraries/src/stm32f4xx_sdio.c ****   */ 
 167:./Libraries/src/stm32f4xx_sdio.c **** 
 168:./Libraries/src/stm32f4xx_sdio.c **** /* Private typedef -----------------------------------------------------------*/
 169:./Libraries/src/stm32f4xx_sdio.c **** /* Private define ------------------------------------------------------------*/
 170:./Libraries/src/stm32f4xx_sdio.c **** 
 171:./Libraries/src/stm32f4xx_sdio.c **** /* ------------ SDIO registers bit address in the alias region ----------- */
 172:./Libraries/src/stm32f4xx_sdio.c **** #define SDIO_OFFSET                (SDIO_BASE - PERIPH_BASE)
 173:./Libraries/src/stm32f4xx_sdio.c **** 
 174:./Libraries/src/stm32f4xx_sdio.c **** /* --- CLKCR Register ---*/
 175:./Libraries/src/stm32f4xx_sdio.c **** /* Alias word address of CLKEN bit */
 176:./Libraries/src/stm32f4xx_sdio.c **** #define CLKCR_OFFSET              (SDIO_OFFSET + 0x04)
 177:./Libraries/src/stm32f4xx_sdio.c **** #define CLKEN_BitNumber           0x08
 178:./Libraries/src/stm32f4xx_sdio.c **** #define CLKCR_CLKEN_BB            (PERIPH_BB_BASE + (CLKCR_OFFSET * 32) + (CLKEN_BitNumber * 4))
 179:./Libraries/src/stm32f4xx_sdio.c **** 
 180:./Libraries/src/stm32f4xx_sdio.c **** /* --- CMD Register ---*/
 181:./Libraries/src/stm32f4xx_sdio.c **** /* Alias word address of SDIOSUSPEND bit */
 182:./Libraries/src/stm32f4xx_sdio.c **** #define CMD_OFFSET                (SDIO_OFFSET + 0x0C)
 183:./Libraries/src/stm32f4xx_sdio.c **** #define SDIOSUSPEND_BitNumber     0x0B
 184:./Libraries/src/stm32f4xx_sdio.c **** #define CMD_SDIOSUSPEND_BB        (PERIPH_BB_BASE + (CMD_OFFSET * 32) + (SDIOSUSPEND_BitNumber * 4)
 185:./Libraries/src/stm32f4xx_sdio.c **** 
 186:./Libraries/src/stm32f4xx_sdio.c **** /* Alias word address of ENCMDCOMPL bit */
 187:./Libraries/src/stm32f4xx_sdio.c **** #define ENCMDCOMPL_BitNumber      0x0C
 188:./Libraries/src/stm32f4xx_sdio.c **** #define CMD_ENCMDCOMPL_BB         (PERIPH_BB_BASE + (CMD_OFFSET * 32) + (ENCMDCOMPL_BitNumber * 4))
 189:./Libraries/src/stm32f4xx_sdio.c **** 
 190:./Libraries/src/stm32f4xx_sdio.c **** /* Alias word address of NIEN bit */
 191:./Libraries/src/stm32f4xx_sdio.c **** #define NIEN_BitNumber            0x0D
 192:./Libraries/src/stm32f4xx_sdio.c **** #define CMD_NIEN_BB               (PERIPH_BB_BASE + (CMD_OFFSET * 32) + (NIEN_BitNumber * 4))
 193:./Libraries/src/stm32f4xx_sdio.c **** 
 194:./Libraries/src/stm32f4xx_sdio.c **** /* Alias word address of ATACMD bit */
 195:./Libraries/src/stm32f4xx_sdio.c **** #define ATACMD_BitNumber          0x0E
 196:./Libraries/src/stm32f4xx_sdio.c **** #define CMD_ATACMD_BB             (PERIPH_BB_BASE + (CMD_OFFSET * 32) + (ATACMD_BitNumber * 4))
 197:./Libraries/src/stm32f4xx_sdio.c **** 
 198:./Libraries/src/stm32f4xx_sdio.c **** /* --- DCTRL Register ---*/
 199:./Libraries/src/stm32f4xx_sdio.c **** /* Alias word address of DMAEN bit */
 200:./Libraries/src/stm32f4xx_sdio.c **** #define DCTRL_OFFSET              (SDIO_OFFSET + 0x2C)
 201:./Libraries/src/stm32f4xx_sdio.c **** #define DMAEN_BitNumber           0x03
ARM GAS  /tmp/cceMuoz3.s 			page 5


 202:./Libraries/src/stm32f4xx_sdio.c **** #define DCTRL_DMAEN_BB            (PERIPH_BB_BASE + (DCTRL_OFFSET * 32) + (DMAEN_BitNumber * 4))
 203:./Libraries/src/stm32f4xx_sdio.c **** 
 204:./Libraries/src/stm32f4xx_sdio.c **** /* Alias word address of RWSTART bit */
 205:./Libraries/src/stm32f4xx_sdio.c **** #define RWSTART_BitNumber         0x08
 206:./Libraries/src/stm32f4xx_sdio.c **** #define DCTRL_RWSTART_BB          (PERIPH_BB_BASE + (DCTRL_OFFSET * 32) + (RWSTART_BitNumber * 4))
 207:./Libraries/src/stm32f4xx_sdio.c **** 
 208:./Libraries/src/stm32f4xx_sdio.c **** /* Alias word address of RWSTOP bit */
 209:./Libraries/src/stm32f4xx_sdio.c **** #define RWSTOP_BitNumber          0x09
 210:./Libraries/src/stm32f4xx_sdio.c **** #define DCTRL_RWSTOP_BB           (PERIPH_BB_BASE + (DCTRL_OFFSET * 32) + (RWSTOP_BitNumber * 4))
 211:./Libraries/src/stm32f4xx_sdio.c **** 
 212:./Libraries/src/stm32f4xx_sdio.c **** /* Alias word address of RWMOD bit */
 213:./Libraries/src/stm32f4xx_sdio.c **** #define RWMOD_BitNumber           0x0A
 214:./Libraries/src/stm32f4xx_sdio.c **** #define DCTRL_RWMOD_BB            (PERIPH_BB_BASE + (DCTRL_OFFSET * 32) + (RWMOD_BitNumber * 4))
 215:./Libraries/src/stm32f4xx_sdio.c **** 
 216:./Libraries/src/stm32f4xx_sdio.c **** /* Alias word address of SDIOEN bit */
 217:./Libraries/src/stm32f4xx_sdio.c **** #define SDIOEN_BitNumber          0x0B
 218:./Libraries/src/stm32f4xx_sdio.c **** #define DCTRL_SDIOEN_BB           (PERIPH_BB_BASE + (DCTRL_OFFSET * 32) + (SDIOEN_BitNumber * 4))
 219:./Libraries/src/stm32f4xx_sdio.c **** 
 220:./Libraries/src/stm32f4xx_sdio.c **** /* ---------------------- SDIO registers bit mask ------------------------ */
 221:./Libraries/src/stm32f4xx_sdio.c **** /* --- CLKCR Register ---*/
 222:./Libraries/src/stm32f4xx_sdio.c **** /* CLKCR register clear mask */
 223:./Libraries/src/stm32f4xx_sdio.c **** #define CLKCR_CLEAR_MASK         ((uint32_t)0xFFFF8100) 
 224:./Libraries/src/stm32f4xx_sdio.c **** 
 225:./Libraries/src/stm32f4xx_sdio.c **** /* --- PWRCTRL Register ---*/
 226:./Libraries/src/stm32f4xx_sdio.c **** /* SDIO PWRCTRL Mask */
 227:./Libraries/src/stm32f4xx_sdio.c **** #define PWR_PWRCTRL_MASK         ((uint32_t)0xFFFFFFFC)
 228:./Libraries/src/stm32f4xx_sdio.c **** 
 229:./Libraries/src/stm32f4xx_sdio.c **** /* --- DCTRL Register ---*/
 230:./Libraries/src/stm32f4xx_sdio.c **** /* SDIO DCTRL Clear Mask */
