1580:./Libraries/src/stm32f4xx_can.c ****   * @note   CAN3 peripheral is available only for STM32F413_423xx devices
1581:./Libraries/src/stm32f4xx_can.c ****   * @retval None
1582:./Libraries/src/stm32f4xx_can.c ****   */
1583:./Libraries/src/stm32f4xx_can.c **** void CAN_ClearFlag(CAN_TypeDef* CANx, uint32_t CAN_FLAG)
1584:./Libraries/src/stm32f4xx_can.c **** {
1585:./Libraries/src/stm32f4xx_can.c ****   uint32_t flagtmp=0;
1586:./Libraries/src/stm32f4xx_can.c ****   /* Check the parameters */
1587:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_ALL_PERIPH(CANx));
1588:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_CLEAR_FLAG(CAN_FLAG));
1589:./Libraries/src/stm32f4xx_can.c ****   
1590:./Libraries/src/stm32f4xx_can.c ****   if (CAN_FLAG == CAN_FLAG_LEC) /* ESR register */
1591:./Libraries/src/stm32f4xx_can.c ****   {
1592:./Libraries/src/stm32f4xx_can.c ****     /* Clear the selected CAN flags */
1593:./Libraries/src/stm32f4xx_can.c ****     CANx->ESR = (uint32_t)RESET;
1594:./Libraries/src/stm32f4xx_can.c ****   }
1595:./Libraries/src/stm32f4xx_can.c ****   else /* MSR or TSR or RF0R or RF1R */
1596:./Libraries/src/stm32f4xx_can.c ****   {
1597:./Libraries/src/stm32f4xx_can.c ****     flagtmp = CAN_FLAG & 0x000FFFFF;
1598:./Libraries/src/stm32f4xx_can.c **** 
1599:./Libraries/src/stm32f4xx_can.c ****     if ((CAN_FLAG & CAN_FLAGS_RF0R)!=(uint32_t)RESET)
1600:./Libraries/src/stm32f4xx_can.c ****     {
1601:./Libraries/src/stm32f4xx_can.c ****       /* Receive Flags */
1602:./Libraries/src/stm32f4xx_can.c ****       CANx->RF0R = (uint32_t)(flagtmp);
1603:./Libraries/src/stm32f4xx_can.c ****     }
1604:./Libraries/src/stm32f4xx_can.c ****     else if ((CAN_FLAG & CAN_FLAGS_RF1R)!=(uint32_t)RESET)
1605:./Libraries/src/stm32f4xx_can.c ****     {
1606:./Libraries/src/stm32f4xx_can.c ****       /* Receive Flags */
1607:./Libraries/src/stm32f4xx_can.c ****       CANx->RF1R = (uint32_t)(flagtmp);
1608:./Libraries/src/stm32f4xx_can.c ****     }
1609:./Libraries/src/stm32f4xx_can.c ****     else if ((CAN_FLAG & CAN_FLAGS_TSR)!=(uint32_t)RESET)
1610:./Libraries/src/stm32f4xx_can.c ****     {
1611:./Libraries/src/stm32f4xx_can.c ****       /* Transmit Flags */
1612:./Libraries/src/stm32f4xx_can.c ****       CANx->TSR = (uint32_t)(flagtmp);
1613:./Libraries/src/stm32f4xx_can.c ****     }
1614:./Libraries/src/stm32f4xx_can.c ****     else /* If((CAN_FLAG & CAN_FLAGS_MSR)!=(uint32_t)RESET) */
1615:./Libraries/src/stm32f4xx_can.c ****     {
1616:./Libraries/src/stm32f4xx_can.c ****       /* Operating mode Flags */
1617:./Libraries/src/stm32f4xx_can.c ****       CANx->MSR = (uint32_t)(flagtmp);
1618:./Libraries/src/stm32f4xx_can.c ****     }
1619:./Libraries/src/stm32f4xx_can.c ****   }
1620:./Libraries/src/stm32f4xx_can.c **** }
