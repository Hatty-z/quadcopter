 885:./Libraries/src/stm32f4xx_can.c **** /**
ARM GAS  /tmp/cclurMk5.s 			page 17


 886:./Libraries/src/stm32f4xx_can.c ****   * @brief  Receives a correct CAN frame.
 887:./Libraries/src/stm32f4xx_can.c ****   * @param  CANx: where x can be 1,2 or 3 to select the CAN peripheral.
 888:./Libraries/src/stm32f4xx_can.c ****   * @param  FIFONumber: Receive FIFO number, CAN_FIFO0 or CAN_FIFO1.
 889:./Libraries/src/stm32f4xx_can.c ****   * @param  RxMessage: pointer to a structure receive frame which contains CAN Id,
 890:./Libraries/src/stm32f4xx_can.c ****   *         CAN DLC, CAN data and FMI number.
 891:./Libraries/src/stm32f4xx_can.c ****   * @note   CAN3 peripheral is available only for STM32F413_423xx devices
 892:./Libraries/src/stm32f4xx_can.c ****   * @retval None
 893:./Libraries/src/stm32f4xx_can.c ****   */
 894:./Libraries/src/stm32f4xx_can.c **** void CAN_Receive(CAN_TypeDef* CANx, uint8_t FIFONumber, CanRxMsg* RxMessage)
 895:./Libraries/src/stm32f4xx_can.c **** {
 896:./Libraries/src/stm32f4xx_can.c ****   /* Check the parameters */
 897:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_ALL_PERIPH(CANx));
 898:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_FIFO(FIFONumber));
 899:./Libraries/src/stm32f4xx_can.c ****   /* Get the Id */
 900:./Libraries/src/stm32f4xx_can.c ****   RxMessage->IDE = (uint8_t)0x04 & CANx->sFIFOMailBox[FIFONumber].RIR;
 901:./Libraries/src/stm32f4xx_can.c ****   if (RxMessage->IDE == CAN_Id_Standard)
 902:./Libraries/src/stm32f4xx_can.c ****   {
 903:./Libraries/src/stm32f4xx_can.c ****     RxMessage->StdId = (uint32_t)0x000007FF & (CANx->sFIFOMailBox[FIFONumber].RIR >> 21);
 904:./Libraries/src/stm32f4xx_can.c ****   }
 905:./Libraries/src/stm32f4xx_can.c ****   else
 906:./Libraries/src/stm32f4xx_can.c ****   {
 907:./Libraries/src/stm32f4xx_can.c ****     RxMessage->ExtId = (uint32_t)0x1FFFFFFF & (CANx->sFIFOMailBox[FIFONumber].RIR >> 3);
 908:./Libraries/src/stm32f4xx_can.c ****   }
 909:./Libraries/src/stm32f4xx_can.c ****   
 910:./Libraries/src/stm32f4xx_can.c ****   RxMessage->RTR = (uint8_t)0x02 & CANx->sFIFOMailBox[FIFONumber].RIR;
 911:./Libraries/src/stm32f4xx_can.c ****   /* Get the DLC */
 912:./Libraries/src/stm32f4xx_can.c ****   RxMessage->DLC = (uint8_t)0x0F & CANx->sFIFOMailBox[FIFONumber].RDTR;
 913:./Libraries/src/stm32f4xx_can.c ****   /* Get the FMI */
 914:./Libraries/src/stm32f4xx_can.c ****   RxMessage->FMI = (uint8_t)0xFF & (CANx->sFIFOMailBox[FIFONumber].RDTR >> 8);
 915:./Libraries/src/stm32f4xx_can.c ****   /* Get the data field */
 916:./Libraries/src/stm32f4xx_can.c ****   RxMessage->Data[0] = (uint8_t)0xFF & CANx->sFIFOMailBox[FIFONumber].RDLR;
 917:./Libraries/src/stm32f4xx_can.c ****   RxMessage->Data[1] = (uint8_t)0xFF & (CANx->sFIFOMailBox[FIFONumber].RDLR >> 8);
 918:./Libraries/src/stm32f4xx_can.c ****   RxMessage->Data[2] = (uint8_t)0xFF & (CANx->sFIFOMailBox[FIFONumber].RDLR >> 16);
 919:./Libraries/src/stm32f4xx_can.c ****   RxMessage->Data[3] = (uint8_t)0xFF & (CANx->sFIFOMailBox[FIFONumber].RDLR >> 24);
 920:./Libraries/src/stm32f4xx_can.c ****   RxMessage->Data[4] = (uint8_t)0xFF & CANx->sFIFOMailBox[FIFONumber].RDHR;
 921:./Libraries/src/stm32f4xx_can.c ****   RxMessage->Data[5] = (uint8_t)0xFF & (CANx->sFIFOMailBox[FIFONumber].RDHR >> 8);
 922:./Libraries/src/stm32f4xx_can.c ****   RxMessage->Data[6] = (uint8_t)0xFF & (CANx->sFIFOMailBox[FIFONumber].RDHR >> 16);
 923:./Libraries/src/stm32f4xx_can.c ****   RxMessage->Data[7] = (uint8_t)0xFF & (CANx->sFIFOMailBox[FIFONumber].RDHR >> 24);
 924:./Libraries/src/stm32f4xx_can.c ****   /* Release the FIFO */
 925:./Libraries/src/stm32f4xx_can.c ****   /* Release FIFO0 */
 926:./Libraries/src/stm32f4xx_can.c ****   if (FIFONumber == CAN_FIFO0)
 927:./Libraries/src/stm32f4xx_can.c ****   {
 928:./Libraries/src/stm32f4xx_can.c ****     CANx->RF0R |= CAN_RF0R_RFOM0;
 929:./Libraries/src/stm32f4xx_can.c ****   }
 930:./Libraries/src/stm32f4xx_can.c ****   /* Release FIFO1 */
 931:./Libraries/src/stm32f4xx_can.c ****   else /* FIFONumber == CAN_FIFO1 */
 932:./Libraries/src/stm32f4xx_can.c ****   {
 933:./Libraries/src/stm32f4xx_can.c ****     CANx->RF1R |= CAN_RF1R_RFOM1;
 934:./Libraries/src/stm32f4xx_can.c ****   }
 935:./Libraries/src/stm32f4xx_can.c **** }
