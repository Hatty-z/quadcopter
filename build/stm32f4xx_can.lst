 140:./Libraries/src/stm32f4xx_can.c **** /** @defgroup CAN_Group1 Initialization and Configuration functions
 141:./Libraries/src/stm32f4xx_can.c ****  *  @brief    Initialization and Configuration functions 
 142:./Libraries/src/stm32f4xx_can.c ****  *
 143:./Libraries/src/stm32f4xx_can.c **** @verbatim    
 144:./Libraries/src/stm32f4xx_can.c ****  ===============================================================================
ARM GAS  /tmp/cclurMk5.s 			page 4


 145:./Libraries/src/stm32f4xx_can.c ****               ##### Initialization and Configuration functions #####
 146:./Libraries/src/stm32f4xx_can.c ****  ===============================================================================  
 147:./Libraries/src/stm32f4xx_can.c ****     [..] This section provides functions allowing to 
 148:./Libraries/src/stm32f4xx_can.c ****       (+) Initialize the CAN peripherals : Prescaler, operating mode, the maximum 
 149:./Libraries/src/stm32f4xx_can.c ****           number of time quanta to perform resynchronization, the number of time 
 150:./Libraries/src/stm32f4xx_can.c ****           quanta in Bit Segment 1 and 2 and many other modes. 
 151:./Libraries/src/stm32f4xx_can.c ****           Refer to  @ref CAN_InitTypeDef  for more details.
 152:./Libraries/src/stm32f4xx_can.c ****       (+) Configures the CAN reception filter.                                      
 153:./Libraries/src/stm32f4xx_can.c ****       (+) Select the start bank filter for slave CAN.
 154:./Libraries/src/stm32f4xx_can.c ****       (+) Enables or disables the Debug Freeze mode for CAN
 155:./Libraries/src/stm32f4xx_can.c ****       (+)Enables or disables the CAN Time Trigger Operation communication mode
 156:./Libraries/src/stm32f4xx_can.c ****    
 157:./Libraries/src/stm32f4xx_can.c **** @endverbatim
 158:./Libraries/src/stm32f4xx_can.c ****   * @{
 159:./Libraries/src/stm32f4xx_can.c ****   */
 160:./Libraries/src/stm32f4xx_can.c ****   
 161:./Libraries/src/stm32f4xx_can.c **** /**
 162:./Libraries/src/stm32f4xx_can.c ****   * @brief  Deinitializes the CAN peripheral registers to their default reset values.
 163:./Libraries/src/stm32f4xx_can.c ****   * @param  CANx: where x can be 1,2 or 3 to select the CAN peripheral.
 164:./Libraries/src/stm32f4xx_can.c ****   * @note   CAN3 peripheral is available only for STM32F413_423xx devices
 165:./Libraries/src/stm32f4xx_can.c ****   * @retval None.
 166:./Libraries/src/stm32f4xx_can.c ****   */
 167:./Libraries/src/stm32f4xx_can.c **** void CAN_DeInit(CAN_TypeDef* CANx)
 168:./Libraries/src/stm32f4xx_can.c **** {
 169:./Libraries/src/stm32f4xx_can.c ****   /* Check the parameters */
 170:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_ALL_PERIPH(CANx));
 171:./Libraries/src/stm32f4xx_can.c ****  
 172:./Libraries/src/stm32f4xx_can.c ****   if (CANx == CAN1)
 173:./Libraries/src/stm32f4xx_can.c ****   {
 174:./Libraries/src/stm32f4xx_can.c ****     /* Enable CAN1 reset state */
 175:./Libraries/src/stm32f4xx_can.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_CAN1, ENABLE);
 176:./Libraries/src/stm32f4xx_can.c ****     /* Release CAN1 from reset state */
 177:./Libraries/src/stm32f4xx_can.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_CAN1, DISABLE);
 178:./Libraries/src/stm32f4xx_can.c ****   }
 179:./Libraries/src/stm32f4xx_can.c **** #if defined(STM32F413_423xx)
 180:./Libraries/src/stm32f4xx_can.c ****   else if(CANx == CAN2)
 181:./Libraries/src/stm32f4xx_can.c ****   {  
 182:./Libraries/src/stm32f4xx_can.c ****     /* Enable CAN2 reset state */
 183:./Libraries/src/stm32f4xx_can.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_CAN2, ENABLE);
 184:./Libraries/src/stm32f4xx_can.c ****     /* Release CAN2 from reset state */
 185:./Libraries/src/stm32f4xx_can.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_CAN2, DISABLE);
 186:./Libraries/src/stm32f4xx_can.c ****   }
 187:./Libraries/src/stm32f4xx_can.c ****   
 188:./Libraries/src/stm32f4xx_can.c ****   else /* CAN3 available only for STM32F413_423xx */
 189:./Libraries/src/stm32f4xx_can.c ****   {
 190:./Libraries/src/stm32f4xx_can.c ****     /* Enable CAN3 reset state */
 191:./Libraries/src/stm32f4xx_can.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_CAN3, ENABLE);
 192:./Libraries/src/stm32f4xx_can.c ****     /* Release CAN3 from reset state */
 193:./Libraries/src/stm32f4xx_can.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_CAN3, DISABLE); 
 194:./Libraries/src/stm32f4xx_can.c ****   }
 195:./Libraries/src/stm32f4xx_can.c **** #else
 196:./Libraries/src/stm32f4xx_can.c ****   else
 197:./Libraries/src/stm32f4xx_can.c ****   {
 198:./Libraries/src/stm32f4xx_can.c ****     /* Enable CAN2 reset state */
 199:./Libraries/src/stm32f4xx_can.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_CAN2, ENABLE);
 200:./Libraries/src/stm32f4xx_can.c ****     /* Release CAN2 from reset state */
 201:./Libraries/src/stm32f4xx_can.c ****     RCC_APB1PeriphResetCmd(RCC_APB1Periph_CAN2, DISABLE);
ARM GAS  /tmp/cclurMk5.s 			page 5


 202:./Libraries/src/stm32f4xx_can.c ****   }
 203:./Libraries/src/stm32f4xx_can.c **** #endif /* STM32F413_423xx */
 204:./Libraries/src/stm32f4xx_can.c **** }
