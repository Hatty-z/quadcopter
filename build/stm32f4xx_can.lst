1465:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_RQCP1: Request MailBox1 Flag
1466:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_RQCP2: Request MailBox2 Flag
1467:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_FMP0: FIFO 0 Message Pending Flag   
1468:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_FF0: FIFO 0 Full Flag       
1469:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_FOV0: FIFO 0 Overrun Flag 
1470:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_FMP1: FIFO 1 Message Pending Flag   
1471:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_FF1: FIFO 1 Full Flag        
1472:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_FOV1: FIFO 1 Overrun Flag     
1473:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_WKU: Wake up Flag
1474:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_SLAK: Sleep acknowledge Flag 
1475:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_EWG: Error Warning Flag
1476:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_EPV: Error Passive Flag  
1477:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_BOF: Bus-Off Flag    
1478:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_FLAG_LEC: Last error code Flag
1479:./Libraries/src/stm32f4xx_can.c ****   * @note   CAN3 peripheral is available only for STM32F413_423xx devices
1480:./Libraries/src/stm32f4xx_can.c ****   * @retval The new state of CAN_FLAG (SET or RESET).
1481:./Libraries/src/stm32f4xx_can.c ****   */
1482:./Libraries/src/stm32f4xx_can.c **** FlagStatus CAN_GetFlagStatus(CAN_TypeDef* CANx, uint32_t CAN_FLAG)
1483:./Libraries/src/stm32f4xx_can.c **** {
1484:./Libraries/src/stm32f4xx_can.c ****   FlagStatus bitstatus = RESET;
1485:./Libraries/src/stm32f4xx_can.c ****   
