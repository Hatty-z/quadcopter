1052:./Libraries/src/stm32f4xx_can.c **** 
1053:./Libraries/src/stm32f4xx_can.c ****     /* Wait the acknowledge */
1054:./Libraries/src/stm32f4xx_can.c ****     while (((CANx->MSR & CAN_MODE_MASK) != 0) && (timeout!=0))
1055:./Libraries/src/stm32f4xx_can.c ****     {
1056:./Libraries/src/stm32f4xx_can.c ****       timeout--;
