 783:./Libraries/src/stm32f4xx_can.c **** /**
 784:./Libraries/src/stm32f4xx_can.c ****   * @brief  Checks the transmission status of a CAN Frame.
 785:./Libraries/src/stm32f4xx_can.c ****   * @param  CANx: where x can be 1,2 or 3 to select the CAN peripheral.
 786:./Libraries/src/stm32f4xx_can.c ****   * @param  TransmitMailbox: the number of the mailbox that is used for transmission.
 787:./Libraries/src/stm32f4xx_can.c ****   * @note   CAN3 peripheral is available only for STM32F413_423xx devices
 788:./Libraries/src/stm32f4xx_can.c ****   * @retval CAN_TxStatus_Ok if the CAN driver transmits the message, 
 789:./Libraries/src/stm32f4xx_can.c ****   *         CAN_TxStatus_Failed in an other case.
 790:./Libraries/src/stm32f4xx_can.c ****   */
 791:./Libraries/src/stm32f4xx_can.c **** uint8_t CAN_TransmitStatus(CAN_TypeDef* CANx, uint8_t TransmitMailbox)
 792:./Libraries/src/stm32f4xx_can.c **** {
 793:./Libraries/src/stm32f4xx_can.c ****   uint32_t state = 0;
 794:./Libraries/src/stm32f4xx_can.c **** 
 795:./Libraries/src/stm32f4xx_can.c ****   /* Check the parameters */
 796:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_ALL_PERIPH(CANx));
 797:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_TRANSMITMAILBOX(TransmitMailbox));
 798:./Libraries/src/stm32f4xx_can.c ****  
 799:./Libraries/src/stm32f4xx_can.c ****   switch (TransmitMailbox)
 800:./Libraries/src/stm32f4xx_can.c ****   {
 801:./Libraries/src/stm32f4xx_can.c ****     case (CAN_TXMAILBOX_0): 
 802:./Libraries/src/stm32f4xx_can.c ****       state =   CANx->TSR &  (CAN_TSR_RQCP0 | CAN_TSR_TXOK0 | CAN_TSR_TME0);
 803:./Libraries/src/stm32f4xx_can.c ****       break;
 804:./Libraries/src/stm32f4xx_can.c ****     case (CAN_TXMAILBOX_1): 
 805:./Libraries/src/stm32f4xx_can.c ****       state =   CANx->TSR &  (CAN_TSR_RQCP1 | CAN_TSR_TXOK1 | CAN_TSR_TME1);
 806:./Libraries/src/stm32f4xx_can.c ****       break;
 807:./Libraries/src/stm32f4xx_can.c ****     case (CAN_TXMAILBOX_2): 
 808:./Libraries/src/stm32f4xx_can.c ****       state =   CANx->TSR &  (CAN_TSR_RQCP2 | CAN_TSR_TXOK2 | CAN_TSR_TME2);
 809:./Libraries/src/stm32f4xx_can.c ****       break;
 810:./Libraries/src/stm32f4xx_can.c ****     default:
 811:./Libraries/src/stm32f4xx_can.c ****       state = CAN_TxStatus_Failed;
 812:./Libraries/src/stm32f4xx_can.c ****       break;
 813:./Libraries/src/stm32f4xx_can.c ****   }
 814:./Libraries/src/stm32f4xx_can.c ****   switch (state)
 815:./Libraries/src/stm32f4xx_can.c ****   {
 816:./Libraries/src/stm32f4xx_can.c ****       /* transmit pending  */
 817:./Libraries/src/stm32f4xx_can.c ****     case (0x0): state = CAN_TxStatus_Pending;
 818:./Libraries/src/stm32f4xx_can.c ****       break;
 819:./Libraries/src/stm32f4xx_can.c ****       /* transmit failed  */
 820:./Libraries/src/stm32f4xx_can.c ****      case (CAN_TSR_RQCP0 | CAN_TSR_TME0): state = CAN_TxStatus_Failed;
 821:./Libraries/src/stm32f4xx_can.c ****       break;
 822:./Libraries/src/stm32f4xx_can.c ****      case (CAN_TSR_RQCP1 | CAN_TSR_TME1): state = CAN_TxStatus_Failed;
 823:./Libraries/src/stm32f4xx_can.c ****       break;
 824:./Libraries/src/stm32f4xx_can.c ****      case (CAN_TSR_RQCP2 | CAN_TSR_TME2): state = CAN_TxStatus_Failed;
 825:./Libraries/src/stm32f4xx_can.c ****       break;
 826:./Libraries/src/stm32f4xx_can.c ****       /* transmit succeeded  */
 827:./Libraries/src/stm32f4xx_can.c ****     case (CAN_TSR_RQCP0 | CAN_TSR_TXOK0 | CAN_TSR_TME0):state = CAN_TxStatus_Ok;
 828:./Libraries/src/stm32f4xx_can.c ****       break;
ARM GAS  /tmp/cclurMk5.s 			page 16


 829:./Libraries/src/stm32f4xx_can.c ****     case (CAN_TSR_RQCP1 | CAN_TSR_TXOK1 | CAN_TSR_TME1):state = CAN_TxStatus_Ok;
 830:./Libraries/src/stm32f4xx_can.c ****       break;
 831:./Libraries/src/stm32f4xx_can.c ****     case (CAN_TSR_RQCP2 | CAN_TSR_TXOK2 | CAN_TSR_TME2):state = CAN_TxStatus_Ok;
 832:./Libraries/src/stm32f4xx_can.c ****       break;
 833:./Libraries/src/stm32f4xx_can.c ****     default: state = CAN_TxStatus_Failed;
 834:./Libraries/src/stm32f4xx_can.c ****       break;
 835:./Libraries/src/stm32f4xx_can.c ****   }
 836:./Libraries/src/stm32f4xx_can.c ****   return (uint8_t) state;
 837:./Libraries/src/stm32f4xx_can.c **** }
