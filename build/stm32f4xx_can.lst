1417:./Libraries/src/stm32f4xx_can.c **** /**
1418:./Libraries/src/stm32f4xx_can.c ****   * @brief  Enables or disables the specified CANx interrupts.
1419:./Libraries/src/stm32f4xx_can.c ****   * @param  CANx: where x can be 1,2 or 3 to select the CAN peripheral.
1420:./Libraries/src/stm32f4xx_can.c ****   * @param  CAN_IT: specifies the CAN interrupt sources to be enabled or disabled.
1421:./Libraries/src/stm32f4xx_can.c ****   *          This parameter can be: 
1422:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_TME: Transmit mailbox empty Interrupt 
1423:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_FMP0: FIFO 0 message pending Interrupt 
1424:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_FF0: FIFO 0 full Interrupt
1425:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_FOV0: FIFO 0 overrun Interrupt
1426:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_FMP1: FIFO 1 message pending Interrupt 
1427:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_FF1: FIFO 1 full Interrupt
1428:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_FOV1: FIFO 1 overrun Interrupt
1429:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_WKU: Wake-up Interrupt
1430:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_SLK: Sleep acknowledge Interrupt  
1431:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_EWG: Error warning Interrupt
1432:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_EPV: Error passive Interrupt
1433:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_BOF: Bus-off Interrupt  
1434:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_LEC: Last error code Interrupt
1435:./Libraries/src/stm32f4xx_can.c ****   *            @arg CAN_IT_ERR: Error Interrupt
1436:./Libraries/src/stm32f4xx_can.c ****   * @param  NewState: new state of the CAN interrupts.
1437:./Libraries/src/stm32f4xx_can.c ****   * @note   CAN3 peripheral is available only for STM32F413_423xx devices
1438:./Libraries/src/stm32f4xx_can.c ****   *          This parameter can be: ENABLE or DISABLE.
1439:./Libraries/src/stm32f4xx_can.c ****   * @retval None
1440:./Libraries/src/stm32f4xx_can.c ****   */
1441:./Libraries/src/stm32f4xx_can.c **** void CAN_ITConfig(CAN_TypeDef* CANx, uint32_t CAN_IT, FunctionalState NewState)
1442:./Libraries/src/stm32f4xx_can.c **** {
1443:./Libraries/src/stm32f4xx_can.c ****   /* Check the parameters */
1444:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_ALL_PERIPH(CANx));
1445:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_IT(CAN_IT));
1446:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_FUNCTIONAL_STATE(NewState));
1447:./Libraries/src/stm32f4xx_can.c **** 
1448:./Libraries/src/stm32f4xx_can.c ****   if (NewState != DISABLE)
1449:./Libraries/src/stm32f4xx_can.c ****   {
1450:./Libraries/src/stm32f4xx_can.c ****     /* Enable the selected CANx interrupt */
1451:./Libraries/src/stm32f4xx_can.c ****     CANx->IER |= CAN_IT;
1452:./Libraries/src/stm32f4xx_can.c ****   }
1453:./Libraries/src/stm32f4xx_can.c ****   else
1454:./Libraries/src/stm32f4xx_can.c ****   {
1455:./Libraries/src/stm32f4xx_can.c ****     /* Disable the selected CANx interrupt */
ARM GAS  /tmp/cclurMk5.s 			page 27


1456:./Libraries/src/stm32f4xx_can.c ****     CANx->IER &= ~CAN_IT;
1457:./Libraries/src/stm32f4xx_can.c ****   }
1458:./Libraries/src/stm32f4xx_can.c **** }
1459:./Libraries/src/stm32f4xx_can.c **** /**
