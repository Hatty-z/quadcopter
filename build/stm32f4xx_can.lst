1046:./Libraries/src/stm32f4xx_can.c ****     }
1047:./Libraries/src/stm32f4xx_can.c ****   }
1048:./Libraries/src/stm32f4xx_can.c ****   else  if (CAN_OperatingMode == CAN_OperatingMode_Normal)
1049:./Libraries/src/stm32f4xx_can.c ****   {
