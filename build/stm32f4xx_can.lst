 710:./Libraries/src/stm32f4xx_can.c **** /**
 711:./Libraries/src/stm32f4xx_can.c ****   * @brief  Initiates and transmits a CAN frame message.
 712:./Libraries/src/stm32f4xx_can.c ****   * @param  CANx: where x can be 1,2 or 3 to select the CAN peripheral.
 713:./Libraries/src/stm32f4xx_can.c ****   * @param  TxMessage: pointer to a structure which contains CAN Id, CAN DLC and CAN data.
 714:./Libraries/src/stm32f4xx_can.c ****   * @note   CAN3 peripheral is available only for STM32F413_423xx devices
ARM GAS  /tmp/cclurMk5.s 			page 14


 715:./Libraries/src/stm32f4xx_can.c ****   * @retval The number of the mailbox that is used for transmission or
 716:./Libraries/src/stm32f4xx_can.c ****   *         CAN_TxStatus_NoMailBox if there is no empty mailbox.
 717:./Libraries/src/stm32f4xx_can.c ****   */
 718:./Libraries/src/stm32f4xx_can.c **** uint8_t CAN_Transmit(CAN_TypeDef* CANx, CanTxMsg* TxMessage)
 719:./Libraries/src/stm32f4xx_can.c **** {
 720:./Libraries/src/stm32f4xx_can.c ****   uint8_t transmit_mailbox = 0;
 721:./Libraries/src/stm32f4xx_can.c ****   /* Check the parameters */
 722:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_ALL_PERIPH(CANx));
 723:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_IDTYPE(TxMessage->IDE));
 724:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_RTR(TxMessage->RTR));
 725:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_DLC(TxMessage->DLC));
 726:./Libraries/src/stm32f4xx_can.c **** 
 727:./Libraries/src/stm32f4xx_can.c ****   /* Select one empty transmit mailbox */
 728:./Libraries/src/stm32f4xx_can.c ****   if ((CANx->TSR&CAN_TSR_TME0) == CAN_TSR_TME0)
 729:./Libraries/src/stm32f4xx_can.c ****   {
 730:./Libraries/src/stm32f4xx_can.c ****     transmit_mailbox = 0;
 731:./Libraries/src/stm32f4xx_can.c ****   }
 732:./Libraries/src/stm32f4xx_can.c ****   else if ((CANx->TSR&CAN_TSR_TME1) == CAN_TSR_TME1)
 733:./Libraries/src/stm32f4xx_can.c ****   {
 734:./Libraries/src/stm32f4xx_can.c ****     transmit_mailbox = 1;
 735:./Libraries/src/stm32f4xx_can.c ****   }
 736:./Libraries/src/stm32f4xx_can.c ****   else if ((CANx->TSR&CAN_TSR_TME2) == CAN_TSR_TME2)
 737:./Libraries/src/stm32f4xx_can.c ****   {
 738:./Libraries/src/stm32f4xx_can.c ****     transmit_mailbox = 2;
 739:./Libraries/src/stm32f4xx_can.c ****   }
 740:./Libraries/src/stm32f4xx_can.c ****   else
 741:./Libraries/src/stm32f4xx_can.c ****   {
 742:./Libraries/src/stm32f4xx_can.c ****     transmit_mailbox = CAN_TxStatus_NoMailBox;
 743:./Libraries/src/stm32f4xx_can.c ****   }
 744:./Libraries/src/stm32f4xx_can.c **** 
 745:./Libraries/src/stm32f4xx_can.c ****   if (transmit_mailbox != CAN_TxStatus_NoMailBox)
