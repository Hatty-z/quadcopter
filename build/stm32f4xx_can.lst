ARM GAS  /tmp/cclurMk5.s 			page 13


 658:./Libraries/src/stm32f4xx_can.c ****   *         data bytes of the 8-byte message: TIME[7:0] in data byte 6 and TIME[15:8] 
 659:./Libraries/src/stm32f4xx_can.c ****   *         in data byte 7.
 660:./Libraries/src/stm32f4xx_can.c ****   * @note   CAN3 peripheral is available only for STM32F413_423xx devices
 661:./Libraries/src/stm32f4xx_can.c ****   * @retval None
 662:./Libraries/src/stm32f4xx_can.c ****   */
 663:./Libraries/src/stm32f4xx_can.c **** void CAN_TTComModeCmd(CAN_TypeDef* CANx, FunctionalState NewState)
 664:./Libraries/src/stm32f4xx_can.c **** {
 665:./Libraries/src/stm32f4xx_can.c ****   /* Check the parameters */
 666:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_ALL_PERIPH(CANx));
 667:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_FUNCTIONAL_STATE(NewState));
 668:./Libraries/src/stm32f4xx_can.c ****   if (NewState != DISABLE)
 669:./Libraries/src/stm32f4xx_can.c ****   {
 670:./Libraries/src/stm32f4xx_can.c ****     /* Enable the TTCM mode */
 671:./Libraries/src/stm32f4xx_can.c ****     CANx->MCR |= CAN_MCR_TTCM;
 672:./Libraries/src/stm32f4xx_can.c **** 
 673:./Libraries/src/stm32f4xx_can.c ****     /* Set TGT bits */
 674:./Libraries/src/stm32f4xx_can.c ****     CANx->sTxMailBox[0].TDTR |= ((uint32_t)CAN_TDT0R_TGT);
 675:./Libraries/src/stm32f4xx_can.c ****     CANx->sTxMailBox[1].TDTR |= ((uint32_t)CAN_TDT1R_TGT);
 676:./Libraries/src/stm32f4xx_can.c ****     CANx->sTxMailBox[2].TDTR |= ((uint32_t)CAN_TDT2R_TGT);
 677:./Libraries/src/stm32f4xx_can.c ****   }
 678:./Libraries/src/stm32f4xx_can.c ****   else
 679:./Libraries/src/stm32f4xx_can.c ****   {
 680:./Libraries/src/stm32f4xx_can.c ****     /* Disable the TTCM mode */
 681:./Libraries/src/stm32f4xx_can.c ****     CANx->MCR &= (uint32_t)(~(uint32_t)CAN_MCR_TTCM);
 682:./Libraries/src/stm32f4xx_can.c **** 
 683:./Libraries/src/stm32f4xx_can.c ****     /* Reset TGT bits */
 684:./Libraries/src/stm32f4xx_can.c ****     CANx->sTxMailBox[0].TDTR &= ((uint32_t)~CAN_TDT0R_TGT);
 685:./Libraries/src/stm32f4xx_can.c ****     CANx->sTxMailBox[1].TDTR &= ((uint32_t)~CAN_TDT1R_TGT);
 686:./Libraries/src/stm32f4xx_can.c ****     CANx->sTxMailBox[2].TDTR &= ((uint32_t)~CAN_TDT2R_TGT);
 687:./Libraries/src/stm32f4xx_can.c ****   }
 688:./Libraries/src/stm32f4xx_can.c **** }
