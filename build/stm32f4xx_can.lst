 839:./Libraries/src/stm32f4xx_can.c **** /**
 840:./Libraries/src/stm32f4xx_can.c ****   * @brief  Cancels a transmit request.
 841:./Libraries/src/stm32f4xx_can.c ****   * @param  CANx: where x can be 1,2 or 3 to select the CAN peripheral.
 842:./Libraries/src/stm32f4xx_can.c ****   * @param  Mailbox: Mailbox number.
 843:./Libraries/src/stm32f4xx_can.c ****   * @note   CAN3 peripheral is available only for STM32F413_423xx devices
 844:./Libraries/src/stm32f4xx_can.c ****   * @retval None
 845:./Libraries/src/stm32f4xx_can.c ****   */
 846:./Libraries/src/stm32f4xx_can.c **** void CAN_CancelTransmit(CAN_TypeDef* CANx, uint8_t Mailbox)
 847:./Libraries/src/stm32f4xx_can.c **** {
 848:./Libraries/src/stm32f4xx_can.c ****   /* Check the parameters */
 849:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_ALL_PERIPH(CANx));
 850:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_TRANSMITMAILBOX(Mailbox));
 851:./Libraries/src/stm32f4xx_can.c ****   /* abort transmission */
