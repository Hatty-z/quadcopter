1236:./Libraries/src/stm32f4xx_can.c **** {
1237:./Libraries/src/stm32f4xx_can.c ****   uint8_t counter=0;
1238:./Libraries/src/stm32f4xx_can.c ****   
1239:./Libraries/src/stm32f4xx_can.c ****   /* Check the parameters */
1240:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_ALL_PERIPH(CANx));
1241:./Libraries/src/stm32f4xx_can.c ****   
1242:./Libraries/src/stm32f4xx_can.c ****   /* Get the LSB of the 9-bit CANx Transmit Error Counter(TEC) */
1243:./Libraries/src/stm32f4xx_can.c ****   counter = (uint8_t)((CANx->ESR & CAN_ESR_TEC)>> 16);
1244:./Libraries/src/stm32f4xx_can.c ****   
1245:./Libraries/src/stm32f4xx_can.c ****   /* Return the LSB of the 9-bit CANx Transmit Error Counter(TEC) */
1246:./Libraries/src/stm32f4xx_can.c ****   return counter;
1247:./Libraries/src/stm32f4xx_can.c **** }
