 206:./Libraries/src/stm32f4xx_can.c **** /**
 207:./Libraries/src/stm32f4xx_can.c ****   * @brief  Initializes the CAN peripheral according to the specified
 208:./Libraries/src/stm32f4xx_can.c ****   *         parameters in the CAN_InitStruct.
 209:./Libraries/src/stm32f4xx_can.c ****   * @param  CANx: where x can be 1,2 or 3 to select the CAN peripheral.
 210:./Libraries/src/stm32f4xx_can.c ****   * @param  CAN_InitStruct: pointer to a CAN_InitTypeDef structure that contains
 211:./Libraries/src/stm32f4xx_can.c ****   *         the configuration information for the CAN peripheral.
 212:./Libraries/src/stm32f4xx_can.c ****   * @note   CAN3 peripheral is available only for STM32F413_423xx devices
 213:./Libraries/src/stm32f4xx_can.c ****   * @retval Constant indicates initialization succeed which will be 
 214:./Libraries/src/stm32f4xx_can.c ****   *         CAN_InitStatus_Failed or CAN_InitStatus_Success.
 215:./Libraries/src/stm32f4xx_can.c ****   */
 216:./Libraries/src/stm32f4xx_can.c **** uint8_t CAN_Init(CAN_TypeDef* CANx, CAN_InitTypeDef* CAN_InitStruct)
 217:./Libraries/src/stm32f4xx_can.c **** {
 218:./Libraries/src/stm32f4xx_can.c ****   uint8_t InitStatus = CAN_InitStatus_Failed;
 219:./Libraries/src/stm32f4xx_can.c ****   uint32_t wait_ack = 0x00000000;
 220:./Libraries/src/stm32f4xx_can.c ****   /* Check the parameters */
 221:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_ALL_PERIPH(CANx));
 222:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_FUNCTIONAL_STATE(CAN_InitStruct->CAN_TTCM));
 223:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_FUNCTIONAL_STATE(CAN_InitStruct->CAN_ABOM));
 224:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_FUNCTIONAL_STATE(CAN_InitStruct->CAN_AWUM));
 225:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_FUNCTIONAL_STATE(CAN_InitStruct->CAN_NART));
 226:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_FUNCTIONAL_STATE(CAN_InitStruct->CAN_RFLM));
 227:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_FUNCTIONAL_STATE(CAN_InitStruct->CAN_TXFP));
 228:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_MODE(CAN_InitStruct->CAN_Mode));
 229:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_SJW(CAN_InitStruct->CAN_SJW));
 230:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_BS1(CAN_InitStruct->CAN_BS1));
 231:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_BS2(CAN_InitStruct->CAN_BS2));
 232:./Libraries/src/stm32f4xx_can.c ****   assert_param(IS_CAN_PRESCALER(CAN_InitStruct->CAN_Prescaler));
 233:./Libraries/src/stm32f4xx_can.c **** 
 234:./Libraries/src/stm32f4xx_can.c ****   /* Exit from sleep mode */
 235:./Libraries/src/stm32f4xx_can.c ****   CANx->MCR &= (~(uint32_t)CAN_MCR_SLEEP);
 236:./Libraries/src/stm32f4xx_can.c **** 
 237:./Libraries/src/stm32f4xx_can.c ****   /* Request initialisation */
 238:./Libraries/src/stm32f4xx_can.c ****   CANx->MCR |= CAN_MCR_INRQ ;
 239:./Libraries/src/stm32f4xx_can.c **** 
 240:./Libraries/src/stm32f4xx_can.c ****   /* Wait the acknowledge */
