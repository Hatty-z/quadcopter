  98:./Libraries/src/stm32f4xx_can.c **** /* CAN Master Control Register bits */
  99:./Libraries/src/stm32f4xx_can.c **** #define MCR_DBF           ((uint32_t)0x00010000) /* software master reset */
 100:./Libraries/src/stm32f4xx_can.c **** 
 101:./Libraries/src/stm32f4xx_can.c **** /* CAN Mailbox Transmit Request */
 102:./Libraries/src/stm32f4xx_can.c **** #define TMIDxR_TXRQ       ((uint32_t)0x00000001) /* Transmit mailbox request */
 103:./Libraries/src/stm32f4xx_can.c **** 
 104:./Libraries/src/stm32f4xx_can.c **** /* CAN Filter Master Register bits */
 105:./Libraries/src/stm32f4xx_can.c **** #define FMR_FINIT         ((uint32_t)0x00000001) /* Filter init mode */
 106:./Libraries/src/stm32f4xx_can.c **** 
 107:./Libraries/src/stm32f4xx_can.c **** /* Time out for INAK bit */
 108:./Libraries/src/stm32f4xx_can.c **** #define INAK_TIMEOUT      ((uint32_t)0x0000FFFF)
 109:./Libraries/src/stm32f4xx_can.c **** /* Time out for SLAK bit */
 110:./Libraries/src/stm32f4xx_can.c **** #define SLAK_TIMEOUT      ((uint32_t)0x0000FFFF)
 111:./Libraries/src/stm32f4xx_can.c **** 
 112:./Libraries/src/stm32f4xx_can.c **** /* Flags in TSR register */
 113:./Libraries/src/stm32f4xx_can.c **** #define CAN_FLAGS_TSR     ((uint32_t)0x08000000) 
 114:./Libraries/src/stm32f4xx_can.c **** /* Flags in RF1R register */
 115:./Libraries/src/stm32f4xx_can.c **** #define CAN_FLAGS_RF1R    ((uint32_t)0x04000000) 
 116:./Libraries/src/stm32f4xx_can.c **** /* Flags in RF0R register */
 117:./Libraries/src/stm32f4xx_can.c **** #define CAN_FLAGS_RF0R    ((uint32_t)0x02000000) 
 118:./Libraries/src/stm32f4xx_can.c **** /* Flags in MSR register */
 119:./Libraries/src/stm32f4xx_can.c **** #define CAN_FLAGS_MSR     ((uint32_t)0x01000000) 
 120:./Libraries/src/stm32f4xx_can.c **** /* Flags in ESR register */
 121:./Libraries/src/stm32f4xx_can.c **** #define CAN_FLAGS_ESR     ((uint32_t)0x00F00000) 
 122:./Libraries/src/stm32f4xx_can.c **** 
 123:./Libraries/src/stm32f4xx_can.c **** /* Mailboxes definition */
 124:./Libraries/src/stm32f4xx_can.c **** #define CAN_TXMAILBOX_0   ((uint8_t)0x00)
 125:./Libraries/src/stm32f4xx_can.c **** #define CAN_TXMAILBOX_1   ((uint8_t)0x01)
 126:./Libraries/src/stm32f4xx_can.c **** #define CAN_TXMAILBOX_2   ((uint8_t)0x02) 
 127:./Libraries/src/stm32f4xx_can.c **** 
 128:./Libraries/src/stm32f4xx_can.c **** #define CAN_MODE_MASK     ((uint32_t) 0x00000003)
