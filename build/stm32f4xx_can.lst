1036:./Libraries/src/stm32f4xx_can.c ****     {
1037:./Libraries/src/stm32f4xx_can.c ****       timeout--;
1038:./Libraries/src/stm32f4xx_can.c ****     }
1039:./Libraries/src/stm32f4xx_can.c ****     if ((CANx->MSR & CAN_MODE_MASK) != CAN_MSR_INAK)
1040:./Libraries/src/stm32f4xx_can.c ****     {
