 492:./Libraries/src/stm32f4xx_can.c ****         (0x0000FFFF & (uint32_t)CAN_FilterInitStruct->CAN_FilterIdLow);
 493:./Libraries/src/stm32f4xx_can.c ****     /* 32-bit mask or Second 32-bit identifier */
 494:./Libraries/src/stm32f4xx_can.c ****     CAN1->sFilterRegister[CAN_FilterInitStruct->CAN_FilterNumber].FR2 = 
 495:./Libraries/src/stm32f4xx_can.c ****        ((0x0000FFFF & (uint32_t)CAN_FilterInitStruct->CAN_FilterMaskIdHigh) << 16) |
 496:./Libraries/src/stm32f4xx_can.c ****         (0x0000FFFF & (uint32_t)CAN_FilterInitStruct->CAN_FilterMaskIdLow);
 497:./Libraries/src/stm32f4xx_can.c ****   }
 498:./Libraries/src/stm32f4xx_can.c **** 
 499:./Libraries/src/stm32f4xx_can.c ****   /* Filter Mode */
 500:./Libraries/src/stm32f4xx_can.c ****   if (CAN_FilterInitStruct->CAN_FilterMode == CAN_FilterMode_IdMask)
 501:./Libraries/src/stm32f4xx_can.c ****   {
 502:./Libraries/src/stm32f4xx_can.c ****     /*Id/Mask mode for the filter*/
 503:./Libraries/src/stm32f4xx_can.c ****     CAN1->FM1R &= ~(uint32_t)filter_number_bit_pos;
 504:./Libraries/src/stm32f4xx_can.c ****   }
 505:./Libraries/src/stm32f4xx_can.c ****   else /* CAN_FilterInitStruct->CAN_FilterMode == CAN_FilterMode_IdList */
 506:./Libraries/src/stm32f4xx_can.c ****   {
 507:./Libraries/src/stm32f4xx_can.c ****     /*Identifier list mode for the filter*/
 508:./Libraries/src/stm32f4xx_can.c ****     CAN1->FM1R |= (uint32_t)filter_number_bit_pos;
 509:./Libraries/src/stm32f4xx_can.c ****   }
 510:./Libraries/src/stm32f4xx_can.c **** 
 511:./Libraries/src/stm32f4xx_can.c ****   /* Filter FIFO assignment */
 512:./Libraries/src/stm32f4xx_can.c ****   if (CAN_FilterInitStruct->CAN_FilterFIFOAssignment == CAN_Filter_FIFO0)
 513:./Libraries/src/stm32f4xx_can.c ****   {
 514:./Libraries/src/stm32f4xx_can.c ****     /* FIFO 0 assignation for the filter */
 515:./Libraries/src/stm32f4xx_can.c ****     CAN1->FFA1R &= ~(uint32_t)filter_number_bit_pos;
 516:./Libraries/src/stm32f4xx_can.c ****   }
 517:./Libraries/src/stm32f4xx_can.c **** 
 518:./Libraries/src/stm32f4xx_can.c ****   if (CAN_FilterInitStruct->CAN_FilterFIFOAssignment == CAN_Filter_FIFO1)
 519:./Libraries/src/stm32f4xx_can.c ****   {
 520:./Libraries/src/stm32f4xx_can.c ****     /* FIFO 1 assignation for the filter */
 521:./Libraries/src/stm32f4xx_can.c ****     CAN1->FFA1R |= (uint32_t)filter_number_bit_pos;
 522:./Libraries/src/stm32f4xx_can.c ****   }
 523:./Libraries/src/stm32f4xx_can.c ****   
 524:./Libraries/src/stm32f4xx_can.c ****   /* Filter activation */
 525:./Libraries/src/stm32f4xx_can.c ****   if (CAN_FilterInitStruct->CAN_FilterActivation == ENABLE)
 526:./Libraries/src/stm32f4xx_can.c ****   {
