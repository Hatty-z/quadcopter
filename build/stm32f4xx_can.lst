 637:./Libraries/src/stm32f4xx_can.c ****   
 638:./Libraries/src/stm32f4xx_can.c ****   if (NewState != DISABLE)
 639:./Libraries/src/stm32f4xx_can.c ****   {
 640:./Libraries/src/stm32f4xx_can.c ****     /* Enable Debug Freeze  */
 641:./Libraries/src/stm32f4xx_can.c ****     CANx->MCR |= MCR_DBF;
 642:./Libraries/src/stm32f4xx_can.c ****   }
 643:./Libraries/src/stm32f4xx_can.c ****   else
 644:./Libraries/src/stm32f4xx_can.c ****   {
 645:./Libraries/src/stm32f4xx_can.c ****     /* Disable Debug Freeze */
 646:./Libraries/src/stm32f4xx_can.c ****     CANx->MCR &= ~MCR_DBF;
 647:./Libraries/src/stm32f4xx_can.c ****   }
 648:./Libraries/src/stm32f4xx_can.c **** }
