 650:./Libraries/src/stm32f4xx_cryp_aes.c **** /**
 651:./Libraries/src/stm32f4xx_cryp_aes.c ****   * @brief  Encrypt and decrypt using AES in GCM Mode. The GCM and CCM modes
 652:./Libraries/src/stm32f4xx_cryp_aes.c ****   *         are available only on STM32F437x Devices.
 653:./Libraries/src/stm32f4xx_cryp_aes.c ****   * @param  Mode: encryption or decryption Mode.
 654:./Libraries/src/stm32f4xx_cryp_aes.c ****   *          This parameter can be one of the following values:
 655:./Libraries/src/stm32f4xx_cryp_aes.c ****   *            @arg MODE_ENCRYPT: Encryption
 656:./Libraries/src/stm32f4xx_cryp_aes.c ****   *            @arg MODE_DECRYPT: Decryption
 657:./Libraries/src/stm32f4xx_cryp_aes.c ****   * @param  InitVectors: Initialisation Vectors used for AES algorithm.
 658:./Libraries/src/stm32f4xx_cryp_aes.c ****   * @param  Key: Key used for AES algorithm.
 659:./Libraries/src/stm32f4xx_cryp_aes.c ****   * @param  Keysize: length of the Key, must be a 128, 192 or 256.
 660:./Libraries/src/stm32f4xx_cryp_aes.c ****   * @param  Input: pointer to the Input buffer.
 661:./Libraries/src/stm32f4xx_cryp_aes.c ****   * @param  Ilength: length of the Input buffer in bytes, must be a multiple of 16.
 662:./Libraries/src/stm32f4xx_cryp_aes.c ****   * @param  Header: pointer to the header buffer.
ARM GAS  /tmp/ccLf3zK1.s 			page 64


