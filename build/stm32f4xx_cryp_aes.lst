  63:./system/core_cmInstr.h **** /** \brief  Wait For Interrupt
  64:./system/core_cmInstr.h **** 
ARM GAS  /tmp/ccLf3zK1.s 			page 6


  65:./system/core_cmInstr.h ****     Wait For Interrupt is a hint instruction that suspends execution
  66:./system/core_cmInstr.h ****     until one of a number of events occurs.
  67:./system/core_cmInstr.h ****  */
  68:./system/core_cmInstr.h **** #define __WFI                             __wfi
  69:./system/core_cmInstr.h **** 
