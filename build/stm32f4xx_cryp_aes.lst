  71:./system/core_cmInstr.h **** /** \brief  Wait For Event
  72:./system/core_cmInstr.h **** 
  73:./system/core_cmInstr.h ****     Wait For Event is a hint instruction that permits the processor to enter
  74:./system/core_cmInstr.h ****     a low-power state until one of a number of events occurs.
  75:./system/core_cmInstr.h ****  */
  76:./system/core_cmInstr.h **** #define __WFE                             __wfe
  77:./system/core_cmInstr.h **** 
  78:./system/core_cmInstr.h **** 
  79:./system/core_cmInstr.h **** /** \brief  Send Event
  80:./system/core_cmInstr.h **** 
  81:./system/core_cmInstr.h ****     Send Event is a hint instruction. It causes an event to be signaled to the CPU.
  82:./system/core_cmInstr.h ****  */
  83:./system/core_cmInstr.h **** #define __SEV                             __sev
  84:./system/core_cmInstr.h **** 
  85:./system/core_cmInstr.h **** 
  86:./system/core_cmInstr.h **** /** \brief  Instruction Synchronization Barrier
  87:./system/core_cmInstr.h **** 
  88:./system/core_cmInstr.h ****     Instruction Synchronization Barrier flushes the pipeline in the processor,
  89:./system/core_cmInstr.h ****     so that all instructions following the ISB are fetched from cache or
  90:./system/core_cmInstr.h ****     memory, after the instruction has been completed.
