 176:./ucos/Core/os_task.c **** /*
 177:./ucos/Core/os_task.c **** ***************************************************************************************************
 178:./ucos/Core/os_task.c **** *                                            CREATE A TASK
 179:./ucos/Core/os_task.c **** *
 180:./ucos/Core/os_task.c **** * Description: This function is used to have uC/OS-II manage the execution of a task.  Tasks can ei
 181:./ucos/Core/os_task.c **** *              be created prior to the start of multitasking or by a running task.  A task cannot b
 182:./ucos/Core/os_task.c **** *              created by an ISR.
 183:./ucos/Core/os_task.c **** *
 184:./ucos/Core/os_task.c **** * Arguments  : task     is a pointer to the task's code
 185:./ucos/Core/os_task.c **** *
 186:./ucos/Core/os_task.c **** *              p_arg    is a pointer to an optional data area which can be used to pass parameters 
 187:./ucos/Core/os_task.c **** *                       the task when the task first executes.  Where the task is concerned it thin
 188:./ucos/Core/os_task.c **** *                       it was invoked and passed the argument 'p_arg' as follows:
 189:./ucos/Core/os_task.c **** *
 190:./ucos/Core/os_task.c **** *                           void Task (void *p_arg)
 191:./ucos/Core/os_task.c **** *                           {
 192:./ucos/Core/os_task.c **** *                               for (;;) {
 193:./ucos/Core/os_task.c **** *                                   Task code;
 194:./ucos/Core/os_task.c **** *                               }
 195:./ucos/Core/os_task.c **** *                           }
 196:./ucos/Core/os_task.c **** *
 197:./ucos/Core/os_task.c **** *              ptos     is a pointer to the task's top of stack.  If the configuration constant
 198:./ucos/Core/os_task.c **** *                       OS_STK_GROWTH is set to 1, the stack is assumed to grow downward (i.e. from
 199:./ucos/Core/os_task.c **** *                       memory to low memory).  'pstk' will thus point to the highest (valid) memor
 200:./ucos/Core/os_task.c **** *                       location of the stack.  If OS_STK_GROWTH is set to 0, 'pstk' will point to 
 201:./ucos/Core/os_task.c **** *                       lowest memory location of the stack and the stack will grow with increasing
 202:./ucos/Core/os_task.c **** *                       memory locations.
 203:./ucos/Core/os_task.c **** *
 204:./ucos/Core/os_task.c **** *              prio     is the task's priority.  A unique priority MUST be assigned to each task an
 205:./ucos/Core/os_task.c **** *                       lower the number, the higher the priority.
 206:./ucos/Core/os_task.c **** *
 207:./ucos/Core/os_task.c **** * Returns    : OS_ERR_NONE                     if the function was successful.
 208:./ucos/Core/os_task.c **** *              OS_ERR_PRIO_EXIST               if the task priority already exist
 209:./ucos/Core/os_task.c **** *                                              (each task MUST have a unique priority).
 210:./ucos/Core/os_task.c **** *              OS_ERR_PRIO_INVALID             if the priority you specify is higher that the maxim
 211:./ucos/Core/os_task.c **** *                                              allowed (i.e. >= OS_LOWEST_PRIO)
 212:./ucos/Core/os_task.c **** *              OS_ERR_TASK_CREATE_ISR          if you tried to create a task from an ISR.
 213:./ucos/Core/os_task.c **** *              OS_ERR_ILLEGAL_CREATE_RUN_TIME  if you tried to create a task after safety critical
 214:./ucos/Core/os_task.c **** *                                              operation started.
 215:./ucos/Core/os_task.c **** ***************************************************************************************************
 216:./ucos/Core/os_task.c **** */
 217:./ucos/Core/os_task.c **** 
