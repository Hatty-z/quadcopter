 563:./ucos/Core/os_task.c **** /*
 564:./ucos/Core/os_task.c **** ***************************************************************************************************
 565:./ucos/Core/os_task.c **** *                                  REQUEST THAT A TASK DELETE ITSELF
 566:./ucos/Core/os_task.c **** *
 567:./ucos/Core/os_task.c **** * Description: This function is used to:
 568:./ucos/Core/os_task.c **** *                   a) notify a task to delete itself.
 569:./ucos/Core/os_task.c **** *                   b) to see if a task requested that the current task delete itself.
 570:./ucos/Core/os_task.c **** *              This function is a little tricky to understand.  Basically, you have a task that nee
 571:./ucos/Core/os_task.c **** *              to be deleted however, this task has resources that it has allocated (memory buffers
 572:./ucos/Core/os_task.c **** *              semaphores, mailboxes, queues etc.).  The task cannot be deleted otherwise these
 573:./ucos/Core/os_task.c **** *              resources would not be freed.  The requesting task calls OSTaskDelReq() to indicate 
 574:./ucos/Core/os_task.c **** *              the task needs to be deleted.  Deleting of the task is however, deferred to the task
 575:./ucos/Core/os_task.c **** *              be deleted.  For example, suppose that task #10 needs to be deleted.  The requesting
 576:./ucos/Core/os_task.c **** *              example, task #5, would call OSTaskDelReq(10).  When task #10 gets to execute, it ca
 577:./ucos/Core/os_task.c **** *              this function by specifying OS_PRIO_SELF and monitors the returned value.  If the re
 578:./ucos/Core/os_task.c **** *              value is OS_ERR_TASK_DEL_REQ, another task requested a task delete.  Task #10 would 
 579:./ucos/Core/os_task.c **** *              this:
 580:./ucos/Core/os_task.c **** *
 581:./ucos/Core/os_task.c **** *                   void Task(void *p_arg)
 582:./ucos/Core/os_task.c **** *                   {
 583:./ucos/Core/os_task.c **** *                       .
 584:./ucos/Core/os_task.c **** *                       .
 585:./ucos/Core/os_task.c **** *                       while (1) {
 586:./ucos/Core/os_task.c **** *                           OSTimeDly(1);
 587:./ucos/Core/os_task.c **** *                           if (OSTaskDelReq(OS_PRIO_SELF) == OS_ERR_TASK_DEL_REQ) {
 588:./ucos/Core/os_task.c **** *                               Release any owned resources;
 589:./ucos/Core/os_task.c **** *                               De-allocate any dynamic memory;
 590:./ucos/Core/os_task.c **** *                               OSTaskDel(OS_PRIO_SELF);
 591:./ucos/Core/os_task.c **** *                           }
 592:./ucos/Core/os_task.c **** *                       }
 593:./ucos/Core/os_task.c **** *                   }
 594:./ucos/Core/os_task.c **** *
 595:./ucos/Core/os_task.c **** * Arguments  : prio    is the priority of the task to request the delete from
ARM GAS  /tmp/ccRHzMZz.s 			page 30


 596:./ucos/Core/os_task.c **** *
 597:./ucos/Core/os_task.c **** * Returns    : OS_ERR_NONE                  if the task exist and the request has been registered
 598:./ucos/Core/os_task.c **** *              OS_ERR_ILLEGAL_DEL_RUN_TIME  if you tried to delete a task after safety critical ope
 599:./ucos/Core/os_task.c **** *                                           started.
 600:./ucos/Core/os_task.c **** *              OS_ERR_TASK_NOT_EXIST        if the task has been deleted.  This allows the caller t
 601:./ucos/Core/os_task.c **** *                                           whether the request has been executed.
 602:./ucos/Core/os_task.c **** *              OS_ERR_TASK_DEL              if the task is assigned to a Mutex.
 603:./ucos/Core/os_task.c **** *              OS_ERR_TASK_DEL_IDLE         if you requested to delete uC/OS-II's idle task
 604:./ucos/Core/os_task.c **** *              OS_ERR_PRIO_INVALID          if the priority you specify is higher that the maximum 
 605:./ucos/Core/os_task.c **** *                                           (i.e. >= OS_LOWEST_PRIO) or, you have not specified OS_
 606:./ucos/Core/os_task.c **** *              OS_ERR_TASK_DEL_REQ          if a task (possibly another task) requested that the ru
 607:./ucos/Core/os_task.c **** *                                           task be deleted.
 608:./ucos/Core/os_task.c **** ***************************************************************************************************
 609:./ucos/Core/os_task.c **** */
 610:./ucos/Core/os_task.c **** 
