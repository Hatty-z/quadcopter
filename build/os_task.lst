 663:./ucos/Core/os_task.c **** ***************************************************************************************************
 664:./ucos/Core/os_task.c **** *                                       GET THE NAME OF A TASK
 665:./ucos/Core/os_task.c **** *
 666:./ucos/Core/os_task.c **** * Description: This function is called to obtain the name of a task.
 667:./ucos/Core/os_task.c **** *
 668:./ucos/Core/os_task.c **** * Arguments  : prio      is the priority of the task that you want to obtain the name from.
 669:./ucos/Core/os_task.c **** *
 670:./ucos/Core/os_task.c **** *              pname     is a pointer to a pointer to an ASCII string that will receive the name of
 671:./ucos/Core/os_task.c **** *
 672:./ucos/Core/os_task.c **** *              perr      is a pointer to an error code that can contain one of the following values
 673:./ucos/Core/os_task.c **** *
 674:./ucos/Core/os_task.c **** *                        OS_ERR_NONE                if the requested task is resumed
 675:./ucos/Core/os_task.c **** *                        OS_ERR_TASK_NOT_EXIST      if the task has not been created or is assigned
 676:./ucos/Core/os_task.c **** *                        OS_ERR_PRIO_INVALID        if you specified an invalid priority:
 677:./ucos/Core/os_task.c **** *                                                   A higher value than the idle task or not OS_PRI
 678:./ucos/Core/os_task.c **** *                        OS_ERR_PNAME_NULL          You passed a NULL pointer for 'pname'
 679:./ucos/Core/os_task.c **** *                        OS_ERR_NAME_GET_ISR        You called this function from an ISR
 680:./ucos/Core/os_task.c **** *
 681:./ucos/Core/os_task.c **** *
 682:./ucos/Core/os_task.c **** * Returns    : The length of the string or 0 if the task does not exist.
 683:./ucos/Core/os_task.c **** ***************************************************************************************************
 684:./ucos/Core/os_task.c **** */
