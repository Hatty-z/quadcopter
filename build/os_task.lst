 273:./ucos/Core/os_task.c **** /*
 274:./ucos/Core/os_task.c **** ***************************************************************************************************
 275:./ucos/Core/os_task.c **** *                                  CREATE A TASK (Extended Version)
 276:./ucos/Core/os_task.c **** *
ARM GAS  /tmp/ccRHzMZz.s 			page 18


 277:./ucos/Core/os_task.c **** * Description: This function is used to have uC/OS-II manage the execution of a task.  Tasks can ei
 278:./ucos/Core/os_task.c **** *              be created prior to the start of multitasking or by a running task.  A task cannot b
 279:./ucos/Core/os_task.c **** *              created by an ISR.  This function is similar to OSTaskCreate() except that it allows
 280:./ucos/Core/os_task.c **** *              additional information about a task to be specified.
 281:./ucos/Core/os_task.c **** *
 282:./ucos/Core/os_task.c **** * Arguments  : task      is a pointer to the task's code
 283:./ucos/Core/os_task.c **** *
 284:./ucos/Core/os_task.c **** *              p_arg     is a pointer to an optional data area which can be used to pass parameters
 285:./ucos/Core/os_task.c **** *                        the task when the task first executes.  Where the task is concerned it thi
 286:./ucos/Core/os_task.c **** *                        it was invoked and passed the argument 'p_arg' as follows:
 287:./ucos/Core/os_task.c **** *
 288:./ucos/Core/os_task.c **** *                            void Task (void *p_arg)
 289:./ucos/Core/os_task.c **** *                            {
 290:./ucos/Core/os_task.c **** *                                for (;;) {
 291:./ucos/Core/os_task.c **** *                                    Task code;
 292:./ucos/Core/os_task.c **** *                                }
 293:./ucos/Core/os_task.c **** *                            }
 294:./ucos/Core/os_task.c **** *
 295:./ucos/Core/os_task.c **** *              ptos      is a pointer to the task's top of stack.  If the configuration constant
 296:./ucos/Core/os_task.c **** *                        OS_STK_GROWTH is set to 1, the stack is assumed to grow downward (i.e. fro
 297:./ucos/Core/os_task.c **** *                        memory to low memory).  'ptos' will thus point to the highest (valid) memo
 298:./ucos/Core/os_task.c **** *                        location of the stack.  If OS_STK_GROWTH is set to 0, 'ptos' will point to
 299:./ucos/Core/os_task.c **** *                        lowest memory location of the stack and the stack will grow with increasin
 300:./ucos/Core/os_task.c **** *                        memory locations.  'ptos' MUST point to a valid 'free' data item.
 301:./ucos/Core/os_task.c **** *
 302:./ucos/Core/os_task.c **** *              prio      is the task's priority.  A unique priority MUST be assigned to each task a
 303:./ucos/Core/os_task.c **** *                        lower the number, the higher the priority.
 304:./ucos/Core/os_task.c **** *
 305:./ucos/Core/os_task.c **** *              id        is the task's ID (0..65535)
 306:./ucos/Core/os_task.c **** *
 307:./ucos/Core/os_task.c **** *              pbos      is a pointer to the task's bottom of stack.  If the configuration constant
 308:./ucos/Core/os_task.c **** *                        OS_STK_GROWTH is set to 1, the stack is assumed to grow downward (i.e. fro
 309:./ucos/Core/os_task.c **** *                        memory to low memory).  'pbos' will thus point to the LOWEST (valid) memor
 310:./ucos/Core/os_task.c **** *                        location of the stack.  If OS_STK_GROWTH is set to 0, 'pbos' will point to
 311:./ucos/Core/os_task.c **** *                        HIGHEST memory location of the stack and the stack will grow with increasi
 312:./ucos/Core/os_task.c **** *                        memory locations.  'pbos' MUST point to a valid 'free' data item.
 313:./ucos/Core/os_task.c **** *
 314:./ucos/Core/os_task.c **** *              stk_size  is the size of the stack in number of elements.  If OS_STK is set to INT8U
 315:./ucos/Core/os_task.c **** *                        'stk_size' corresponds to the number of bytes available.  If OS_STK is set
 316:./ucos/Core/os_task.c **** *                        INT16U, 'stk_size' contains the number of 16-bit entries available.  Final
 317:./ucos/Core/os_task.c **** *                        OS_STK is set to INT32U, 'stk_size' contains the number of 32-bit entries
 318:./ucos/Core/os_task.c **** *                        available on the stack.
 319:./ucos/Core/os_task.c **** *
 320:./ucos/Core/os_task.c **** *              pext      is a pointer to a user supplied memory location which is used as a TCB ext
 321:./ucos/Core/os_task.c **** *                        For example, this user memory can hold the contents of floating-point regi
 322:./ucos/Core/os_task.c **** *                        during a context switch, the time each task takes to execute, the number o
 323:./ucos/Core/os_task.c **** *                        the task has been switched-in, etc.
 324:./ucos/Core/os_task.c **** *
 325:./ucos/Core/os_task.c **** *              opt       contains additional information (or options) about the behavior of the tas
 326:./ucos/Core/os_task.c **** *                        LOWER 8-bits are reserved by uC/OS-II while the upper 8 bits can be applic
 327:./ucos/Core/os_task.c **** *                        specific.  See OS_TASK_OPT_??? in uCOS-II.H.  Current choices are:
 328:./ucos/Core/os_task.c **** *
 329:./ucos/Core/os_task.c **** *                        OS_TASK_OPT_STK_CHK      Stack checking to be allowed for the task
 330:./ucos/Core/os_task.c **** *                        OS_TASK_OPT_STK_CLR      Clear the stack when the task is created
 331:./ucos/Core/os_task.c **** *                        OS_TASK_OPT_SAVE_FP      If the CPU has floating-point registers, save the
 332:./ucos/Core/os_task.c **** *                                                 during a context switch.
 333:./ucos/Core/os_task.c **** *
ARM GAS  /tmp/ccRHzMZz.s 			page 19


 334:./ucos/Core/os_task.c **** * Returns    : OS_ERR_NONE                     if the function was successful.
 335:./ucos/Core/os_task.c **** *              OS_ERR_PRIO_EXIST               if the task priority already exist
 336:./ucos/Core/os_task.c **** *                                              (each task MUST have a unique priority).
 337:./ucos/Core/os_task.c **** *              OS_ERR_PRIO_INVALID             if the priority you specify is higher that the maxim
 338:./ucos/Core/os_task.c **** *                                              allowed (i.e. > OS_LOWEST_PRIO)
 339:./ucos/Core/os_task.c **** *              OS_ERR_TASK_CREATE_ISR          if you tried to create a task from an ISR.
 340:./ucos/Core/os_task.c **** *              OS_ERR_ILLEGAL_CREATE_RUN_TIME  if you tried to create a task after safety critical
 341:./ucos/Core/os_task.c **** *                                              operation started.
 342:./ucos/Core/os_task.c **** ***************************************************************************************************
 343:./ucos/Core/os_task.c **** */
 344:./ucos/Core/os_task.c **** 
 345:./ucos/Core/os_task.c **** #if OS_TASK_CREATE_EXT_EN > 0u
 346:./ucos/Core/os_task.c **** INT8U  OSTaskCreateExt (void   (*task)(void *p_arg),
 347:./ucos/Core/os_task.c ****                         void    *p_arg,
 348:./ucos/Core/os_task.c ****                         OS_STK  *ptos,
 349:./ucos/Core/os_task.c ****                         INT8U    prio,
 350:./ucos/Core/os_task.c ****                         INT16U   id,
 351:./ucos/Core/os_task.c ****                         OS_STK  *pbos,
 352:./ucos/Core/os_task.c ****                         INT32U   stk_size,
 353:./ucos/Core/os_task.c ****                         void    *pext,
 354:./ucos/Core/os_task.c ****                         INT16U   opt)
 355:./ucos/Core/os_task.c **** {
 356:./ucos/Core/os_task.c ****     OS_STK     *psp;
 357:./ucos/Core/os_task.c ****     INT8U       err;
 358:./ucos/Core/os_task.c **** #if OS_CRITICAL_METHOD == 3u                 /* Allocate storage for CPU status register           
 359:./ucos/Core/os_task.c ****     OS_CPU_SR   cpu_sr = 0u;
 360:./ucos/Core/os_task.c **** #endif
 361:./ucos/Core/os_task.c **** 
 362:./ucos/Core/os_task.c **** 
 363:./ucos/Core/os_task.c **** 
 364:./ucos/Core/os_task.c **** #ifdef OS_SAFETY_CRITICAL_IEC61508
 365:./ucos/Core/os_task.c ****     if (OSSafetyCriticalStartFlag == OS_TRUE) {
 366:./ucos/Core/os_task.c ****         OS_SAFETY_CRITICAL_EXCEPTION();
 367:./ucos/Core/os_task.c ****         return (OS_ERR_ILLEGAL_CREATE_RUN_TIME);
 368:./ucos/Core/os_task.c ****     }
 369:./ucos/Core/os_task.c **** #endif
 370:./ucos/Core/os_task.c **** 
 371:./ucos/Core/os_task.c **** #if OS_ARG_CHK_EN > 0u
 372:./ucos/Core/os_task.c ****     if (prio > OS_LOWEST_PRIO) {             /* Make sure priority is within allowable range       
 373:./ucos/Core/os_task.c ****         return (OS_ERR_PRIO_INVALID);
 374:./ucos/Core/os_task.c ****     }
 375:./ucos/Core/os_task.c **** #endif
 376:./ucos/Core/os_task.c ****     OS_ENTER_CRITICAL();
 377:./ucos/Core/os_task.c ****     if (OSIntNesting > 0u) {                 /* Make sure we don't create the task from within an I
 378:./ucos/Core/os_task.c ****         OS_EXIT_CRITICAL();
 379:./ucos/Core/os_task.c ****         return (OS_ERR_TASK_CREATE_ISR);
 380:./ucos/Core/os_task.c ****     }
 381:./ucos/Core/os_task.c ****     if (OSTCBPrioTbl[prio] == (OS_TCB *)0) { /* Make sure task doesn't already exist at this priori
 382:./ucos/Core/os_task.c ****         OSTCBPrioTbl[prio] = OS_TCB_RESERVED;/* Reserve the priority to prevent others from doing .
 383:./ucos/Core/os_task.c ****                                              /* ... the same thing until task is created.          
 384:./ucos/Core/os_task.c ****         OS_EXIT_CRITICAL();
 385:./ucos/Core/os_task.c **** 
 386:./ucos/Core/os_task.c **** #if (OS_TASK_STAT_STK_CHK_EN > 0u)
 387:./ucos/Core/os_task.c ****         OS_TaskStkClr(pbos, stk_size, opt);                    /* Clear the task stack (if needed) 
