 977:./ucos/Core/os_task.c **** /*
 978:./ucos/Core/os_task.c **** ***************************************************************************************************
 979:./ucos/Core/os_task.c **** *                                           SUSPEND A TASK
 980:./ucos/Core/os_task.c **** *
 981:./ucos/Core/os_task.c **** * Description: This function is called to suspend a task.  The task can be the calling task if the
 982:./ucos/Core/os_task.c **** *              priority passed to OSTaskSuspend() is the priority of the calling task or OS_PRIO_SE
 983:./ucos/Core/os_task.c **** *
 984:./ucos/Core/os_task.c **** * Arguments  : prio     is the priority of the task to suspend.  If you specify OS_PRIO_SELF, the
 985:./ucos/Core/os_task.c **** *                       calling task will suspend itself and rescheduling will occur.
 986:./ucos/Core/os_task.c **** *
 987:./ucos/Core/os_task.c **** * Returns    : OS_ERR_NONE               if the requested task is suspended
 988:./ucos/Core/os_task.c **** *              OS_ERR_TASK_SUSPEND_IDLE  if you attempted to suspend the idle task which is not all
 989:./ucos/Core/os_task.c **** *              OS_ERR_PRIO_INVALID       if the priority you specify is higher that the maximum all
 990:./ucos/Core/os_task.c **** *                                        (i.e. >= OS_LOWEST_PRIO) or, you have not specified OS_PRI
 991:./ucos/Core/os_task.c **** *              OS_ERR_TASK_SUSPEND_PRIO  if the task to suspend does not exist
 992:./ucos/Core/os_task.c **** *              OS_ERR_TASK_NOT_EXIST     if the task is assigned to a Mutex PIP
 993:./ucos/Core/os_task.c **** *
 994:./ucos/Core/os_task.c **** * Note       : You should use this function with great care.  If you suspend a task that is waiting
 995:./ucos/Core/os_task.c **** *              an event (i.e. a message, a semaphore, a queue ...) you will prevent this task from
 996:./ucos/Core/os_task.c **** *              running when the event arrives.
 997:./ucos/Core/os_task.c **** ***************************************************************************************************
 998:./ucos/Core/os_task.c **** */
