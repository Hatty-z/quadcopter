   1:./Libraries/src/stm32f4xx_flash.c **** /**
   2:./Libraries/src/stm32f4xx_flash.c ****   ******************************************************************************
   3:./Libraries/src/stm32f4xx_flash.c ****   * @file    stm32f4xx_flash.c
   4:./Libraries/src/stm32f4xx_flash.c ****   * @author  MCD Application Team
   5:./Libraries/src/stm32f4xx_flash.c ****   * @version V1.8.0
   6:./Libraries/src/stm32f4xx_flash.c ****   * @date    04-November-2016
   7:./Libraries/src/stm32f4xx_flash.c ****   * @brief   This file provides firmware functions to manage the following 
   8:./Libraries/src/stm32f4xx_flash.c ****   *          functionalities of the FLASH peripheral:
   9:./Libraries/src/stm32f4xx_flash.c ****   *            + FLASH Interface configuration
  10:./Libraries/src/stm32f4xx_flash.c ****   *            + FLASH Memory Programming
  11:./Libraries/src/stm32f4xx_flash.c ****   *            + Option Bytes Programming
  12:./Libraries/src/stm32f4xx_flash.c ****   *            + Interrupts and flags management
  13:./Libraries/src/stm32f4xx_flash.c ****   *  
  14:./Libraries/src/stm32f4xx_flash.c ****  @verbatim    
  15:./Libraries/src/stm32f4xx_flash.c ****  ===============================================================================
  16:./Libraries/src/stm32f4xx_flash.c ****                         ##### How to use this driver #####
  17:./Libraries/src/stm32f4xx_flash.c ****  ===============================================================================
  18:./Libraries/src/stm32f4xx_flash.c ****     [..]                             
  19:./Libraries/src/stm32f4xx_flash.c ****       This driver provides functions to configure and program the FLASH memory 
  20:./Libraries/src/stm32f4xx_flash.c ****       of all STM32F4xx devices. These functions are split in 4 groups:
  21:./Libraries/src/stm32f4xx_flash.c ****    
  22:./Libraries/src/stm32f4xx_flash.c ****       (#) FLASH Interface configuration functions: this group includes the
  23:./Libraries/src/stm32f4xx_flash.c ****           management of the following features:
  24:./Libraries/src/stm32f4xx_flash.c ****         (++) Set the latency
  25:./Libraries/src/stm32f4xx_flash.c ****         (++) Enable/Disable the prefetch buffer
  26:./Libraries/src/stm32f4xx_flash.c ****         (++) Enable/Disable the Instruction cache and the Data cache
  27:./Libraries/src/stm32f4xx_flash.c ****         (++) Reset the Instruction cache and the Data cache
  28:./Libraries/src/stm32f4xx_flash.c ****     
  29:./Libraries/src/stm32f4xx_flash.c ****       (#) FLASH Memory Programming functions: this group includes all needed
ARM GAS  /tmp/ccrBRGbZ.s 			page 2


  30:./Libraries/src/stm32f4xx_flash.c ****           functions to erase and program the main memory:
  31:./Libraries/src/stm32f4xx_flash.c ****         (++) Lock and Unlock the FLASH interface
  32:./Libraries/src/stm32f4xx_flash.c ****         (++) Erase function: Erase sector, erase all sectors
  33:./Libraries/src/stm32f4xx_flash.c ****         (++) Program functions: byte, half word, word and double word
  34:./Libraries/src/stm32f4xx_flash.c ****     
  35:./Libraries/src/stm32f4xx_flash.c ****       (#) Option Bytes Programming functions: this group includes all needed
  36:./Libraries/src/stm32f4xx_flash.c ****           functions to manage the Option Bytes:
  37:./Libraries/src/stm32f4xx_flash.c ****         (++) Set/Reset the write protection
  38:./Libraries/src/stm32f4xx_flash.c ****         (++) Set the Read protection Level
  39:./Libraries/src/stm32f4xx_flash.c ****         (++) Set the BOR level
  40:./Libraries/src/stm32f4xx_flash.c ****         (++) Program the user Option Bytes
  41:./Libraries/src/stm32f4xx_flash.c ****         (++) Launch the Option Bytes loader
  42:./Libraries/src/stm32f4xx_flash.c ****     
  43:./Libraries/src/stm32f4xx_flash.c ****       (#) Interrupts and flags management functions: this group 
  44:./Libraries/src/stm32f4xx_flash.c ****           includes all needed functions to:
  45:./Libraries/src/stm32f4xx_flash.c ****         (++) Enable/Disable the FLASH interrupt sources
  46:./Libraries/src/stm32f4xx_flash.c ****         (++) Get flags status
  47:./Libraries/src/stm32f4xx_flash.c ****         (++) Clear flags
  48:./Libraries/src/stm32f4xx_flash.c ****         (++) Get FLASH operation status
  49:./Libraries/src/stm32f4xx_flash.c ****         (++) Wait for last FLASH operation   
  50:./Libraries/src/stm32f4xx_flash.c ****  @endverbatim
  51:./Libraries/src/stm32f4xx_flash.c ****   ******************************************************************************
  52:./Libraries/src/stm32f4xx_flash.c ****   * @attention
