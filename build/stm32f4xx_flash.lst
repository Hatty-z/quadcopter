 218:./Libraries/src/stm32f4xx_flash.c ****           On STM32F42xxx/43xxx devices:
 219:./Libraries/src/stm32f4xx_flash.c ****            (++) when VOS[1:0] = '0x01' Scale 3 mode, the maximum value of fHCLK is 120MHz.
 220:./Libraries/src/stm32f4xx_flash.c ****            (++) when VOS[1:0] = '0x10' Scale 2 mode, the maximum value of fHCLK is 144MHz if OverDr
 221:./Libraries/src/stm32f4xx_flash.c ****            (++) when VOS[1:0] = '0x11' Scale 1 mode, the maximum value of fHCLK is 168MHz if OverDr
 222:./Libraries/src/stm32f4xx_flash.c ****           [..]
 223:./Libraries/src/stm32f4xx_flash.c ****           On STM32F401x devices:
 224:./Libraries/src/stm32f4xx_flash.c ****            (++) when VOS[1:0] = '0x01' Scale 3 mode, the maximum value of fHCLK is 60MHz.
 225:./Libraries/src/stm32f4xx_flash.c ****            (++) when VOS[1:0] = '0x10' Scale 2 mode, the maximum value of fHCLK is 84MHz.
 226:./Libraries/src/stm32f4xx_flash.c ****           [..]  
 227:./Libraries/src/stm32f4xx_flash.c ****           On STM32F410xx/STM32F411xE devices:
 228:./Libraries/src/stm32f4xx_flash.c ****            (++) when VOS[1:0] = '0x01' Scale 3 mode, the maximum value of fHCLK is 64MHz.
 229:./Libraries/src/stm32f4xx_flash.c ****            (++) when VOS[1:0] = '0x10' Scale 2 mode, the maximum value of fHCLK is 84MHz.
 230:./Libraries/src/stm32f4xx_flash.c ****            (++) when VOS[1:0] = '0x11' Scale 1 mode, the maximum value of fHCLK is 100MHz.
 231:./Libraries/src/stm32f4xx_flash.c **** 
