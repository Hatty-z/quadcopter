 435:./Libraries/src/stm32f4xx_flash.c **** /**
 436:./Libraries/src/stm32f4xx_flash.c ****   * @brief  Erases a specified FLASH Sector.
 437:./Libraries/src/stm32f4xx_flash.c ****   *
 438:./Libraries/src/stm32f4xx_flash.c ****   * @note   If an erase and a program operations are requested simultaneously,    
 439:./Libraries/src/stm32f4xx_flash.c ****   *         the erase operation is performed before the program one.
 440:./Libraries/src/stm32f4xx_flash.c ****   *
 441:./Libraries/src/stm32f4xx_flash.c ****   * @param  FLASH_Sector: The Sector number to be erased.
 442:./Libraries/src/stm32f4xx_flash.c ****   *
 443:./Libraries/src/stm32f4xx_flash.c ****   *  @note  For STM32F405xx/407xx and STM32F415xx/417xx devices this parameter can 
 444:./Libraries/src/stm32f4xx_flash.c ****   *         be a value between FLASH_Sector_0 and FLASH_Sector_11.
 445:./Libraries/src/stm32f4xx_flash.c ****   *
 446:./Libraries/src/stm32f4xx_flash.c ****   *         For STM32F42xxx/43xxx devices this parameter can be a value between 
 447:./Libraries/src/stm32f4xx_flash.c ****   *         FLASH_Sector_0 and FLASH_Sector_23.
 448:./Libraries/src/stm32f4xx_flash.c ****   *
 449:./Libraries/src/stm32f4xx_flash.c ****   *         For STM32F401xx devices this parameter can be a value between 
 450:./Libraries/src/stm32f4xx_flash.c ****   *         FLASH_Sector_0 and FLASH_Sector_5.
 451:./Libraries/src/stm32f4xx_flash.c ****   *
 452:./Libraries/src/stm32f4xx_flash.c ****   *         For STM32F411xE and STM32F412xG devices this parameter can be a value between 
 453:./Libraries/src/stm32f4xx_flash.c ****   *         FLASH_Sector_0 and FLASH_Sector_7.
 454:./Libraries/src/stm32f4xx_flash.c ****   *
 455:./Libraries/src/stm32f4xx_flash.c ****   *         For STM32F410xx devices this parameter can be a value between 
 456:./Libraries/src/stm32f4xx_flash.c ****   *         FLASH_Sector_0 and FLASH_Sector_4.
 457:./Libraries/src/stm32f4xx_flash.c ****   *
 458:./Libraries/src/stm32f4xx_flash.c ****   *         For STM32F413_423xx devices this parameter can be a value between 
 459:./Libraries/src/stm32f4xx_flash.c ****   *         FLASH_Sector_0 and FLASH_Sector_15.
 460:./Libraries/src/stm32f4xx_flash.c ****   *
 461:./Libraries/src/stm32f4xx_flash.c ****   * @param  VoltageRange: The device voltage range which defines the erase parallelism.  
 462:./Libraries/src/stm32f4xx_flash.c ****   *          This parameter can be one of the following values:
 463:./Libraries/src/stm32f4xx_flash.c ****   *            @arg VoltageRange_1: when the device voltage range is 1.8V to 2.1V, 
 464:./Libraries/src/stm32f4xx_flash.c ****   *                                  the operation will be done by byte (8-bit) 
 465:./Libraries/src/stm32f4xx_flash.c ****   *            @arg VoltageRange_2: when the device voltage range is 2.1V to 2.7V,
 466:./Libraries/src/stm32f4xx_flash.c ****   *                                  the operation will be done by half word (16-bit)
 467:./Libraries/src/stm32f4xx_flash.c ****   *            @arg VoltageRange_3: when the device voltage range is 2.7V to 3.6V,
 468:./Libraries/src/stm32f4xx_flash.c ****   *                                  the operation will be done by word (32-bit)
 469:./Libraries/src/stm32f4xx_flash.c ****   *            @arg VoltageRange_4: when the device voltage range is 2.7V to 3.6V + External Vpp, 
 470:./Libraries/src/stm32f4xx_flash.c ****   *                                  the operation will be done by double word (64-bit)
 471:./Libraries/src/stm32f4xx_flash.c ****   *       
 472:./Libraries/src/stm32f4xx_flash.c ****   * @retval FLASH Status: The returned value can be: FLASH_BUSY, FLASH_ERROR_PROGRAM,
 473:./Libraries/src/stm32f4xx_flash.c ****   *                       FLASH_ERROR_WRP, FLASH_ERROR_OPERATION or FLASH_COMPLETE.
 474:./Libraries/src/stm32f4xx_flash.c ****   */
 475:./Libraries/src/stm32f4xx_flash.c **** FLASH_Status FLASH_EraseSector(uint32_t FLASH_Sector, uint8_t VoltageRange)
 476:./Libraries/src/stm32f4xx_flash.c **** {
 477:./Libraries/src/stm32f4xx_flash.c ****   uint32_t tmp_psize = 0x0;
 478:./Libraries/src/stm32f4xx_flash.c ****   FLASH_Status status = FLASH_COMPLETE;
 479:./Libraries/src/stm32f4xx_flash.c **** 
 480:./Libraries/src/stm32f4xx_flash.c ****   /* Check the parameters */
 481:./Libraries/src/stm32f4xx_flash.c ****   assert_param(IS_FLASH_SECTOR(FLASH_Sector));
 482:./Libraries/src/stm32f4xx_flash.c ****   assert_param(IS_VOLTAGERANGE(VoltageRange));
 483:./Libraries/src/stm32f4xx_flash.c ****   
 484:./Libraries/src/stm32f4xx_flash.c ****   if(VoltageRange == VoltageRange_1)
 485:./Libraries/src/stm32f4xx_flash.c ****   {
ARM GAS  /tmp/ccrBRGbZ.s 			page 15


 486:./Libraries/src/stm32f4xx_flash.c ****      tmp_psize = FLASH_PSIZE_BYTE;
 487:./Libraries/src/stm32f4xx_flash.c ****   }
 488:./Libraries/src/stm32f4xx_flash.c ****   else if(VoltageRange == VoltageRange_2)
 489:./Libraries/src/stm32f4xx_flash.c ****   {
 490:./Libraries/src/stm32f4xx_flash.c ****     tmp_psize = FLASH_PSIZE_HALF_WORD;
 491:./Libraries/src/stm32f4xx_flash.c ****   }
 492:./Libraries/src/stm32f4xx_flash.c ****   else if(VoltageRange == VoltageRange_3)
 493:./Libraries/src/stm32f4xx_flash.c ****   {
 494:./Libraries/src/stm32f4xx_flash.c ****     tmp_psize = FLASH_PSIZE_WORD;
 495:./Libraries/src/stm32f4xx_flash.c ****   }
 496:./Libraries/src/stm32f4xx_flash.c ****   else
 497:./Libraries/src/stm32f4xx_flash.c ****   {
 498:./Libraries/src/stm32f4xx_flash.c ****     tmp_psize = FLASH_PSIZE_DOUBLE_WORD;
 499:./Libraries/src/stm32f4xx_flash.c ****   }
 500:./Libraries/src/stm32f4xx_flash.c ****   /* Wait for last operation to be completed */
 501:./Libraries/src/stm32f4xx_flash.c ****   status = FLASH_WaitForLastOperation();
 502:./Libraries/src/stm32f4xx_flash.c ****   
 503:./Libraries/src/stm32f4xx_flash.c ****   if(status == FLASH_COMPLETE)
 504:./Libraries/src/stm32f4xx_flash.c ****   { 
 505:./Libraries/src/stm32f4xx_flash.c ****     /* if the previous operation is completed, proceed to erase the sector */
 506:./Libraries/src/stm32f4xx_flash.c ****     FLASH->CR &= CR_PSIZE_MASK;
 507:./Libraries/src/stm32f4xx_flash.c ****     FLASH->CR |= tmp_psize;
 508:./Libraries/src/stm32f4xx_flash.c ****     FLASH->CR &= SECTOR_MASK;
 509:./Libraries/src/stm32f4xx_flash.c ****     FLASH->CR |= FLASH_CR_SER | FLASH_Sector;
 510:./Libraries/src/stm32f4xx_flash.c ****     FLASH->CR |= FLASH_CR_STRT;
 511:./Libraries/src/stm32f4xx_flash.c ****     
 512:./Libraries/src/stm32f4xx_flash.c ****     /* Wait for last operation to be completed */
 513:./Libraries/src/stm32f4xx_flash.c ****     status = FLASH_WaitForLastOperation();
 514:./Libraries/src/stm32f4xx_flash.c ****     
 515:./Libraries/src/stm32f4xx_flash.c ****     /* if the erase operation is completed, disable the SER Bit */
 516:./Libraries/src/stm32f4xx_flash.c ****     FLASH->CR &= (~FLASH_CR_SER);
 517:./Libraries/src/stm32f4xx_flash.c ****     FLASH->CR &= SECTOR_MASK; 
 518:./Libraries/src/stm32f4xx_flash.c ****   }
 519:./Libraries/src/stm32f4xx_flash.c ****   /* Return the Erase Status */
 520:./Libraries/src/stm32f4xx_flash.c ****   return status;
 521:./Libraries/src/stm32f4xx_flash.c **** }
 522:./Libraries/src/stm32f4xx_flash.c **** 
