 496:./trace/SEGGER/SEGGER_RTT.c **** */
 497:./trace/SEGGER/SEGGER_RTT.c **** static void _PostTerminalSwitch(SEGGER_RTT_BUFFER_UP* pRing, unsigned char TerminalId) {
 498:./trace/SEGGER/SEGGER_RTT.c ****   unsigned char ac[2];
 499:./trace/SEGGER/SEGGER_RTT.c **** 
