 349:./trace/SEGGER/SEGGER_RTT.c **** *
 350:./trace/SEGGER/SEGGER_RTT.c **** *       _WriteBlocking()
 351:./trace/SEGGER/SEGGER_RTT.c **** *
 352:./trace/SEGGER/SEGGER_RTT.c **** *  Function description
 353:./trace/SEGGER/SEGGER_RTT.c **** *    Stores a specified number of characters in SEGGER RTT ring buffer
 354:./trace/SEGGER/SEGGER_RTT.c **** *    and updates the associated write pointer which is periodically
 355:./trace/SEGGER/SEGGER_RTT.c **** *    read by the host.
 356:./trace/SEGGER/SEGGER_RTT.c **** *    The caller is responsible for managing the write chunk sizes as
 357:./trace/SEGGER/SEGGER_RTT.c **** *    _WriteBlocking() will block until all data has been posted successfully.
 358:./trace/SEGGER/SEGGER_RTT.c **** *
 359:./trace/SEGGER/SEGGER_RTT.c **** *  Parameters
 360:./trace/SEGGER/SEGGER_RTT.c **** *    pRing        Ring buffer to post to.
 361:./trace/SEGGER/SEGGER_RTT.c **** *    pBuffer      Pointer to character array. Does not need to point to a \0 terminated string.
 362:./trace/SEGGER/SEGGER_RTT.c **** *    NumBytes     Number of bytes to be stored in the SEGGER RTT control block.
 363:./trace/SEGGER/SEGGER_RTT.c **** *
 364:./trace/SEGGER/SEGGER_RTT.c **** *  Return value
 365:./trace/SEGGER/SEGGER_RTT.c **** *    >= 0 - Number of bytes written into buffer.
 366:./trace/SEGGER/SEGGER_RTT.c **** */
 367:./trace/SEGGER/SEGGER_RTT.c **** static unsigned _WriteBlocking(SEGGER_RTT_BUFFER_UP* pRing, const char* pBuffer, unsigned NumBytes)
 368:./trace/SEGGER/SEGGER_RTT.c ****   unsigned NumBytesToWrite;
 369:./trace/SEGGER/SEGGER_RTT.c ****   unsigned NumBytesWritten;
 370:./trace/SEGGER/SEGGER_RTT.c ****   unsigned RdOff;
 371:./trace/SEGGER/SEGGER_RTT.c ****   unsigned WrOff;
 372:./trace/SEGGER/SEGGER_RTT.c ****   volatile char* pDst;
ARM GAS  /tmp/ccZ5iSyA.s 			page 8


 373:./trace/SEGGER/SEGGER_RTT.c ****   //
 374:./trace/SEGGER/SEGGER_RTT.c ****   // Write data to buffer and handle wrap-around if necessary
 375:./trace/SEGGER/SEGGER_RTT.c ****   //
 376:./trace/SEGGER/SEGGER_RTT.c ****   NumBytesWritten = 0u;
 377:./trace/SEGGER/SEGGER_RTT.c ****   WrOff = pRing->WrOff;
 378:./trace/SEGGER/SEGGER_RTT.c ****   do {
 379:./trace/SEGGER/SEGGER_RTT.c ****     RdOff = pRing->RdOff;                         // May be changed by host (debug probe) in the me
 380:./trace/SEGGER/SEGGER_RTT.c ****     if (RdOff > WrOff) {
 381:./trace/SEGGER/SEGGER_RTT.c ****       NumBytesToWrite = RdOff - WrOff - 1u;
 382:./trace/SEGGER/SEGGER_RTT.c ****     } else {
 383:./trace/SEGGER/SEGGER_RTT.c ****       NumBytesToWrite = pRing->SizeOfBuffer - (WrOff - RdOff + 1u);
 384:./trace/SEGGER/SEGGER_RTT.c ****     }
 385:./trace/SEGGER/SEGGER_RTT.c ****     NumBytesToWrite = MIN(NumBytesToWrite, (pRing->SizeOfBuffer - WrOff));      // Number of bytes 
 386:./trace/SEGGER/SEGGER_RTT.c ****     NumBytesToWrite = MIN(NumBytesToWrite, NumBytes);
 387:./trace/SEGGER/SEGGER_RTT.c ****     pDst = (pRing->pBuffer + WrOff) + SEGGER_RTT_UNCACHED_OFF;
 388:./trace/SEGGER/SEGGER_RTT.c **** #if SEGGER_RTT_MEMCPY_USE_BYTELOOP
 389:./trace/SEGGER/SEGGER_RTT.c ****     NumBytesWritten += NumBytesToWrite;
 390:./trace/SEGGER/SEGGER_RTT.c ****     NumBytes        -= NumBytesToWrite;
 391:./trace/SEGGER/SEGGER_RTT.c ****     WrOff           += NumBytesToWrite;
 392:./trace/SEGGER/SEGGER_RTT.c ****     while (NumBytesToWrite--) {
 393:./trace/SEGGER/SEGGER_RTT.c ****       *pDst++ = *pBuffer++;
 394:./trace/SEGGER/SEGGER_RTT.c ****     };
 395:./trace/SEGGER/SEGGER_RTT.c **** #else
 396:./trace/SEGGER/SEGGER_RTT.c ****     SEGGER_RTT_MEMCPY((void*)pDst, pBuffer, NumBytesToWrite);
 397:./trace/SEGGER/SEGGER_RTT.c ****     NumBytesWritten += NumBytesToWrite;
 398:./trace/SEGGER/SEGGER_RTT.c ****     pBuffer         += NumBytesToWrite;
 399:./trace/SEGGER/SEGGER_RTT.c ****     NumBytes        -= NumBytesToWrite;
 400:./trace/SEGGER/SEGGER_RTT.c ****     WrOff           += NumBytesToWrite;
 401:./trace/SEGGER/SEGGER_RTT.c **** #endif
 402:./trace/SEGGER/SEGGER_RTT.c ****     if (WrOff == pRing->SizeOfBuffer) {
 403:./trace/SEGGER/SEGGER_RTT.c ****       WrOff = 0u;
 404:./trace/SEGGER/SEGGER_RTT.c ****     }
 405:./trace/SEGGER/SEGGER_RTT.c ****     RTT__DMB();                     // Force data write to be complete before writing the <WrOff>, 
 406:./trace/SEGGER/SEGGER_RTT.c ****     pRing->WrOff = WrOff;
 407:./trace/SEGGER/SEGGER_RTT.c ****   } while (NumBytes);
 408:./trace/SEGGER/SEGGER_RTT.c ****   return NumBytesWritten;
 409:./trace/SEGGER/SEGGER_RTT.c **** }
