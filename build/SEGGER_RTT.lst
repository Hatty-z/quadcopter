 899:./trace/SEGGER/SEGGER_RTT.c **** /*********************************************************************
 900:./trace/SEGGER/SEGGER_RTT.c **** *
 901:./trace/SEGGER/SEGGER_RTT.c **** *       SEGGER_RTT_WriteSkipNoLock
 902:./trace/SEGGER/SEGGER_RTT.c **** *
 903:./trace/SEGGER/SEGGER_RTT.c **** *  Function description
 904:./trace/SEGGER/SEGGER_RTT.c **** *    Stores a specified number of characters in SEGGER RTT
 905:./trace/SEGGER/SEGGER_RTT.c **** *    control block which is then read by the host.
 906:./trace/SEGGER/SEGGER_RTT.c **** *    SEGGER_RTT_WriteSkipNoLock does not lock the application and
 907:./trace/SEGGER/SEGGER_RTT.c **** *    skips all data, if the data does not fit into the buffer.
 908:./trace/SEGGER/SEGGER_RTT.c **** *
 909:./trace/SEGGER/SEGGER_RTT.c **** *  Parameters
 910:./trace/SEGGER/SEGGER_RTT.c **** *    BufferIndex  Index of "Up"-buffer to be used (e.g. 0 for "Terminal").
 911:./trace/SEGGER/SEGGER_RTT.c **** *    pBuffer      Pointer to character array. Does not need to point to a \0 terminated string.
 912:./trace/SEGGER/SEGGER_RTT.c **** *    NumBytes     Number of bytes to be stored in the SEGGER RTT control block.
 913:./trace/SEGGER/SEGGER_RTT.c **** *                 MUST be > 0!!!
 914:./trace/SEGGER/SEGGER_RTT.c **** *                 This is done for performance reasons, so no initial check has do be done.
 915:./trace/SEGGER/SEGGER_RTT.c **** *
 916:./trace/SEGGER/SEGGER_RTT.c **** *  Return value
 917:./trace/SEGGER/SEGGER_RTT.c **** *    1: Data has been copied
 918:./trace/SEGGER/SEGGER_RTT.c **** *    0: No space, data has not been copied
 919:./trace/SEGGER/SEGGER_RTT.c **** *
 920:./trace/SEGGER/SEGGER_RTT.c **** *  Notes
 921:./trace/SEGGER/SEGGER_RTT.c **** *    (1) If there is not enough space in the "Up"-buffer, all data is dropped.
 922:./trace/SEGGER/SEGGER_RTT.c **** *    (2) For performance reasons this function does not call Init()
 923:./trace/SEGGER/SEGGER_RTT.c **** *        and may only be called after RTT has been initialized.
 924:./trace/SEGGER/SEGGER_RTT.c **** *        Either by calling SEGGER_RTT_Init() or calling another RTT API function first.
 925:./trace/SEGGER/SEGGER_RTT.c **** */
 926:./trace/SEGGER/SEGGER_RTT.c **** #if (RTT_USE_ASM == 0)
 927:./trace/SEGGER/SEGGER_RTT.c **** unsigned SEGGER_RTT_WriteSkipNoLock(unsigned BufferIndex, const void* pBuffer, unsigned NumBytes) {
 928:./trace/SEGGER/SEGGER_RTT.c ****   const char*           pData;
 929:./trace/SEGGER/SEGGER_RTT.c ****   SEGGER_RTT_BUFFER_UP* pRing;
 930:./trace/SEGGER/SEGGER_RTT.c ****   unsigned              Avail;
 931:./trace/SEGGER/SEGGER_RTT.c ****   unsigned              RdOff;
 932:./trace/SEGGER/SEGGER_RTT.c ****   unsigned              WrOff;
 933:./trace/SEGGER/SEGGER_RTT.c ****   unsigned              Rem;
 934:./trace/SEGGER/SEGGER_RTT.c ****   volatile char*        pDst;
 935:./trace/SEGGER/SEGGER_RTT.c ****   //
ARM GAS  /tmp/ccZ5iSyA.s 			page 45


 936:./trace/SEGGER/SEGGER_RTT.c ****   // Cases:
 937:./trace/SEGGER/SEGGER_RTT.c ****   //   1) RdOff <= WrOff => Space until wrap-around is sufficient
 938:./trace/SEGGER/SEGGER_RTT.c ****   //   2) RdOff <= WrOff => Space after wrap-around needed (copy in 2 chunks)
 939:./trace/SEGGER/SEGGER_RTT.c ****   //   3) RdOff <  WrOff => No space in buf
 940:./trace/SEGGER/SEGGER_RTT.c ****   //   4) RdOff >  WrOff => Space is sufficient
 941:./trace/SEGGER/SEGGER_RTT.c ****   //   5) RdOff >  WrOff => No space in buf
 942:./trace/SEGGER/SEGGER_RTT.c ****   //
 943:./trace/SEGGER/SEGGER_RTT.c ****   // 1) is the most common case for large buffers and assuming that J-Link reads the data fast enou
 944:./trace/SEGGER/SEGGER_RTT.c ****   //
 945:./trace/SEGGER/SEGGER_RTT.c ****   pData = (const char *)pBuffer;
 946:./trace/SEGGER/SEGGER_RTT.c ****   pRing = (SEGGER_RTT_BUFFER_UP*)((uintptr_t)&_SEGGER_RTT.aUp[BufferIndex] + SEGGER_RTT_UNCACHED_OF
 947:./trace/SEGGER/SEGGER_RTT.c ****   RdOff = pRing->RdOff;
 948:./trace/SEGGER/SEGGER_RTT.c ****   WrOff = pRing->WrOff;
 949:./trace/SEGGER/SEGGER_RTT.c ****   pDst = (pRing->pBuffer + WrOff) + SEGGER_RTT_UNCACHED_OFF;
 950:./trace/SEGGER/SEGGER_RTT.c ****   if (RdOff <= WrOff) {                                 // Case 1), 2) or 3)
 951:./trace/SEGGER/SEGGER_RTT.c ****     Avail = pRing->SizeOfBuffer - WrOff - 1u;           // Space until wrap-around (assume 1 byte n
 952:./trace/SEGGER/SEGGER_RTT.c ****     if (Avail >= NumBytes) {                            // Case 1)?
 953:./trace/SEGGER/SEGGER_RTT.c ****       memcpy((void*)pDst, pData, NumBytes);
 954:./trace/SEGGER/SEGGER_RTT.c ****       RTT__DMB();                     // Force data write to be complete before writing the <WrOff>
 955:./trace/SEGGER/SEGGER_RTT.c ****       pRing->WrOff = WrOff + NumBytes;
 956:./trace/SEGGER/SEGGER_RTT.c ****       return 1;
 957:./trace/SEGGER/SEGGER_RTT.c ****     }
 958:./trace/SEGGER/SEGGER_RTT.c ****     Avail += RdOff;                                     // Space incl. wrap-around
 959:./trace/SEGGER/SEGGER_RTT.c ****     if (Avail >= NumBytes) {                            // Case 2? => If not, we have case 3) (does
 960:./trace/SEGGER/SEGGER_RTT.c ****       Rem = pRing->SizeOfBuffer - WrOff;                // Space until end of buffer
 961:./trace/SEGGER/SEGGER_RTT.c ****       memcpy((void*)pDst, pData, Rem);                  // Copy 1st chunk
 962:./trace/SEGGER/SEGGER_RTT.c ****       NumBytes -= Rem;
 963:./trace/SEGGER/SEGGER_RTT.c ****       //
 964:./trace/SEGGER/SEGGER_RTT.c ****       // Special case: First check that assumed RdOff == 0 calculated that last element before wrap
 965:./trace/SEGGER/SEGGER_RTT.c ****       // But 2nd check (considering space until wrap-around and until RdOff) revealed that RdOff is
 966:./trace/SEGGER/SEGGER_RTT.c ****       // In this case, we may use a copy straight until buffer end anyway without needing to copy 2
 967:./trace/SEGGER/SEGGER_RTT.c ****       // Therefore, check if 2nd memcpy is necessary at all
 968:./trace/SEGGER/SEGGER_RTT.c ****       //
 969:./trace/SEGGER/SEGGER_RTT.c ****       if (NumBytes) {
 970:./trace/SEGGER/SEGGER_RTT.c ****         pDst = pRing->pBuffer + SEGGER_RTT_UNCACHED_OFF;
 971:./trace/SEGGER/SEGGER_RTT.c ****         memcpy((void*)pDst, pData + Rem, NumBytes);
 972:./trace/SEGGER/SEGGER_RTT.c ****       }
 973:./trace/SEGGER/SEGGER_RTT.c ****       RTT__DMB();                     // Force data write to be complete before writing the <WrOff>
 974:./trace/SEGGER/SEGGER_RTT.c ****       pRing->WrOff = NumBytes;
 975:./trace/SEGGER/SEGGER_RTT.c ****       return 1;
 976:./trace/SEGGER/SEGGER_RTT.c ****     }
 977:./trace/SEGGER/SEGGER_RTT.c ****   } else {                                             // Potential case 4)
 978:./trace/SEGGER/SEGGER_RTT.c ****     Avail = RdOff - WrOff - 1u;
 979:./trace/SEGGER/SEGGER_RTT.c ****     if (Avail >= NumBytes) {                           // Case 4)? => If not, we have case 5) (does
 980:./trace/SEGGER/SEGGER_RTT.c ****       memcpy((void*)pDst, pData, NumBytes);
 981:./trace/SEGGER/SEGGER_RTT.c ****       RTT__DMB();                     // Force data write to be complete before writing the <WrOff>
 982:./trace/SEGGER/SEGGER_RTT.c ****       pRing->WrOff = WrOff + NumBytes;
 983:./trace/SEGGER/SEGGER_RTT.c ****       return 1;
 984:./trace/SEGGER/SEGGER_RTT.c ****     }
 985:./trace/SEGGER/SEGGER_RTT.c ****   }
 986:./trace/SEGGER/SEGGER_RTT.c ****   return 0;     // No space in buffer
 987:./trace/SEGGER/SEGGER_RTT.c **** }
 988:./trace/SEGGER/SEGGER_RTT.c **** #endif
 989:./trace/SEGGER/SEGGER_RTT.c **** 
