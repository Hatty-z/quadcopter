  84:./ucos/Core/os_time.c **** /*
  85:./ucos/Core/os_time.c **** ***************************************************************************************************
  86:./ucos/Core/os_time.c **** *                                    DELAY TASK FOR SPECIFIED TIME
  87:./ucos/Core/os_time.c **** *
  88:./ucos/Core/os_time.c **** * Description: This function is called to delay execution of the currently running task until some 
  89:./ucos/Core/os_time.c **** *              expires.  This call allows you to specify the delay time in HOURS, MINUTES, SECONDS 
  90:./ucos/Core/os_time.c **** *              MILLISECONDS instead of ticks.
  91:./ucos/Core/os_time.c **** *
  92:./ucos/Core/os_time.c **** * Arguments  : hours     specifies the number of hours that the task will be delayed (max. is 255)
  93:./ucos/Core/os_time.c **** *              minutes   specifies the number of minutes (max. 59)
  94:./ucos/Core/os_time.c **** *              seconds   specifies the number of seconds (max. 59)
  95:./ucos/Core/os_time.c **** *              ms        specifies the number of milliseconds (max. 999)
  96:./ucos/Core/os_time.c **** *
  97:./ucos/Core/os_time.c **** * Returns    : OS_ERR_NONE
  98:./ucos/Core/os_time.c **** *              OS_ERR_TIME_INVALID_MINUTES
  99:./ucos/Core/os_time.c **** *              OS_ERR_TIME_INVALID_SECONDS
 100:./ucos/Core/os_time.c **** *              OS_ERR_TIME_INVALID_MS
 101:./ucos/Core/os_time.c **** *              OS_ERR_TIME_ZERO_DLY
 102:./ucos/Core/os_time.c **** *              OS_ERR_TIME_DLY_ISR
 103:./ucos/Core/os_time.c **** *
 104:./ucos/Core/os_time.c **** * Note(s)    : The resolution on the milliseconds depends on the tick rate.  For example, you can't
 105:./ucos/Core/os_time.c **** *              a 10 mS delay if the ticker interrupts every 100 mS.  In this case, the delay would 
 106:./ucos/Core/os_time.c **** *              set to 0.  The actual delay is rounded to the nearest tick.
 107:./ucos/Core/os_time.c **** ***************************************************************************************************
 108:./ucos/Core/os_time.c **** */
 109:./ucos/Core/os_time.c **** 
 110:./ucos/Core/os_time.c **** #if OS_TIME_DLY_HMSM_EN > 0u
