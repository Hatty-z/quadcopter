2772:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    ==0:  Buffer full, Message *NOT* sent.
2773:./trace/SEGGER/SEGGER_SYSVIEW.c **** */
2774:./trace/SEGGER/SEGGER_SYSVIEW.c **** int SEGGER_SYSVIEW_SendPacket(U8* pPacket, U8* pPayloadEnd, unsigned int EventId) {
2775:./trace/SEGGER/SEGGER_SYSVIEW.c **** #if (SEGGER_SYSVIEW_USE_STATIC_BUFFER == 1)
