 784:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
 785:./trace/SEGGER/SEGGER_SYSVIEW.c ****   // Check if event is disabled from being recorded.
 786:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
 787:./trace/SEGGER/SEGGER_SYSVIEW.c ****   if (EventId < 32) {
 788:./trace/SEGGER/SEGGER_SYSVIEW.c ****     if (_SYSVIEW_Globals.DisabledEvents & ((U32)1u << EventId)) {
 789:./trace/SEGGER/SEGGER_SYSVIEW.c ****       goto SendDone;
 790:./trace/SEGGER/SEGGER_SYSVIEW.c ****     }
 791:./trace/SEGGER/SEGGER_SYSVIEW.c ****   }
 792:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
 793:./trace/SEGGER/SEGGER_SYSVIEW.c ****   // Prepare actual packet.
 794:./trace/SEGGER/SEGGER_SYSVIEW.c ****   // If it is a known packet, prepend eventId only,
 795:./trace/SEGGER/SEGGER_SYSVIEW.c ****   // otherwise prepend packet length and eventId.
 796:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
 797:./trace/SEGGER/SEGGER_SYSVIEW.c ****   if (EventId < 24) {
 798:./trace/SEGGER/SEGGER_SYSVIEW.c ****     *--pStartPacket = (U8)EventId;
 799:./trace/SEGGER/SEGGER_SYSVIEW.c ****   } else {
 800:./trace/SEGGER/SEGGER_SYSVIEW.c ****     //
 801:./trace/SEGGER/SEGGER_SYSVIEW.c ****     // Get data length and prepend it.
 802:./trace/SEGGER/SEGGER_SYSVIEW.c ****     //
 803:./trace/SEGGER/SEGGER_SYSVIEW.c ****     NumBytes = (unsigned int)(pEndPacket - pStartPacket);
 804:./trace/SEGGER/SEGGER_SYSVIEW.c **** #if SEGGER_SYSVIEW_SUPPORT_LONG_DATA
 805:./trace/SEGGER/SEGGER_SYSVIEW.c ****     if (NumBytes < 127) {
