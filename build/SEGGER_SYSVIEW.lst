 564:./trace/SEGGER/SEGGER_SYSVIEW.c **** /*********************************************************************
 565:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
 566:./trace/SEGGER/SEGGER_SYSVIEW.c **** *       _HandleIncomingPacket()
 567:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
 568:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Function description
 569:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Read an incoming command from the down channel and process it.
 570:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
 571:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Additional information
 572:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    This function is called each time after sending a packet.
 573:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Processing incoming packets is done asynchronous. SystemView might
 574:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    already have sent event packets after the host has sent a command.
 575:./trace/SEGGER/SEGGER_SYSVIEW.c **** */
 576:./trace/SEGGER/SEGGER_SYSVIEW.c **** #if (SEGGER_SYSVIEW_POST_MORTEM_MODE != 1)
 577:./trace/SEGGER/SEGGER_SYSVIEW.c **** static void _HandleIncomingPacket(void) {
 578:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U8  Cmd;
 579:./trace/SEGGER/SEGGER_SYSVIEW.c ****   unsigned int Status;
 580:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
 581:./trace/SEGGER/SEGGER_SYSVIEW.c ****   Status = SEGGER_RTT_ReadNoLock(CHANNEL_ID_DOWN, &Cmd, 1);
 582:./trace/SEGGER/SEGGER_SYSVIEW.c ****   if (Status > 0) {
 583:./trace/SEGGER/SEGGER_SYSVIEW.c ****     switch (Cmd) {
 584:./trace/SEGGER/SEGGER_SYSVIEW.c ****     case SEGGER_SYSVIEW_COMMAND_ID_START:
 585:./trace/SEGGER/SEGGER_SYSVIEW.c ****       SEGGER_SYSVIEW_Start();
 586:./trace/SEGGER/SEGGER_SYSVIEW.c ****       break;
 587:./trace/SEGGER/SEGGER_SYSVIEW.c ****     case SEGGER_SYSVIEW_COMMAND_ID_STOP:
 588:./trace/SEGGER/SEGGER_SYSVIEW.c ****       SEGGER_SYSVIEW_Stop();
 589:./trace/SEGGER/SEGGER_SYSVIEW.c ****       break;
 590:./trace/SEGGER/SEGGER_SYSVIEW.c ****     case SEGGER_SYSVIEW_COMMAND_ID_GET_SYSTIME:
 591:./trace/SEGGER/SEGGER_SYSVIEW.c ****       SEGGER_SYSVIEW_RecordSystime();
 592:./trace/SEGGER/SEGGER_SYSVIEW.c ****       break;
 593:./trace/SEGGER/SEGGER_SYSVIEW.c ****     case SEGGER_SYSVIEW_COMMAND_ID_GET_TASKLIST:
 594:./trace/SEGGER/SEGGER_SYSVIEW.c ****       SEGGER_SYSVIEW_SendTaskList();
 595:./trace/SEGGER/SEGGER_SYSVIEW.c ****       break;
 596:./trace/SEGGER/SEGGER_SYSVIEW.c ****     case SEGGER_SYSVIEW_COMMAND_ID_GET_SYSDESC:
 597:./trace/SEGGER/SEGGER_SYSVIEW.c ****       SEGGER_SYSVIEW_GetSysDesc();
 598:./trace/SEGGER/SEGGER_SYSVIEW.c ****       break;
 599:./trace/SEGGER/SEGGER_SYSVIEW.c ****     case SEGGER_SYSVIEW_COMMAND_ID_GET_NUMMODULES:
 600:./trace/SEGGER/SEGGER_SYSVIEW.c ****       SEGGER_SYSVIEW_SendNumModules();
 601:./trace/SEGGER/SEGGER_SYSVIEW.c ****       break;
 602:./trace/SEGGER/SEGGER_SYSVIEW.c ****     case SEGGER_SYSVIEW_COMMAND_ID_GET_MODULEDESC:
 603:./trace/SEGGER/SEGGER_SYSVIEW.c ****       SEGGER_SYSVIEW_SendModuleDescription();
 604:./trace/SEGGER/SEGGER_SYSVIEW.c ****       break;
 605:./trace/SEGGER/SEGGER_SYSVIEW.c ****     case SEGGER_SYSVIEW_COMMAND_ID_GET_MODULE:
 606:./trace/SEGGER/SEGGER_SYSVIEW.c ****       Status = SEGGER_RTT_ReadNoLock(CHANNEL_ID_DOWN, &Cmd, 1);
 607:./trace/SEGGER/SEGGER_SYSVIEW.c ****       if (Status > 0) {
 608:./trace/SEGGER/SEGGER_SYSVIEW.c ****         SEGGER_SYSVIEW_SendModule(Cmd);
 609:./trace/SEGGER/SEGGER_SYSVIEW.c ****       }
 610:./trace/SEGGER/SEGGER_SYSVIEW.c ****       break;
 611:./trace/SEGGER/SEGGER_SYSVIEW.c ****     case SEGGER_SYSVIEW_COMMAND_ID_HEARTBEAT:
 612:./trace/SEGGER/SEGGER_SYSVIEW.c ****       break;
 613:./trace/SEGGER/SEGGER_SYSVIEW.c ****     default:
 614:./trace/SEGGER/SEGGER_SYSVIEW.c ****       if (Cmd >= 128) { // Unknown extended command. Dummy read its parameter.
 615:./trace/SEGGER/SEGGER_SYSVIEW.c ****         SEGGER_RTT_ReadNoLock(CHANNEL_ID_DOWN, &Cmd, 1);
 616:./trace/SEGGER/SEGGER_SYSVIEW.c ****       }
 617:./trace/SEGGER/SEGGER_SYSVIEW.c ****       break;
 618:./trace/SEGGER/SEGGER_SYSVIEW.c ****     }
 619:./trace/SEGGER/SEGGER_SYSVIEW.c ****   }
