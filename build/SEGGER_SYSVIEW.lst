1899:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
1900:./trace/SEGGER/SEGGER_SYSVIEW.c **** *       SEGGER_SYSVIEW_Stop()
1901:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
1902:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Function description
1903:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Stop recording SystemView events.
1904:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
1905:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    This function is triggered by the SystemView Application on disconnect.
1906:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    For single-shot or postmortem mode recording, it can be called
1907:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    by the application.
1908:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
1909:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Additional information
1910:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    This function disables transmission of SystemView packets recorded
1911:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    by subsequent trace calls.  If transmission is enabled when
1912:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    this function is called, a single SystemView Stop event is recorded
1913:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    to the trace, send, and then trace transmission is halted.
1914:./trace/SEGGER/SEGGER_SYSVIEW.c **** */
1915:./trace/SEGGER/SEGGER_SYSVIEW.c **** void SEGGER_SYSVIEW_Stop(void) {
1916:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U8* pPayloadStart;
1917:./trace/SEGGER/SEGGER_SYSVIEW.c ****   RECORD_START(SEGGER_SYSVIEW_INFO_SIZE);
1918:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
1919:./trace/SEGGER/SEGGER_SYSVIEW.c ****   if (_SYSVIEW_Globals.EnableState) {
1920:./trace/SEGGER/SEGGER_SYSVIEW.c ****     _SendPacket(pPayloadStart, pPayloadStart, SYSVIEW_EVTID_TRACE_STOP);
1921:./trace/SEGGER/SEGGER_SYSVIEW.c ****     _SYSVIEW_Globals.EnableState = 0;
1922:./trace/SEGGER/SEGGER_SYSVIEW.c ****   }
1923:./trace/SEGGER/SEGGER_SYSVIEW.c ****   RECORD_END();
1924:./trace/SEGGER/SEGGER_SYSVIEW.c **** }
