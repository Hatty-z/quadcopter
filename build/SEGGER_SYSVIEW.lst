 779:./trace/SEGGER/SEGGER_SYSVIEW.c ****       goto SendDone;
 780:./trace/SEGGER/SEGGER_SYSVIEW.c ****     }
 781:./trace/SEGGER/SEGGER_SYSVIEW.c ****   }
 782:./trace/SEGGER/SEGGER_SYSVIEW.c **** Send:
