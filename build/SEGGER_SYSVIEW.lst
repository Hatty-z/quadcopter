2932:./trace/SEGGER/SEGGER_SYSVIEW.c **** void SEGGER_SYSVIEW_RegisterModule(SEGGER_SYSVIEW_MODULE* pModule) {
2933:./trace/SEGGER/SEGGER_SYSVIEW.c ****   SEGGER_SYSVIEW_LOCK();
2934:./trace/SEGGER/SEGGER_SYSVIEW.c ****   if (_pFirstModule == 0) {
2935:./trace/SEGGER/SEGGER_SYSVIEW.c ****     //
2936:./trace/SEGGER/SEGGER_SYSVIEW.c ****     // No module registered, yet.
2937:./trace/SEGGER/SEGGER_SYSVIEW.c ****     // Start list with new module.
2938:./trace/SEGGER/SEGGER_SYSVIEW.c ****     // EventOffset is the base offset for modules
2939:./trace/SEGGER/SEGGER_SYSVIEW.c ****     //
2940:./trace/SEGGER/SEGGER_SYSVIEW.c ****     pModule->EventOffset = MODULE_EVENT_OFFSET;
2941:./trace/SEGGER/SEGGER_SYSVIEW.c ****     pModule->pNext = 0;
2942:./trace/SEGGER/SEGGER_SYSVIEW.c ****     _pFirstModule = pModule;
2943:./trace/SEGGER/SEGGER_SYSVIEW.c ****     _NumModules = 1;
2944:./trace/SEGGER/SEGGER_SYSVIEW.c ****   } else {
2945:./trace/SEGGER/SEGGER_SYSVIEW.c ****     //
2946:./trace/SEGGER/SEGGER_SYSVIEW.c ****     // Registreded module(s) present.
2947:./trace/SEGGER/SEGGER_SYSVIEW.c ****     // Prepend new module in list.
2948:./trace/SEGGER/SEGGER_SYSVIEW.c ****     // EventOffset set from number of events and offset of previous module.
2949:./trace/SEGGER/SEGGER_SYSVIEW.c ****     //
2950:./trace/SEGGER/SEGGER_SYSVIEW.c ****     pModule->EventOffset = _pFirstModule->EventOffset + _pFirstModule->NumEvents;
2951:./trace/SEGGER/SEGGER_SYSVIEW.c ****     pModule->pNext = _pFirstModule;
2952:./trace/SEGGER/SEGGER_SYSVIEW.c ****     _pFirstModule = pModule;
2953:./trace/SEGGER/SEGGER_SYSVIEW.c ****     _NumModules++;
2954:./trace/SEGGER/SEGGER_SYSVIEW.c ****   }
2955:./trace/SEGGER/SEGGER_SYSVIEW.c ****   SEGGER_SYSVIEW_SendModule(0);
2956:./trace/SEGGER/SEGGER_SYSVIEW.c ****   SEGGER_SYSVIEW_UNLOCK();
2957:./trace/SEGGER/SEGGER_SYSVIEW.c **** }
