 732:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
 733:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Function description
 734:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Send a SystemView packet over RTT. RTT channel and mode are
 735:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    configured by macros when the SystemView component is initialized.
 736:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    This function takes care of maintaining the packet drop count
 737:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    and sending overflow packets when necessary.
 738:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    The packet must be passed without Id and Length because this
 739:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    function prepends it to the packet before transmission.
 740:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
 741:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Parameters
 742:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    pStartPacket - Pointer to start of packet payload.
 743:./trace/SEGGER/SEGGER_SYSVIEW.c **** *                   There must be at least 4 bytes free to prepend Id and Length.
 744:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    pEndPacket   - Pointer to end of packet payload.
 745:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    EventId      - Id of the event to send.
 746:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
 747:./trace/SEGGER/SEGGER_SYSVIEW.c **** */
 748:./trace/SEGGER/SEGGER_SYSVIEW.c **** static void _SendPacket(U8* pStartPacket, U8* pEndPacket, unsigned int EventId) {
 749:./trace/SEGGER/SEGGER_SYSVIEW.c ****   unsigned int  NumBytes;
 750:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U32           TimeStamp;
 751:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U32           Delta;
 752:./trace/SEGGER/SEGGER_SYSVIEW.c **** #if (SEGGER_SYSVIEW_POST_MORTEM_MODE != 1)
 753:./trace/SEGGER/SEGGER_SYSVIEW.c ****   unsigned int  Status;
 754:./trace/SEGGER/SEGGER_SYSVIEW.c **** #endif
 755:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
 756:./trace/SEGGER/SEGGER_SYSVIEW.c **** #if (SEGGER_SYSVIEW_USE_STATIC_BUFFER == 0)
 757:./trace/SEGGER/SEGGER_SYSVIEW.c ****   SEGGER_SYSVIEW_LOCK();
 758:./trace/SEGGER/SEGGER_SYSVIEW.c **** #endif
 759:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
 760:./trace/SEGGER/SEGGER_SYSVIEW.c **** #if (SEGGER_SYSVIEW_POST_MORTEM_MODE == 1)
 761:./trace/SEGGER/SEGGER_SYSVIEW.c ****   if (_SYSVIEW_Globals.EnableState == 0) {
 762:./trace/SEGGER/SEGGER_SYSVIEW.c ****     goto SendDone;
 763:./trace/SEGGER/SEGGER_SYSVIEW.c ****   }
 764:./trace/SEGGER/SEGGER_SYSVIEW.c **** #else
 765:./trace/SEGGER/SEGGER_SYSVIEW.c ****   if (_SYSVIEW_Globals.EnableState == 1) {  // Enabled, no dropped packets remaining
 766:./trace/SEGGER/SEGGER_SYSVIEW.c ****     goto Send;
 767:./trace/SEGGER/SEGGER_SYSVIEW.c ****   }
 768:./trace/SEGGER/SEGGER_SYSVIEW.c ****   if (_SYSVIEW_Globals.EnableState == 0) {
 769:./trace/SEGGER/SEGGER_SYSVIEW.c ****     goto SendDone;
 770:./trace/SEGGER/SEGGER_SYSVIEW.c ****   }
 771:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
 772:./trace/SEGGER/SEGGER_SYSVIEW.c ****   // Handle buffer full situations:
 773:./trace/SEGGER/SEGGER_SYSVIEW.c ****   // Have packets been dropped before because buffer was full?
 774:./trace/SEGGER/SEGGER_SYSVIEW.c ****   // In this case try to send and overflow packet.
ARM GAS  /tmp/ccKdFIUT.s 			page 23


 775:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
