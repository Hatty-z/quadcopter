2555:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->RangeMax);
2556:./trace/SEGGER/SEGGER_SYSVIEW.c ****     pPayload = _EncodeFloat(pPayload, pInfo->ScalingFactor);
2557:./trace/SEGGER/SEGGER_SYSVIEW.c ****     pPayload = _EncodeStr(pPayload, pInfo->sUnit, SEGGER_SYSVIEW_MAX_STRING_LEN);
2558:./trace/SEGGER/SEGGER_SYSVIEW.c ****   } else if (pInfo->ScalingFactor != 0) {
2559:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->DataType);
2560:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->Offset);
2561:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->RangeMin);
2562:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->RangeMax);
2563:./trace/SEGGER/SEGGER_SYSVIEW.c ****     pPayload = _EncodeFloat(pPayload, pInfo->ScalingFactor);
2564:./trace/SEGGER/SEGGER_SYSVIEW.c ****   } else if (pInfo->RangeMax != 0) {
2565:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->DataType);
2566:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->Offset);
2567:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->RangeMin);
2568:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->RangeMax);
2569:./trace/SEGGER/SEGGER_SYSVIEW.c ****   } else if (pInfo->RangeMin != 0) {
2570:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->DataType);
2571:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->Offset);
2572:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->RangeMin);
