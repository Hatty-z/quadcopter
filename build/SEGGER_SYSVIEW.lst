2084:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
2085:./trace/SEGGER/SEGGER_SYSVIEW.c ****   pPayload = _EncodeStr(pPayloadStart, sSysDesc, SEGGER_SYSVIEW_MAX_STRING_LEN);
