2545:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
2546:./trace/SEGGER/SEGGER_SYSVIEW.c ****   pPayload = pPayloadStart;
2547:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SYSVIEW_EVTID_EX_REGISTER_DATA);
2548:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, pInfo->ID);
2549:./trace/SEGGER/SEGGER_SYSVIEW.c ****   pPayload = _EncodeStr(pPayload, pInfo->sName, SEGGER_SYSVIEW_MAX_STRING_LEN);
2550:./trace/SEGGER/SEGGER_SYSVIEW.c ****   
2551:./trace/SEGGER/SEGGER_SYSVIEW.c ****   if (pInfo->sUnit != 0) {
2552:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, pInfo->DataType);
