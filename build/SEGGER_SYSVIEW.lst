 212:./trace/SEGGER/SEGGER_SYSVIEW.c **** #define ENABLE_STATE_ON         1
 213:./trace/SEGGER/SEGGER_SYSVIEW.c **** #define ENABLE_STATE_DROPPING   2
 214:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
