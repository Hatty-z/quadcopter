 181:./trace/SEGGER/SEGGER_SYSVIEW.c **** // Timestamps may be less than full 32-bits, in which case we need to zero
 182:./trace/SEGGER/SEGGER_SYSVIEW.c **** // the unused bits to properly handle overflows.
 183:./trace/SEGGER/SEGGER_SYSVIEW.c **** // Note that this is a quite common scenario, as a 32-bit time such as
 184:./trace/SEGGER/SEGGER_SYSVIEW.c **** // SysTick might be scaled down to reduce bandwith
 185:./trace/SEGGER/SEGGER_SYSVIEW.c **** // or a 16-bit hardware time might be used.
 186:./trace/SEGGER/SEGGER_SYSVIEW.c **** #if SEGGER_SYSVIEW_TIMESTAMP_BITS < 32  // Eliminate unused bits in case hardware timestamps are le
 187:./trace/SEGGER/SEGGER_SYSVIEW.c ****   #define MAKE_DELTA_32BIT(Delta) Delta <<= 32 - SEGGER_SYSVIEW_TIMESTAMP_BITS; \
 188:./trace/SEGGER/SEGGER_SYSVIEW.c ****                                   Delta >>= 32 - SEGGER_SYSVIEW_TIMESTAMP_BITS;
 189:./trace/SEGGER/SEGGER_SYSVIEW.c **** #else
 190:./trace/SEGGER/SEGGER_SYSVIEW.c ****   #define MAKE_DELTA_32BIT(Delta)
 191:./trace/SEGGER/SEGGER_SYSVIEW.c **** #endif
 192:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
 193:./trace/SEGGER/SEGGER_SYSVIEW.c **** #if SEGGER_SYSVIEW_SUPPORT_LONG_ID
 194:./trace/SEGGER/SEGGER_SYSVIEW.c ****   #define _MAX_ID_BYTES       5u
 195:./trace/SEGGER/SEGGER_SYSVIEW.c **** #else
 196:./trace/SEGGER/SEGGER_SYSVIEW.c ****   #define _MAX_ID_BYTES       2u
 197:./trace/SEGGER/SEGGER_SYSVIEW.c **** #endif
 198:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
 199:./trace/SEGGER/SEGGER_SYSVIEW.c **** #if SEGGER_SYSVIEW_SUPPORT_LONG_DATA
 200:./trace/SEGGER/SEGGER_SYSVIEW.c ****   #define _MAX_DATA_BYTES     5u
 201:./trace/SEGGER/SEGGER_SYSVIEW.c **** #else
ARM GAS  /tmp/ccKdFIUT.s 			page 5


 202:./trace/SEGGER/SEGGER_SYSVIEW.c ****   #define _MAX_DATA_BYTES     2u
 203:./trace/SEGGER/SEGGER_SYSVIEW.c **** #endif
 204:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
