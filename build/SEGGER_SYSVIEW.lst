  49:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
  50:./trace/SEGGER/SEGGER_SYSVIEW.c **** File    : SEGGER_SYSVIEW.c
  51:./trace/SEGGER/SEGGER_SYSVIEW.c **** Purpose : System visualization API implementation.
  52:./trace/SEGGER/SEGGER_SYSVIEW.c **** Revision: $Rev: 29105 $
  53:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
  54:./trace/SEGGER/SEGGER_SYSVIEW.c **** Additional information:
  55:./trace/SEGGER/SEGGER_SYSVIEW.c ****   Packet format:
  56:./trace/SEGGER/SEGGER_SYSVIEW.c ****     Packets with IDs 0..23 are standard packets with known structure.
  57:./trace/SEGGER/SEGGER_SYSVIEW.c ****     For efficiency, they do *NOT* contain a length field.
  58:./trace/SEGGER/SEGGER_SYSVIEW.c ****     <ID><Data><TimeStampDelta>
  59:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
  60:./trace/SEGGER/SEGGER_SYSVIEW.c ****     Packets with IDs 24..31 are standard packets with extendible
  61:./trace/SEGGER/SEGGER_SYSVIEW.c ****     structure and contain a length field.
  62:./trace/SEGGER/SEGGER_SYSVIEW.c ****     <ID><Lenght><Data><TimeStampDelta>
  63:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
  64:./trace/SEGGER/SEGGER_SYSVIEW.c ****     Packet ID 31 is used for SystemView extended events.
  65:./trace/SEGGER/SEGGER_SYSVIEW.c ****     <ID><Lenght><ID_EX><Data><TimeStampDelta>
  66:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
  67:./trace/SEGGER/SEGGER_SYSVIEW.c ****     Packets with IDs >= 32 always contain a length field.
  68:./trace/SEGGER/SEGGER_SYSVIEW.c ****     <ID><Length><Data><TimeStampDelta>
  69:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
  70:./trace/SEGGER/SEGGER_SYSVIEW.c ****   Packet IDs:
  71:./trace/SEGGER/SEGGER_SYSVIEW.c ****        0..  31 : Standard packets, known by SystemView.
  72:./trace/SEGGER/SEGGER_SYSVIEW.c ****       32..1023 : OS-definable packets, described in a SystemView description file.
  73:./trace/SEGGER/SEGGER_SYSVIEW.c ****     1024..2047 : User-definable packets, described in a SystemView description file.
  74:./trace/SEGGER/SEGGER_SYSVIEW.c ****     2048..32767: Undefined.
  75:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
  76:./trace/SEGGER/SEGGER_SYSVIEW.c ****   Data encoding:
  77:./trace/SEGGER/SEGGER_SYSVIEW.c ****     Basic types (int, short, char, ...):
  78:./trace/SEGGER/SEGGER_SYSVIEW.c ****       Basic types are encoded little endian with most-significant bit variant
  79:./trace/SEGGER/SEGGER_SYSVIEW.c ****       encoding.
  80:./trace/SEGGER/SEGGER_SYSVIEW.c ****       Each encoded byte contains 7 data bits [6:0] and the MSB continuation bit.
  81:./trace/SEGGER/SEGGER_SYSVIEW.c ****       The continuation bit indicates whether the next byte belongs to the data
  82:./trace/SEGGER/SEGGER_SYSVIEW.c ****       (bit set) or this is the last byte (bit clear).
  83:./trace/SEGGER/SEGGER_SYSVIEW.c ****       The most significant bits of data are encoded first, proceeding to the
  84:./trace/SEGGER/SEGGER_SYSVIEW.c ****       least significant bits in the final byte (little endian).
  85:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
  86:./trace/SEGGER/SEGGER_SYSVIEW.c ****       Example encoding:
  87:./trace/SEGGER/SEGGER_SYSVIEW.c ****         Data: 0x1F4 (500)
ARM GAS  /tmp/ccKdFIUT.s 			page 3


  88:./trace/SEGGER/SEGGER_SYSVIEW.c ****         Encoded: 0xF4 (First 7 data bits 74 | Continuation bit)
  89:./trace/SEGGER/SEGGER_SYSVIEW.c ****                  0x03 (Second 7 data bits 03, no continuation)
  90:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
  91:./trace/SEGGER/SEGGER_SYSVIEW.c ****         Data: 0xFFFFFFFF
  92:./trace/SEGGER/SEGGER_SYSVIEW.c ****         Encoded: 0xFF 0xFF 0xFF 0xFF 0x0F
  93:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
  94:./trace/SEGGER/SEGGER_SYSVIEW.c ****         Data: 0xA2 (162),   0x03 (3), 0x7000
  95:./trace/SEGGER/SEGGER_SYSVIEW.c ****         Encoded: 0xA2 0x01  0x03      0x80 0xE0 0x01
  96:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
  97:./trace/SEGGER/SEGGER_SYSVIEW.c ****     Byte arrays and strings:
  98:./trace/SEGGER/SEGGER_SYSVIEW.c ****       Byte arrays and strings are encoded as <NumBytes> followed by the raw data.
  99:./trace/SEGGER/SEGGER_SYSVIEW.c ****       NumBytes is encoded as a basic type with a theoretical maximum of 4G.
 100:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
 101:./trace/SEGGER/SEGGER_SYSVIEW.c ****       Example encoding:
 102:./trace/SEGGER/SEGGER_SYSVIEW.c ****         Data: "Hello World\0" (0x48 0x65 0x6C 0x6C 0x6F 0x20 0x57 0x6F 0x72 0x6C 0x64 0x00)
 103:./trace/SEGGER/SEGGER_SYSVIEW.c ****         Encoded: 0x0B 0x48 0x65 0x6C 0x6C 0x6F 0x20 0x57 0x6F 0x72 0x6C 0x64
 104:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
 105:./trace/SEGGER/SEGGER_SYSVIEW.c ****   Examples packets:
 106:./trace/SEGGER/SEGGER_SYSVIEW.c ****   01 F4 03 80 80 10 // Overflow packet. Data is a single U32.
 107:./trace/SEGGER/SEGGER_SYSVIEW.c ****                        This packet means: 500 packets lost, Timestamp is 0x40000
 108:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
 109:./trace/SEGGER/SEGGER_SYSVIEW.c ****   02 0F 50          // ISR(15) Enter. Timestamp 80 (0x50)
 110:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
 111:./trace/SEGGER/SEGGER_SYSVIEW.c ****   03 20             // ISR Exit. Timestamp 32 (0x20) (Shortest possible packet.)
 112:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
 113:./trace/SEGGER/SEGGER_SYSVIEW.c ****   Sample code for user defined Packets:
 114:./trace/SEGGER/SEGGER_SYSVIEW.c ****     #define MY_ID   0x400                // Any value between 0x400 and 0x7FF
 115:./trace/SEGGER/SEGGER_SYSVIEW.c ****     void SendMyPacket(unsigned Para0, unsigned Para1, const char* s) {
 116:./trace/SEGGER/SEGGER_SYSVIEW.c ****       U8  aPacket[SEGGER_SYSVIEW_INFO_SIZE + 2 * SEGGER_SYSVIEW_QUANTA_U32 + MAX_STR_LEN + 1];
 117:./trace/SEGGER/SEGGER_SYSVIEW.c ****       U8* pPayload;
 118:./trace/SEGGER/SEGGER_SYSVIEW.c ****       //
 119:./trace/SEGGER/SEGGER_SYSVIEW.c ****       pPayload = SEGGER_SYSVIEW_PPREPARE_PACKET(aPacket);               // Prepare the packet for S
 120:./trace/SEGGER/SEGGER_SYSVIEW.c ****       pPayload = SEGGER_SYSVIEW_EncodeU32(pPayload, Para0);             // Add the first parameter 
 121:./trace/SEGGER/SEGGER_SYSVIEW.c ****       pPayload = SEGGER_SYSVIEW_EncodeU32(pPayload, Para1);             // Add the second parameter
 122:./trace/SEGGER/SEGGER_SYSVIEW.c ****       pPayload = SEGGER_SYSVIEW_EncodeString(pPayload, s, MAX_STR_LEN); // Add the string to the pa
 123:./trace/SEGGER/SEGGER_SYSVIEW.c ****       //
 124:./trace/SEGGER/SEGGER_SYSVIEW.c ****       SEGGER_SYSVIEW_SendPacket(&aPacket[0], pPayload, MY_ID);          // Send the packet with Eve
 125:./trace/SEGGER/SEGGER_SYSVIEW.c ****     }
 126:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
 127:./trace/SEGGER/SEGGER_SYSVIEW.c ****     #define MY_ID_1 0x401
 128:./trace/SEGGER/SEGGER_SYSVIEW.c ****     void SendOnePara(unsigned Para0) {
 129:./trace/SEGGER/SEGGER_SYSVIEW.c ****       SEGGER_SYSVIEW_RecordU32(MY_ID_1, Para0);
 130:./trace/SEGGER/SEGGER_SYSVIEW.c ****     }
 131:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
 132:./trace/SEGGER/SEGGER_SYSVIEW.c **** */
 133:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
 134:./trace/SEGGER/SEGGER_SYSVIEW.c **** /*********************************************************************
 135:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
 136:./trace/SEGGER/SEGGER_SYSVIEW.c **** *       #include section
 137:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
 138:./trace/SEGGER/SEGGER_SYSVIEW.c **** **********************************************************************
 139:./trace/SEGGER/SEGGER_SYSVIEW.c **** */
 140:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
