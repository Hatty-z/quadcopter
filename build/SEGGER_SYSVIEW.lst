 216:./trace/SEGGER/SEGGER_SYSVIEW.c **** #define FORMAT_FLAG_PAD_ZERO       (1u << 1)
 217:./trace/SEGGER/SEGGER_SYSVIEW.c **** #define FORMAT_FLAG_PRINT_SIGN     (1u << 2)
 218:./trace/SEGGER/SEGGER_SYSVIEW.c **** #define FORMAT_FLAG_ALTERNATE      (1u << 3)
 219:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
