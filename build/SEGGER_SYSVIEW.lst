1882:./trace/SEGGER/SEGGER_SYSVIEW.c ****       ENCODE_U32(pPayload, SEGGER_SYSVIEW_ID_SHIFT);
1883:./trace/SEGGER/SEGGER_SYSVIEW.c ****       _SendPacket(pPayloadStart, pPayload, SYSVIEW_EVTID_INIT);
1884:./trace/SEGGER/SEGGER_SYSVIEW.c ****       RECORD_END();
1885:./trace/SEGGER/SEGGER_SYSVIEW.c ****     }
1886:./trace/SEGGER/SEGGER_SYSVIEW.c ****     if (_SYSVIEW_Globals.pfSendSysDesc) {
