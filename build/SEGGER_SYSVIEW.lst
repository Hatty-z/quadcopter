2676:./trace/SEGGER/SEGGER_SYSVIEW.c **** /*********************************************************************
2677:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2678:./trace/SEGGER/SEGGER_SYSVIEW.c **** *       SEGGER_SYSVIEW_HeapAllocEx()
2679:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2680:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Function description
2681:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Record a per-heap allocation event.
2682:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2683:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Parameters
2684:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    pHeap       - Pointer to heap where allocation was made.
2685:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    pUserData   - Pointer to allocated user data.
2686:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    UserDataLen - Size of block allocated to hold user data, excluding any metadata.
2687:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Tag         - Block tag, typically used to identify the owner of the block.
2688:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2689:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Additional information
2690:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    The user data must be correctly aligned for the architecture, which
2691:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    typically requires that the alignment is at least the alignment
2692:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    of a double or a long long.  pUserData is, therefore, compressed by
2693:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    shrinking as IDs are compressed, controlled by the specific setting
2694:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    of SEGGER_SYSVIEW_ID_SHIFT.
2695:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2696:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    In the same way, UserDataLen must reflect the size of the allocated
2697:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    block, not the allocation size requested by the application.  This
2698:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    size is also subject to compression, controlled by the specific setting
2699:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    of SEGGER_SYSVIEW_ID_SHIFT.
2700:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2701:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    As an example, assume the allocator is running on a Cortex-M device
2702:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    with SEGGER_SYSVIEW_ID_SHIFT set to 2 (the word alignment of the device).
2703:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    If a user requests an allocation of 5 bytes, a hypothetical heap
2704:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    allocator could allocate a block with size 32 bytes for this.  The value
2705:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    of UserDataLen sent to SystemView for recording should be 32, not 5,
2706:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    and the 32 is compressed by shifting by two bits, the configured value
ARM GAS  /tmp/ccKdFIUT.s 			page 64


2707:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    of SEGGER_SYSVIEW_ID_SHIFT, and describes the number of bytes that are
2708:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    consumed from managed memory from which SystemView can calculate
2709:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    accurate heap metrics.
2710:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2711:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  See also
2712:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    SEGGER_SYSVIEW_HeapAlloc().
2713:./trace/SEGGER/SEGGER_SYSVIEW.c **** */
2714:./trace/SEGGER/SEGGER_SYSVIEW.c **** void SEGGER_SYSVIEW_HeapAllocEx(void *pHeap, void* pUserData, unsigned int UserDataLen, unsigned in
2715:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U8* pPayload;
2716:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U8* pPayloadStart;
2717:./trace/SEGGER/SEGGER_SYSVIEW.c ****   RECORD_START(SEGGER_SYSVIEW_INFO_SIZE + 5 * SEGGER_SYSVIEW_QUANTA_U32);
2718:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
2719:./trace/SEGGER/SEGGER_SYSVIEW.c ****   pPayload = pPayloadStart;
2720:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SYSVIEW_EVTID_EX_HEAP_ALLOC_EX);
2721:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SHRINK_ID((U32)pHeap));
2722:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SHRINK_ID((U32)pUserData));
2723:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, UserDataLen >> SEGGER_SYSVIEW_ID_SHIFT);
2724:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, Tag);
2725:./trace/SEGGER/SEGGER_SYSVIEW.c ****   _SendPacket(pPayloadStart, pPayload, SYSVIEW_EVTID_EX);
2726:./trace/SEGGER/SEGGER_SYSVIEW.c ****   RECORD_END();
2727:./trace/SEGGER/SEGGER_SYSVIEW.c **** }
2728:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
2729:./trace/SEGGER/SEGGER_SYSVIEW.c **** /*********************************************************************
2730:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2731:./trace/SEGGER/SEGGER_SYSVIEW.c **** *       SEGGER_SYSVIEW_HeapFree()
2732:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2733:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Function description
2734:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Record a heap deallocation event.
2735:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2736:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Parameters
2737:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    pHeap     - Pointer to heap where allocation was made.
2738:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    pUserData - Pointer to allocated user data.
2739:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2740:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Additional information
2741:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    SystemViews track allocations and knows the size of the
2742:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    allocated data.
2743:./trace/SEGGER/SEGGER_SYSVIEW.c **** */
2744:./trace/SEGGER/SEGGER_SYSVIEW.c **** void SEGGER_SYSVIEW_HeapFree(void* pHeap, void* pUserData) {
2745:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U8* pPayload;
2746:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U8* pPayloadStart;
2747:./trace/SEGGER/SEGGER_SYSVIEW.c ****   RECORD_START(SEGGER_SYSVIEW_INFO_SIZE + 2 * SEGGER_SYSVIEW_QUANTA_U32);
2748:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
2749:./trace/SEGGER/SEGGER_SYSVIEW.c ****   pPayload = pPayloadStart;
2750:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SYSVIEW_EVTID_EX_HEAP_FREE);
2751:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SHRINK_ID((U32)pHeap));
2752:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SHRINK_ID((U32)pUserData));
2753:./trace/SEGGER/SEGGER_SYSVIEW.c ****   _SendPacket(pPayloadStart, pPayload, SYSVIEW_EVTID_EX);
2754:./trace/SEGGER/SEGGER_SYSVIEW.c ****   RECORD_END();
2755:./trace/SEGGER/SEGGER_SYSVIEW.c **** }
