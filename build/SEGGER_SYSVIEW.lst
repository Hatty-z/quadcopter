1034:./trace/SEGGER/SEGGER_SYSVIEW.c **** static void _StoreChar(SEGGER_SYSVIEW_PRINTF_DESC * p, char c) {
1035:./trace/SEGGER/SEGGER_SYSVIEW.c ****   unsigned int  Cnt;
1036:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U8*           pPayload;
1037:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U32           Options;
1038:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
1039:./trace/SEGGER/SEGGER_SYSVIEW.c ****   Cnt = p->Cnt;
1040:./trace/SEGGER/SEGGER_SYSVIEW.c ****   if ((Cnt + 1u) <= SEGGER_SYSVIEW_MAX_STRING_LEN) {
1041:./trace/SEGGER/SEGGER_SYSVIEW.c ****     *(p->pPayload++) = (U8)c;
1042:./trace/SEGGER/SEGGER_SYSVIEW.c ****     p->Cnt = Cnt + 1u;
1043:./trace/SEGGER/SEGGER_SYSVIEW.c ****   }
1044:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
1045:./trace/SEGGER/SEGGER_SYSVIEW.c ****   // Write part of string, when the buffer is full
1046:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
1047:./trace/SEGGER/SEGGER_SYSVIEW.c ****   if (p->Cnt == SEGGER_SYSVIEW_MAX_STRING_LEN) {
1048:./trace/SEGGER/SEGGER_SYSVIEW.c ****     *(p->pPayloadStart) = (U8)p->Cnt;
1049:./trace/SEGGER/SEGGER_SYSVIEW.c ****     pPayload = p->pPayload;
1050:./trace/SEGGER/SEGGER_SYSVIEW.c ****     Options = p->Options;
1051:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, Options);
1052:./trace/SEGGER/SEGGER_SYSVIEW.c ****     ENCODE_U32(pPayload, 0);
1053:./trace/SEGGER/SEGGER_SYSVIEW.c ****     _SendPacket(p->pPayloadStart, pPayload, SYSVIEW_EVTID_PRINT_FORMATTED);
1054:./trace/SEGGER/SEGGER_SYSVIEW.c ****     p->pPayloadStart = _PreparePacket(p->pBuffer);
1055:./trace/SEGGER/SEGGER_SYSVIEW.c ****     p->pPayload = p->pPayloadStart + 1u;
1056:./trace/SEGGER/SEGGER_SYSVIEW.c ****     p->Cnt = 0u;
1057:./trace/SEGGER/SEGGER_SYSVIEW.c ****   }
1058:./trace/SEGGER/SEGGER_SYSVIEW.c **** }
