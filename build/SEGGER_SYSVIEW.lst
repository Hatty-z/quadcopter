2585:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2586:./trace/SEGGER/SEGGER_SYSVIEW.c **** *       SEGGER_SYSVIEW_HeapDefine()
2587:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2588:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Function description
2589:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Define heap.
2590:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2591:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Parameters
2592:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    pHeap        - Pointer to heap control structure.
ARM GAS  /tmp/ccKdFIUT.s 			page 62


2593:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    pBase        - Pointer to managed heap memory.
2594:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    HeapSize     - Size of managed heap memory in bytes.
2595:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    MetadataSize - Size of metadata associated with each heap allocation.
2596:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2597:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Additional information
2598:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    SystemView can track allocations across multiple heaps.
2599:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2600:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    HeapSize must be a multiple of the natural alignment unit of the
2601:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    target.  This size is subject to compression, controlled by the
2602:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    specific setting of SEGGER_SYSVIEW_ID_SHIFT.
2603:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2604:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    MetadataSize defines the size of the per-allocation metadata.
2605:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    For many heap implementations, the metadata size is a multiple of
2606:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    the word size of the machine and typically contains the size
2607:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    of the allocated block (used upon deallocation), optional
2608:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    pointers to the preceding and/or following blocks, and optionally
2609:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    a tag identifying the owner of the block.  Note that MetadataSize
2610:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    is not compressed within the SystemView packet and is not
2611:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    required to be a multiple of 1<<SEGGER_SYSVIEW_ID_SHIFT.
2612:./trace/SEGGER/SEGGER_SYSVIEW.c **** */
2613:./trace/SEGGER/SEGGER_SYSVIEW.c **** void SEGGER_SYSVIEW_HeapDefine(void* pHeap, void *pBase, unsigned int HeapSize, unsigned int Metada
2614:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U8* pPayload;
2615:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U8* pPayloadStart;
2616:./trace/SEGGER/SEGGER_SYSVIEW.c ****   RECORD_START(SEGGER_SYSVIEW_INFO_SIZE + 4 * SEGGER_SYSVIEW_QUANTA_U32);
2617:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
2618:./trace/SEGGER/SEGGER_SYSVIEW.c ****   pPayload = pPayloadStart;
2619:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SYSVIEW_EVTID_EX_HEAP_DEFINE);
2620:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SHRINK_ID((U32)pHeap));
2621:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SHRINK_ID((U32)pBase));
2622:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, HeapSize >> SEGGER_SYSVIEW_ID_SHIFT);
2623:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, MetadataSize);
2624:./trace/SEGGER/SEGGER_SYSVIEW.c ****   _SendPacket(pPayloadStart, pPayload, SYSVIEW_EVTID_EX);
2625:./trace/SEGGER/SEGGER_SYSVIEW.c ****   RECORD_END();
2626:./trace/SEGGER/SEGGER_SYSVIEW.c **** }
2627:./trace/SEGGER/SEGGER_SYSVIEW.c **** 
2628:./trace/SEGGER/SEGGER_SYSVIEW.c **** /*********************************************************************
2629:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2630:./trace/SEGGER/SEGGER_SYSVIEW.c **** *       SEGGER_SYSVIEW_HeapAlloc()
2631:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2632:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Function description
2633:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Record a system-heap allocation event.
2634:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2635:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Parameters
2636:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    pHeap       - Pointer to heap where allocation was made.
2637:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    pUserData   - Pointer to allocated user data.
2638:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    UserDataLen - Size of block allocated to hold user data, excluding any metadata.
2639:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2640:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Additional information
2641:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    The user data must be correctly aligned for the architecture, which
2642:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    typically requires that the alignment is at least the alignment
2643:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    of a double or a long long.  pUserData is, therefore, compressed by
2644:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    shrinking as IDs are compressed, controlled by the specific setting
2645:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    of SEGGER_SYSVIEW_ID_SHIFT.
2646:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2647:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    In the same way, UserDataLen must reflect the size of the allocated
2648:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    block, not the allocation size requested by the application.  This
2649:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    size is also subject to compression, controlled by the specific setting
ARM GAS  /tmp/ccKdFIUT.s 			page 63


2650:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    of SEGGER_SYSVIEW_ID_SHIFT.
2651:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2652:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    As an example, assume the allocator is running on a Cortex-M device
2653:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    with SEGGER_SYSVIEW_ID_SHIFT set to 2 (the word alignment of the device).
2654:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    If a user requests an allocation of 5 bytes, a hypothetical heap
2655:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    allocator could allocate a block with size 32 bytes for this.  The value
2656:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    of UserDataLen sent to SystemView for recording should be 32, not 5,
2657:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    and the 32 is compressed by shifting by two bits, the configured value
2658:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    of SEGGER_SYSVIEW_ID_SHIFT, and describes the number of bytes that are
2659:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    consumed from managed memory from which SystemView can calculate
2660:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    accurate heap metrics.
2661:./trace/SEGGER/SEGGER_SYSVIEW.c **** */
2662:./trace/SEGGER/SEGGER_SYSVIEW.c **** void SEGGER_SYSVIEW_HeapAlloc(void *pHeap, void* pUserData, unsigned int UserDataLen) {
2663:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U8* pPayload;
2664:./trace/SEGGER/SEGGER_SYSVIEW.c ****   U8* pPayloadStart;
2665:./trace/SEGGER/SEGGER_SYSVIEW.c ****   RECORD_START(SEGGER_SYSVIEW_INFO_SIZE + 3 * SEGGER_SYSVIEW_QUANTA_U32);
2666:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
2667:./trace/SEGGER/SEGGER_SYSVIEW.c ****   pPayload = pPayloadStart;
2668:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SYSVIEW_EVTID_EX_HEAP_ALLOC);
2669:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SHRINK_ID((U32)pHeap));
2670:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, SHRINK_ID((U32)pUserData));
2671:./trace/SEGGER/SEGGER_SYSVIEW.c ****   ENCODE_U32(pPayload, UserDataLen >> SEGGER_SYSVIEW_ID_SHIFT);
2672:./trace/SEGGER/SEGGER_SYSVIEW.c ****   _SendPacket(pPayloadStart, pPayload, SYSVIEW_EVTID_EX);
2673:./trace/SEGGER/SEGGER_SYSVIEW.c ****   RECORD_END();
2674:./trace/SEGGER/SEGGER_SYSVIEW.c **** }
