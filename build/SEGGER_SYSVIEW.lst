1827:./trace/SEGGER/SEGGER_SYSVIEW.c ****   RECORD_START(SEGGER_SYSVIEW_INFO_SIZE + 1 + SEGGER_SYSVIEW_MAX_STRING_LEN);
1828:./trace/SEGGER/SEGGER_SYSVIEW.c ****   //
1829:./trace/SEGGER/SEGGER_SYSVIEW.c ****   pPayload = _EncodeStr(pPayloadStart, pString, SEGGER_SYSVIEW_MAX_STRING_LEN);
1830:./trace/SEGGER/SEGGER_SYSVIEW.c ****   _SendPacket(pPayloadStart, pPayload, EventID);
1831:./trace/SEGGER/SEGGER_SYSVIEW.c ****   RECORD_END();
1832:./trace/SEGGER/SEGGER_SYSVIEW.c **** }
