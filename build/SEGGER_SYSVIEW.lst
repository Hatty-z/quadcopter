1836:./trace/SEGGER/SEGGER_SYSVIEW.c **** *       SEGGER_SYSVIEW_Start()
1837:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
1838:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Function description
ARM GAS  /tmp/ccKdFIUT.s 			page 44


1839:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Start recording SystemView events.
1840:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
1841:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    This function is triggered by the SystemView Application on connect.
1842:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    For single-shot or post-mortem mode recording, it needs to be called
1843:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    by the application.
1844:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
1845:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Additional information
1846:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    This function enables transmission of SystemView packets recorded
1847:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    by subsequent trace calls and records a SystemView Start event.
1848:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
1849:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    As part of start, a SystemView Init packet is sent, containing the system
1850:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    frequency. The list of current tasks, the current system time and the
1851:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    system description string is sent, too.
1852:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
1853:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Notes
1854:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    SEGGER_SYSVIEW_Start and SEGGER_SYSVIEW_Stop do not nest.
1855:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    When SEGGER_SYSVIEW_CAN_RESTART is 1, each received start command
1856:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    records the system information. This is required to enable restart
1857:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    of recordings when SystemView unexpectedly disconnects without sending
1858:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    a stop command before.
1859:./trace/SEGGER/SEGGER_SYSVIEW.c **** */
1860:./trace/SEGGER/SEGGER_SYSVIEW.c **** void SEGGER_SYSVIEW_Start(void) {
1861:./trace/SEGGER/SEGGER_SYSVIEW.c **** #if (SEGGER_SYSVIEW_CAN_RESTART == 0)
1862:./trace/SEGGER/SEGGER_SYSVIEW.c ****   if (_SYSVIEW_Globals.EnableState == 0) {
1863:./trace/SEGGER/SEGGER_SYSVIEW.c **** #endif
1864:./trace/SEGGER/SEGGER_SYSVIEW.c ****     _SYSVIEW_Globals.EnableState = 1;
1865:./trace/SEGGER/SEGGER_SYSVIEW.c **** #if (SEGGER_SYSVIEW_POST_MORTEM_MODE == 1)
1866:./trace/SEGGER/SEGGER_SYSVIEW.c ****     _SendSyncInfo();
1867:./trace/SEGGER/SEGGER_SYSVIEW.c **** #else
1868:./trace/SEGGER/SEGGER_SYSVIEW.c ****     SEGGER_SYSVIEW_LOCK();
1869:./trace/SEGGER/SEGGER_SYSVIEW.c ****     SEGGER_RTT_WriteSkipNoLock(CHANNEL_ID_UP, _abSync, 10);
1870:./trace/SEGGER/SEGGER_SYSVIEW.c ****     SEGGER_SYSVIEW_UNLOCK();
1871:./trace/SEGGER/SEGGER_SYSVIEW.c ****     SEGGER_SYSVIEW_ON_EVENT_RECORDED(10);
1872:./trace/SEGGER/SEGGER_SYSVIEW.c ****     SEGGER_SYSVIEW_RecordVoid(SYSVIEW_EVTID_TRACE_START);
1873:./trace/SEGGER/SEGGER_SYSVIEW.c ****     {
1874:./trace/SEGGER/SEGGER_SYSVIEW.c ****       U8* pPayload;
1875:./trace/SEGGER/SEGGER_SYSVIEW.c ****       U8* pPayloadStart;
1876:./trace/SEGGER/SEGGER_SYSVIEW.c ****       RECORD_START(SEGGER_SYSVIEW_INFO_SIZE + 4 * SEGGER_SYSVIEW_QUANTA_U32);
1877:./trace/SEGGER/SEGGER_SYSVIEW.c ****       //
1878:./trace/SEGGER/SEGGER_SYSVIEW.c ****       pPayload = pPayloadStart;
1879:./trace/SEGGER/SEGGER_SYSVIEW.c ****       ENCODE_U32(pPayload, _SYSVIEW_Globals.SysFreq);
1880:./trace/SEGGER/SEGGER_SYSVIEW.c ****       ENCODE_U32(pPayload, _SYSVIEW_Globals.CPUFreq);
