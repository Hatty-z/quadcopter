2057:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2058:./trace/SEGGER/SEGGER_SYSVIEW.c **** *       SEGGER_SYSVIEW_SendSysDesc()
2059:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2060:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Function description
2061:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Send the system description string to the host.
2062:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    The system description is used by the SystemView Application
2063:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    to identify the current application and handle events accordingly.
2064:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2065:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    The system description is usually called by the system description
2066:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    callback, to ensure it is only sent when the SystemView Application
2067:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    is connected.
2068:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2069:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Parameters
2070:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    sSysDesc - Pointer to the 0-terminated system description string.
2071:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2072:./trace/SEGGER/SEGGER_SYSVIEW.c **** *  Additional information
2073:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    One system description string may not exceed SEGGER_SYSVIEW_MAX_STRING_LEN characters.
2074:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Multiple description strings can be recorded.
2075:./trace/SEGGER/SEGGER_SYSVIEW.c **** *
2076:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    The Following items can be described in a system description string.
2077:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Each item is identified by its identifier, followed by '=' and the value.
2078:./trace/SEGGER/SEGGER_SYSVIEW.c **** *    Items are separated by ','.
2079:./trace/SEGGER/SEGGER_SYSVIEW.c **** */
ARM GAS  /tmp/ccKdFIUT.s 			page 53


2080:./trace/SEGGER/SEGGER_SYSVIEW.c **** void SEGGER_SYSVIEW_SendSysDesc(const char *sSysDesc) {
