 852:./Libraries/src/stm32f4xx_dma.c **** /** @defgroup DMA_Group4 Interrupts and flags management functions
 853:./Libraries/src/stm32f4xx_dma.c ****  *  @brief   Interrupts and flags management functions 
 854:./Libraries/src/stm32f4xx_dma.c ****  *
 855:./Libraries/src/stm32f4xx_dma.c **** @verbatim   
 856:./Libraries/src/stm32f4xx_dma.c ****  ===============================================================================
 857:./Libraries/src/stm32f4xx_dma.c ****               ##### Interrupts and flags management functions #####
 858:./Libraries/src/stm32f4xx_dma.c ****  ===============================================================================  
 859:./Libraries/src/stm32f4xx_dma.c ****     [..]
 860:./Libraries/src/stm32f4xx_dma.c ****     This subsection provides functions allowing to
 861:./Libraries/src/stm32f4xx_dma.c ****       (+) Check the DMA enable status
 862:./Libraries/src/stm32f4xx_dma.c ****       (+) Check the FIFO status 
 863:./Libraries/src/stm32f4xx_dma.c ****       (+) Configure the DMA Interrupts sources and check or clear the flags or 
 864:./Libraries/src/stm32f4xx_dma.c ****           pending bits status.  
 865:./Libraries/src/stm32f4xx_dma.c ****            
 866:./Libraries/src/stm32f4xx_dma.c ****     [..]
 867:./Libraries/src/stm32f4xx_dma.c ****       (#) DMA Enable status:
 868:./Libraries/src/stm32f4xx_dma.c ****           After configuring the DMA Stream (DMA_Init() function) and enabling 
 869:./Libraries/src/stm32f4xx_dma.c ****           the stream, it is recommended to check (or wait until) the DMA Stream 
 870:./Libraries/src/stm32f4xx_dma.c ****           is effectively enabled. A Stream may remain disabled if a configuration 
 871:./Libraries/src/stm32f4xx_dma.c ****           parameter is wrong. After disabling a DMA Stream, it is also recommended 
 872:./Libraries/src/stm32f4xx_dma.c ****           to check (or wait until) the DMA Stream is effectively disabled. 
 873:./Libraries/src/stm32f4xx_dma.c ****           If a Stream is disabled while a data transfer is ongoing, the current 
 874:./Libraries/src/stm32f4xx_dma.c ****           data will be transferred and the Stream will be effectively disabled 
 875:./Libraries/src/stm32f4xx_dma.c ****           only after this data transfer completion.
 876:./Libraries/src/stm32f4xx_dma.c ****           To monitor this state it is possible to use the following function:
 877:./Libraries/src/stm32f4xx_dma.c ****         (++) FunctionalState DMA_GetCmdStatus(DMA_Stream_TypeDef* DMAy_Streamx); 
 878:./Libraries/src/stm32f4xx_dma.c ****  
 879:./Libraries/src/stm32f4xx_dma.c ****       (#) FIFO Status:
 880:./Libraries/src/stm32f4xx_dma.c ****           It is possible to monitor the FIFO status when a transfer is ongoing 
 881:./Libraries/src/stm32f4xx_dma.c ****           using the following function:
 882:./Libraries/src/stm32f4xx_dma.c ****         (++) uint32_t DMA_GetFIFOStatus(DMA_Stream_TypeDef* DMAy_Streamx); 
 883:./Libraries/src/stm32f4xx_dma.c ****  
 884:./Libraries/src/stm32f4xx_dma.c ****       (#) DMA Interrupts and Flags:
 885:./Libraries/src/stm32f4xx_dma.c ****           The user should identify which mode will be used in his application 
 886:./Libraries/src/stm32f4xx_dma.c ****           to manage the DMA controller events: Polling mode or Interrupt mode. 
 887:./Libraries/src/stm32f4xx_dma.c ****     
 888:./Libraries/src/stm32f4xx_dma.c ****     *** Polling Mode ***
 889:./Libraries/src/stm32f4xx_dma.c ****     ====================
 890:./Libraries/src/stm32f4xx_dma.c ****     [..]
 891:./Libraries/src/stm32f4xx_dma.c ****     Each DMA stream can be managed through 4 event Flags:
 892:./Libraries/src/stm32f4xx_dma.c ****     (x : DMA Stream number )
 893:./Libraries/src/stm32f4xx_dma.c ****       (#) DMA_FLAG_FEIFx  : to indicate that a FIFO Mode Transfer Error event occurred.
 894:./Libraries/src/stm32f4xx_dma.c ****       (#) DMA_FLAG_DMEIFx : to indicate that a Direct Mode Transfer Error event occurred.
ARM GAS  /tmp/ccx7iGzk.s 			page 31


 895:./Libraries/src/stm32f4xx_dma.c ****       (#) DMA_FLAG_TEIFx  : to indicate that a Transfer Error event occurred.
 896:./Libraries/src/stm32f4xx_dma.c ****       (#) DMA_FLAG_HTIFx  : to indicate that a Half-Transfer Complete event occurred.
 897:./Libraries/src/stm32f4xx_dma.c ****       (#) DMA_FLAG_TCIFx  : to indicate that a Transfer Complete event occurred .       
 898:./Libraries/src/stm32f4xx_dma.c ****     [..]
 899:./Libraries/src/stm32f4xx_dma.c ****     In this Mode it is advised to use the following functions:
 900:./Libraries/src/stm32f4xx_dma.c ****       (+) FlagStatus DMA_GetFlagStatus(DMA_Stream_TypeDef* DMAy_Streamx, uint32_t DMA_FLAG);
 901:./Libraries/src/stm32f4xx_dma.c ****       (+) void DMA_ClearFlag(DMA_Stream_TypeDef* DMAy_Streamx, uint32_t DMA_FLAG);
 902:./Libraries/src/stm32f4xx_dma.c **** 
 903:./Libraries/src/stm32f4xx_dma.c ****     *** Interrupt Mode ***
 904:./Libraries/src/stm32f4xx_dma.c ****     ======================
 905:./Libraries/src/stm32f4xx_dma.c ****     [..]
 906:./Libraries/src/stm32f4xx_dma.c ****     Each DMA Stream can be managed through 4 Interrupts:
 907:./Libraries/src/stm32f4xx_dma.c **** 
 908:./Libraries/src/stm32f4xx_dma.c ****     *** Interrupt Source ***
 909:./Libraries/src/stm32f4xx_dma.c ****     ========================
 910:./Libraries/src/stm32f4xx_dma.c ****     [..]
 911:./Libraries/src/stm32f4xx_dma.c ****       (#) DMA_IT_FEIFx  : specifies the interrupt source for the  FIFO Mode Transfer Error event.
 912:./Libraries/src/stm32f4xx_dma.c ****       (#) DMA_IT_DMEIFx : specifies the interrupt source for the Direct Mode Transfer Error event.
 913:./Libraries/src/stm32f4xx_dma.c ****       (#) DMA_IT_TEIFx  : specifies the interrupt source for the Transfer Error event.
 914:./Libraries/src/stm32f4xx_dma.c ****       (#) DMA_IT_HTIFx  : specifies the interrupt source for the Half-Transfer Complete event.
 915:./Libraries/src/stm32f4xx_dma.c ****       (#) DMA_IT_TCIFx  : specifies the interrupt source for the a Transfer Complete event. 
 916:./Libraries/src/stm32f4xx_dma.c ****     [..]
 917:./Libraries/src/stm32f4xx_dma.c ****     In this Mode it is advised to use the following functions:
 918:./Libraries/src/stm32f4xx_dma.c ****       (+) void DMA_ITConfig(DMA_Stream_TypeDef* DMAy_Streamx, uint32_t DMA_IT, FunctionalState NewS
 919:./Libraries/src/stm32f4xx_dma.c ****       (+) ITStatus DMA_GetITStatus(DMA_Stream_TypeDef* DMAy_Streamx, uint32_t DMA_IT);
 920:./Libraries/src/stm32f4xx_dma.c ****       (+) void DMA_ClearITPendingBit(DMA_Stream_TypeDef* DMAy_Streamx, uint32_t DMA_IT);
 921:./Libraries/src/stm32f4xx_dma.c **** 
 922:./Libraries/src/stm32f4xx_dma.c **** @endverbatim
 923:./Libraries/src/stm32f4xx_dma.c ****   * @{
 924:./Libraries/src/stm32f4xx_dma.c ****   */
 925:./Libraries/src/stm32f4xx_dma.c **** 
