 659:./Libraries/src/stm32f4xx_dma.c **** /** @defgroup DMA_Group3 Double Buffer mode functions
 660:./Libraries/src/stm32f4xx_dma.c ****  *  @brief   Double Buffer mode functions 
 661:./Libraries/src/stm32f4xx_dma.c ****  *
 662:./Libraries/src/stm32f4xx_dma.c **** @verbatim   
 663:./Libraries/src/stm32f4xx_dma.c ****  ===============================================================================
 664:./Libraries/src/stm32f4xx_dma.c ****                     ##### Double Buffer mode functions #####
 665:./Libraries/src/stm32f4xx_dma.c ****  ===============================================================================  
 666:./Libraries/src/stm32f4xx_dma.c ****     [..]
 667:./Libraries/src/stm32f4xx_dma.c ****     This subsection provides function allowing to configure and control the double 
 668:./Libraries/src/stm32f4xx_dma.c ****     buffer mode parameters.
 669:./Libraries/src/stm32f4xx_dma.c ****     
 670:./Libraries/src/stm32f4xx_dma.c ****     [..]
 671:./Libraries/src/stm32f4xx_dma.c ****     The Double Buffer mode can be used only when Circular mode is enabled.
 672:./Libraries/src/stm32f4xx_dma.c ****     The Double Buffer mode cannot be used when transferring data from Memory to Memory.
 673:./Libraries/src/stm32f4xx_dma.c ****     
 674:./Libraries/src/stm32f4xx_dma.c ****     [..]
 675:./Libraries/src/stm32f4xx_dma.c ****     The Double Buffer mode allows to set two different Memory addresses from/to which
 676:./Libraries/src/stm32f4xx_dma.c ****     the DMA controller will access alternatively (after completing transfer to/from 
 677:./Libraries/src/stm32f4xx_dma.c ****     target memory 0, it will start transfer to/from target memory 1).
 678:./Libraries/src/stm32f4xx_dma.c ****     This allows to reduce software overhead for double buffering and reduce the CPU
 679:./Libraries/src/stm32f4xx_dma.c ****     access time.
 680:./Libraries/src/stm32f4xx_dma.c ****     
 681:./Libraries/src/stm32f4xx_dma.c ****     [..]
 682:./Libraries/src/stm32f4xx_dma.c ****     Two functions must be called before calling the DMA_Init() function:
 683:./Libraries/src/stm32f4xx_dma.c ****       (+) void DMA_DoubleBufferModeConfig(DMA_Stream_TypeDef* DMAy_Streamx, 
 684:./Libraries/src/stm32f4xx_dma.c ****           uint32_t Memory1BaseAddr, uint32_t DMA_CurrentMemory);
 685:./Libraries/src/stm32f4xx_dma.c ****       (+) void DMA_DoubleBufferModeCmd(DMA_Stream_TypeDef* DMAy_Streamx, FunctionalState NewState);
 686:./Libraries/src/stm32f4xx_dma.c ****       
 687:./Libraries/src/stm32f4xx_dma.c ****     [..]
 688:./Libraries/src/stm32f4xx_dma.c ****     DMA_DoubleBufferModeConfig() is called to configure the Memory 1 base address 
 689:./Libraries/src/stm32f4xx_dma.c ****     and the first Memory target from/to which the transfer will start after 
 690:./Libraries/src/stm32f4xx_dma.c ****     enabling the DMA Stream. Then DMA_DoubleBufferModeCmd() must be called 
 691:./Libraries/src/stm32f4xx_dma.c ****     to enable the Double Buffer mode (or disable it when it should not be used).
 692:./Libraries/src/stm32f4xx_dma.c ****   
 693:./Libraries/src/stm32f4xx_dma.c ****     [..]
 694:./Libraries/src/stm32f4xx_dma.c ****     Two functions can be called dynamically when the transfer is ongoing (or when the DMA Stream is
 695:./Libraries/src/stm32f4xx_dma.c ****     stopped) to modify on of the target Memories addresses or to check which Memory target is curre
 696:./Libraries/src/stm32f4xx_dma.c ****     used:
ARM GAS  /tmp/ccx7iGzk.s 			page 25


 697:./Libraries/src/stm32f4xx_dma.c ****       (+) void DMA_MemoryTargetConfig(DMA_Stream_TypeDef* DMAy_Streamx, 
 698:./Libraries/src/stm32f4xx_dma.c ****                 uint32_t MemoryBaseAddr, uint32_t DMA_MemoryTarget);
 699:./Libraries/src/stm32f4xx_dma.c ****       (+) uint32_t DMA_GetCurrentMemoryTarget(DMA_Stream_TypeDef* DMAy_Streamx);
 700:./Libraries/src/stm32f4xx_dma.c ****       
 701:./Libraries/src/stm32f4xx_dma.c ****     [..]
 702:./Libraries/src/stm32f4xx_dma.c ****     DMA_MemoryTargetConfig() can be called to modify the base address of one of 
 703:./Libraries/src/stm32f4xx_dma.c ****     the two target Memories.
 704:./Libraries/src/stm32f4xx_dma.c ****     The Memory of which the base address will be modified must not be currently 
 705:./Libraries/src/stm32f4xx_dma.c ****     be used by the DMA Stream (ie. if the DMA Stream is currently transferring 
 706:./Libraries/src/stm32f4xx_dma.c ****     from Memory 1 then you can only modify base address of target Memory 0 and vice versa).
 707:./Libraries/src/stm32f4xx_dma.c ****     To check this condition, it is recommended to use the function DMA_GetCurrentMemoryTarget() whi
 708:./Libraries/src/stm32f4xx_dma.c ****     returns the index of the Memory target currently in use by the DMA Stream.
 709:./Libraries/src/stm32f4xx_dma.c **** 
 710:./Libraries/src/stm32f4xx_dma.c **** @endverbatim
 711:./Libraries/src/stm32f4xx_dma.c ****   * @{
 712:./Libraries/src/stm32f4xx_dma.c ****   */
