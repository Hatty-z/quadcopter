2028:./Libraries/src/stm32f4xx_rtc.c **** {
2029:./Libraries/src/stm32f4xx_rtc.c ****   uint32_t tmptime = 0, tmpdate = 0;
2030:./Libraries/src/stm32f4xx_rtc.c **** 
2031:./Libraries/src/stm32f4xx_rtc.c ****   /* Check the parameters */
2032:./Libraries/src/stm32f4xx_rtc.c ****   assert_param(IS_RTC_FORMAT(RTC_Format));
2033:./Libraries/src/stm32f4xx_rtc.c **** 
2034:./Libraries/src/stm32f4xx_rtc.c ****   /* Get the TimeStamp time and date registers values */
2035:./Libraries/src/stm32f4xx_rtc.c ****   tmptime = (uint32_t)(RTC->TSTR & RTC_TR_RESERVED_MASK);
2036:./Libraries/src/stm32f4xx_rtc.c ****   tmpdate = (uint32_t)(RTC->TSDR & RTC_DR_RESERVED_MASK);
2037:./Libraries/src/stm32f4xx_rtc.c **** 
2038:./Libraries/src/stm32f4xx_rtc.c ****   /* Fill the Time structure fields with the read parameters */
2039:./Libraries/src/stm32f4xx_rtc.c ****   RTC_StampTimeStruct->RTC_Hours = (uint8_t)((tmptime & (RTC_TR_HT | RTC_TR_HU)) >> 16);
2040:./Libraries/src/stm32f4xx_rtc.c ****   RTC_StampTimeStruct->RTC_Minutes = (uint8_t)((tmptime & (RTC_TR_MNT | RTC_TR_MNU)) >> 8);
2041:./Libraries/src/stm32f4xx_rtc.c ****   RTC_StampTimeStruct->RTC_Seconds = (uint8_t)(tmptime & (RTC_TR_ST | RTC_TR_SU));
2042:./Libraries/src/stm32f4xx_rtc.c ****   RTC_StampTimeStruct->RTC_H12 = (uint8_t)((tmptime & (RTC_TR_PM)) >> 16);  
2043:./Libraries/src/stm32f4xx_rtc.c **** 
2044:./Libraries/src/stm32f4xx_rtc.c ****   /* Fill the Date structure fields with the read parameters */
2045:./Libraries/src/stm32f4xx_rtc.c ****   RTC_StampDateStruct->RTC_Year = 0;
2046:./Libraries/src/stm32f4xx_rtc.c ****   RTC_StampDateStruct->RTC_Month = (uint8_t)((tmpdate & (RTC_DR_MT | RTC_DR_MU)) >> 8);
2047:./Libraries/src/stm32f4xx_rtc.c ****   RTC_StampDateStruct->RTC_Date = (uint8_t)(tmpdate & (RTC_DR_DT | RTC_DR_DU));
2048:./Libraries/src/stm32f4xx_rtc.c ****   RTC_StampDateStruct->RTC_WeekDay = (uint8_t)((tmpdate & (RTC_DR_WDU)) >> 13);
2049:./Libraries/src/stm32f4xx_rtc.c **** 
2050:./Libraries/src/stm32f4xx_rtc.c ****   /* Check the input parameters format */
2051:./Libraries/src/stm32f4xx_rtc.c ****   if (RTC_Format == RTC_Format_BIN)
2052:./Libraries/src/stm32f4xx_rtc.c ****   {
2053:./Libraries/src/stm32f4xx_rtc.c ****     /* Convert the Time structure parameters to Binary format */
2054:./Libraries/src/stm32f4xx_rtc.c ****     RTC_StampTimeStruct->RTC_Hours = (uint8_t)RTC_Bcd2ToByte(RTC_StampTimeStruct->RTC_Hours);
2055:./Libraries/src/stm32f4xx_rtc.c ****     RTC_StampTimeStruct->RTC_Minutes = (uint8_t)RTC_Bcd2ToByte(RTC_StampTimeStruct->RTC_Minutes);
2056:./Libraries/src/stm32f4xx_rtc.c ****     RTC_StampTimeStruct->RTC_Seconds = (uint8_t)RTC_Bcd2ToByte(RTC_StampTimeStruct->RTC_Seconds);
2057:./Libraries/src/stm32f4xx_rtc.c **** 
2058:./Libraries/src/stm32f4xx_rtc.c ****     /* Convert the Date structure parameters to Binary format */
