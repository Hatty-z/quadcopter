ARM GAS  /tmp/ccgzaD3d.s 			page 11


 544:./Libraries/src/stm32f4xx_rtc.c ****   * @brief  Enters the RTC Initialization mode.
 545:./Libraries/src/stm32f4xx_rtc.c ****   * @note   The RTC Initialization mode is write protected, use the 
 546:./Libraries/src/stm32f4xx_rtc.c ****   *         RTC_WriteProtectionCmd(DISABLE) before calling this function.    
 547:./Libraries/src/stm32f4xx_rtc.c ****   * @param  None
 548:./Libraries/src/stm32f4xx_rtc.c ****   * @retval An ErrorStatus enumeration value:
 549:./Libraries/src/stm32f4xx_rtc.c ****   *          - SUCCESS: RTC is in Init mode
 550:./Libraries/src/stm32f4xx_rtc.c ****   *          - ERROR: RTC is not in Init mode  
 551:./Libraries/src/stm32f4xx_rtc.c ****   */
 552:./Libraries/src/stm32f4xx_rtc.c **** ErrorStatus RTC_EnterInitMode(void)
 553:./Libraries/src/stm32f4xx_rtc.c **** {
 554:./Libraries/src/stm32f4xx_rtc.c ****   __IO uint32_t initcounter = 0x00;
 555:./Libraries/src/stm32f4xx_rtc.c ****   ErrorStatus status = ERROR;
 556:./Libraries/src/stm32f4xx_rtc.c ****   uint32_t initstatus = 0x00;
 557:./Libraries/src/stm32f4xx_rtc.c ****      
 558:./Libraries/src/stm32f4xx_rtc.c ****   /* Check if the Initialization mode is set */
 559:./Libraries/src/stm32f4xx_rtc.c ****   if ((RTC->ISR & RTC_ISR_INITF) == (uint32_t)RESET)
 560:./Libraries/src/stm32f4xx_rtc.c ****   {
 561:./Libraries/src/stm32f4xx_rtc.c ****     /* Set the Initialization mode */
 562:./Libraries/src/stm32f4xx_rtc.c ****     RTC->ISR = (uint32_t)RTC_INIT_MASK;
 563:./Libraries/src/stm32f4xx_rtc.c ****     
 564:./Libraries/src/stm32f4xx_rtc.c ****     /* Wait till RTC is in INIT state and if Time out is reached exit */
 565:./Libraries/src/stm32f4xx_rtc.c ****     do
 566:./Libraries/src/stm32f4xx_rtc.c ****     {
 567:./Libraries/src/stm32f4xx_rtc.c ****       initstatus = RTC->ISR & RTC_ISR_INITF;
 568:./Libraries/src/stm32f4xx_rtc.c ****       initcounter++;  
 569:./Libraries/src/stm32f4xx_rtc.c ****     } while((initcounter != INITMODE_TIMEOUT) && (initstatus == 0x00));
 570:./Libraries/src/stm32f4xx_rtc.c ****     
 571:./Libraries/src/stm32f4xx_rtc.c ****     if ((RTC->ISR & RTC_ISR_INITF) != RESET)
 572:./Libraries/src/stm32f4xx_rtc.c ****     {
 573:./Libraries/src/stm32f4xx_rtc.c ****       status = SUCCESS;
 574:./Libraries/src/stm32f4xx_rtc.c ****     }
 575:./Libraries/src/stm32f4xx_rtc.c ****     else
 576:./Libraries/src/stm32f4xx_rtc.c ****     {
 577:./Libraries/src/stm32f4xx_rtc.c ****       status = ERROR;
 578:./Libraries/src/stm32f4xx_rtc.c ****     }        
 579:./Libraries/src/stm32f4xx_rtc.c ****   }
 580:./Libraries/src/stm32f4xx_rtc.c ****   else
 581:./Libraries/src/stm32f4xx_rtc.c ****   {
 582:./Libraries/src/stm32f4xx_rtc.c ****     status = SUCCESS;  
 583:./Libraries/src/stm32f4xx_rtc.c ****   } 
 584:./Libraries/src/stm32f4xx_rtc.c ****     
 585:./Libraries/src/stm32f4xx_rtc.c ****   return (status);  
 586:./Libraries/src/stm32f4xx_rtc.c **** }
