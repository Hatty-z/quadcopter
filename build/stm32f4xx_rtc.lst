2457:./Libraries/src/stm32f4xx_rtc.c ****     }
2458:./Libraries/src/stm32f4xx_rtc.c ****   }
2459:./Libraries/src/stm32f4xx_rtc.c **** 
2460:./Libraries/src/stm32f4xx_rtc.c ****   /* Check if the Shift pending is completed or if there is no Shift operation at all*/
2461:./Libraries/src/stm32f4xx_rtc.c ****   if ((RTC->ISR & RTC_ISR_SHPF) == RESET)
2462:./Libraries/src/stm32f4xx_rtc.c ****   {
2463:./Libraries/src/stm32f4xx_rtc.c ****     /* check if the reference clock detection is disabled */
2464:./Libraries/src/stm32f4xx_rtc.c ****     if((RTC->CR & RTC_CR_REFCKON) == RESET)
2465:./Libraries/src/stm32f4xx_rtc.c ****     {
