1492:./Libraries/src/stm32f4xx_rtc.c ****   * @retval None
1493:./Libraries/src/stm32f4xx_rtc.c ****   */
1494:./Libraries/src/stm32f4xx_rtc.c **** void RTC_WakeUpClockConfig(uint32_t RTC_WakeUpClock)
1495:./Libraries/src/stm32f4xx_rtc.c **** {
