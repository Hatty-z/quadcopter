2486:./Libraries/src/stm32f4xx_rtc.c ****   }
2487:./Libraries/src/stm32f4xx_rtc.c **** 
2488:./Libraries/src/stm32f4xx_rtc.c ****   /* Enable the write protection for RTC registers */
