1342:./Libraries/src/stm32f4xx_rtc.c ****     
1343:./Libraries/src/stm32f4xx_rtc.c ****     if ((RTC->ISR & (RTC_Alarm >> 8)) == RESET)
1344:./Libraries/src/stm32f4xx_rtc.c ****     {
1345:./Libraries/src/stm32f4xx_rtc.c ****       status = ERROR;
1346:./Libraries/src/stm32f4xx_rtc.c ****     } 
1347:./Libraries/src/stm32f4xx_rtc.c ****     else
1348:./Libraries/src/stm32f4xx_rtc.c ****     {
1349:./Libraries/src/stm32f4xx_rtc.c ****       status = SUCCESS;
1350:./Libraries/src/stm32f4xx_rtc.c ****     }        
1351:./Libraries/src/stm32f4xx_rtc.c ****   } 
1352:./Libraries/src/stm32f4xx_rtc.c **** 
1353:./Libraries/src/stm32f4xx_rtc.c ****   /* Enable the write protection for RTC registers */
1354:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xFF; 
1355:./Libraries/src/stm32f4xx_rtc.c ****   
1356:./Libraries/src/stm32f4xx_rtc.c ****   return status;
1357:./Libraries/src/stm32f4xx_rtc.c **** }
