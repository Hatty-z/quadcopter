 603:./Libraries/src/stm32f4xx_rtc.c **** /**
 604:./Libraries/src/stm32f4xx_rtc.c ****   * @brief  Waits until the RTC Time and Date registers (RTC_TR and RTC_DR) are 
 605:./Libraries/src/stm32f4xx_rtc.c ****   *         synchronized with RTC APB clock.
 606:./Libraries/src/stm32f4xx_rtc.c ****   * @note   The RTC Resynchronization mode is write protected, use the 
 607:./Libraries/src/stm32f4xx_rtc.c ****   *         RTC_WriteProtectionCmd(DISABLE) before calling this function. 
 608:./Libraries/src/stm32f4xx_rtc.c ****   * @note   To read the calendar through the shadow registers after Calendar 
 609:./Libraries/src/stm32f4xx_rtc.c ****   *         initialization, calendar update or after wakeup from low power modes 
 610:./Libraries/src/stm32f4xx_rtc.c ****   *         the software must first clear the RSF flag. 
 611:./Libraries/src/stm32f4xx_rtc.c ****   *         The software must then wait until it is set again before reading 
 612:./Libraries/src/stm32f4xx_rtc.c ****   *         the calendar, which means that the calendar registers have been 
 613:./Libraries/src/stm32f4xx_rtc.c ****   *         correctly copied into the RTC_TR and RTC_DR shadow registers.   
 614:./Libraries/src/stm32f4xx_rtc.c ****   * @param  None
 615:./Libraries/src/stm32f4xx_rtc.c ****   * @retval An ErrorStatus enumeration value:
 616:./Libraries/src/stm32f4xx_rtc.c ****   *          - SUCCESS: RTC registers are synchronised
 617:./Libraries/src/stm32f4xx_rtc.c ****   *          - ERROR: RTC registers are not synchronised
 618:./Libraries/src/stm32f4xx_rtc.c ****   */
 619:./Libraries/src/stm32f4xx_rtc.c **** ErrorStatus RTC_WaitForSynchro(void)
 620:./Libraries/src/stm32f4xx_rtc.c **** {
 621:./Libraries/src/stm32f4xx_rtc.c ****   __IO uint32_t synchrocounter = 0;
 622:./Libraries/src/stm32f4xx_rtc.c ****   ErrorStatus status = ERROR;
 623:./Libraries/src/stm32f4xx_rtc.c ****   uint32_t synchrostatus = 0x00;
 624:./Libraries/src/stm32f4xx_rtc.c **** 
 625:./Libraries/src/stm32f4xx_rtc.c ****   /* Disable the write protection for RTC registers */
 626:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xCA;
 627:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0x53;
 628:./Libraries/src/stm32f4xx_rtc.c ****     
 629:./Libraries/src/stm32f4xx_rtc.c ****   /* Clear RSF flag */
 630:./Libraries/src/stm32f4xx_rtc.c ****   RTC->ISR &= (uint32_t)RTC_RSF_MASK;
 631:./Libraries/src/stm32f4xx_rtc.c ****     
 632:./Libraries/src/stm32f4xx_rtc.c ****   /* Wait the registers to be synchronised */
 633:./Libraries/src/stm32f4xx_rtc.c ****   do
 634:./Libraries/src/stm32f4xx_rtc.c ****   {
 635:./Libraries/src/stm32f4xx_rtc.c ****     synchrostatus = RTC->ISR & RTC_ISR_RSF;
 636:./Libraries/src/stm32f4xx_rtc.c ****     synchrocounter++;  
 637:./Libraries/src/stm32f4xx_rtc.c ****   } while((synchrocounter != SYNCHRO_TIMEOUT) && (synchrostatus == 0x00));
 638:./Libraries/src/stm32f4xx_rtc.c ****     
 639:./Libraries/src/stm32f4xx_rtc.c ****   if ((RTC->ISR & RTC_ISR_RSF) != RESET)
 640:./Libraries/src/stm32f4xx_rtc.c ****   {
 641:./Libraries/src/stm32f4xx_rtc.c ****     status = SUCCESS;
 642:./Libraries/src/stm32f4xx_rtc.c ****   }
 643:./Libraries/src/stm32f4xx_rtc.c ****   else
 644:./Libraries/src/stm32f4xx_rtc.c ****   {
 645:./Libraries/src/stm32f4xx_rtc.c ****     status = ERROR;
 646:./Libraries/src/stm32f4xx_rtc.c ****   }        
 647:./Libraries/src/stm32f4xx_rtc.c **** 
 648:./Libraries/src/stm32f4xx_rtc.c ****   /* Enable the write protection for RTC registers */
 649:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xFF; 
 650:./Libraries/src/stm32f4xx_rtc.c ****     
 651:./Libraries/src/stm32f4xx_rtc.c ****   return (status); 
 652:./Libraries/src/stm32f4xx_rtc.c **** }
 653:./Libraries/src/stm32f4xx_rtc.c **** 
 654:./Libraries/src/stm32f4xx_rtc.c **** /**
