 327:./Libraries/src/stm32f4xx_rtc.c **** /** @defgroup RTC_Group1 Initialization and Configuration functions
 328:./Libraries/src/stm32f4xx_rtc.c ****  *  @brief   Initialization and Configuration functions 
 329:./Libraries/src/stm32f4xx_rtc.c ****  *
 330:./Libraries/src/stm32f4xx_rtc.c **** @verbatim   
 331:./Libraries/src/stm32f4xx_rtc.c ****  ===============================================================================
 332:./Libraries/src/stm32f4xx_rtc.c ****              ##### Initialization and Configuration functions #####
 333:./Libraries/src/stm32f4xx_rtc.c ****  ===============================================================================
 334:./Libraries/src/stm32f4xx_rtc.c ****  
 335:./Libraries/src/stm32f4xx_rtc.c ****  [..] This section provide functions allowing to initialize and configure the RTC
 336:./Libraries/src/stm32f4xx_rtc.c ****       Prescaler (Synchronous and Asynchronous), RTC Hour format, disable RTC registers
 337:./Libraries/src/stm32f4xx_rtc.c ****       Write protection, enter and exit the RTC initialization mode, RTC registers
 338:./Libraries/src/stm32f4xx_rtc.c ****       synchronization check and reference clock detection enable.
 339:./Libraries/src/stm32f4xx_rtc.c ****   
 340:./Libraries/src/stm32f4xx_rtc.c ****    (#) The RTC Prescaler is programmed to generate the RTC 1Hz time base. It is
 341:./Libraries/src/stm32f4xx_rtc.c ****        split into 2 programmable prescalers to minimize power consumption.
 342:./Libraries/src/stm32f4xx_rtc.c ****        (++) A 7-bit asynchronous prescaler and A 13-bit synchronous prescaler.
 343:./Libraries/src/stm32f4xx_rtc.c ****        (++) When both prescalers are used, it is recommended to configure the 
 344:./Libraries/src/stm32f4xx_rtc.c ****             asynchronous prescaler to a high value to minimize consumption.
 345:./Libraries/src/stm32f4xx_rtc.c **** 
 346:./Libraries/src/stm32f4xx_rtc.c ****    (#) All RTC registers are Write protected. Writing to the RTC registers
 347:./Libraries/src/stm32f4xx_rtc.c ****        is enabled by writing a key into the Write Protection register, RTC_WPR.
 348:./Libraries/src/stm32f4xx_rtc.c **** 
 349:./Libraries/src/stm32f4xx_rtc.c ****    (#) To Configure the RTC Calendar, user application should enter initialization
 350:./Libraries/src/stm32f4xx_rtc.c ****        mode. In this mode, the calendar counter is stopped and its value can be 
 351:./Libraries/src/stm32f4xx_rtc.c ****        updated. When the initialization sequence is complete, the calendar restarts 
 352:./Libraries/src/stm32f4xx_rtc.c ****        counting after 4 RTCCLK cycles.
 353:./Libraries/src/stm32f4xx_rtc.c **** 
 354:./Libraries/src/stm32f4xx_rtc.c ****    (#) To read the calendar through the shadow registers after Calendar initialization,
 355:./Libraries/src/stm32f4xx_rtc.c ****        calendar update or after wakeup from low power modes the software must first 
 356:./Libraries/src/stm32f4xx_rtc.c ****        clear the RSF flag. The software must then wait until it is set again before 
 357:./Libraries/src/stm32f4xx_rtc.c ****        reading the calendar, which means that the calendar registers have been 
 358:./Libraries/src/stm32f4xx_rtc.c ****        correctly copied into the RTC_TR and RTC_DR shadow registers.
 359:./Libraries/src/stm32f4xx_rtc.c ****        The RTC_WaitForSynchro() function implements the above software sequence 
 360:./Libraries/src/stm32f4xx_rtc.c ****        (RSF clear and RSF check).
 361:./Libraries/src/stm32f4xx_rtc.c **** 
 362:./Libraries/src/stm32f4xx_rtc.c **** @endverbatim
 363:./Libraries/src/stm32f4xx_rtc.c ****   * @{
 364:./Libraries/src/stm32f4xx_rtc.c ****   */
 365:./Libraries/src/stm32f4xx_rtc.c **** 
 366:./Libraries/src/stm32f4xx_rtc.c **** /**
 367:./Libraries/src/stm32f4xx_rtc.c ****   * @brief  Deinitializes the RTC registers to their default reset values.
 368:./Libraries/src/stm32f4xx_rtc.c ****   * @note   This function doesn't reset the RTC Clock source and RTC Backup Data
 369:./Libraries/src/stm32f4xx_rtc.c ****   *         registers.       
 370:./Libraries/src/stm32f4xx_rtc.c ****   * @param  None
 371:./Libraries/src/stm32f4xx_rtc.c ****   * @retval An ErrorStatus enumeration value:
 372:./Libraries/src/stm32f4xx_rtc.c ****   *          - SUCCESS: RTC registers are deinitialized
ARM GAS  /tmp/ccgzaD3d.s 			page 8


 373:./Libraries/src/stm32f4xx_rtc.c ****   *          - ERROR: RTC registers are not deinitialized
 374:./Libraries/src/stm32f4xx_rtc.c ****   */
 375:./Libraries/src/stm32f4xx_rtc.c **** ErrorStatus RTC_DeInit(void)
 376:./Libraries/src/stm32f4xx_rtc.c **** {
 377:./Libraries/src/stm32f4xx_rtc.c ****   __IO uint32_t wutcounter = 0x00;
 378:./Libraries/src/stm32f4xx_rtc.c ****   uint32_t wutwfstatus = 0x00;
 379:./Libraries/src/stm32f4xx_rtc.c ****   ErrorStatus status = ERROR;
 380:./Libraries/src/stm32f4xx_rtc.c ****   
 381:./Libraries/src/stm32f4xx_rtc.c ****   /* Disable the write protection for RTC registers */
 382:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xCA;
 383:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0x53;
 384:./Libraries/src/stm32f4xx_rtc.c **** 
 385:./Libraries/src/stm32f4xx_rtc.c ****   /* Set Initialization mode */
 386:./Libraries/src/stm32f4xx_rtc.c ****   if (RTC_EnterInitMode() == ERROR)
 387:./Libraries/src/stm32f4xx_rtc.c ****   {
 388:./Libraries/src/stm32f4xx_rtc.c ****     status = ERROR;
 389:./Libraries/src/stm32f4xx_rtc.c ****   }  
 390:./Libraries/src/stm32f4xx_rtc.c ****   else
 391:./Libraries/src/stm32f4xx_rtc.c ****   {
 392:./Libraries/src/stm32f4xx_rtc.c ****     /* Reset TR, DR and CR registers */
 393:./Libraries/src/stm32f4xx_rtc.c ****     RTC->TR = (uint32_t)0x00000000;
 394:./Libraries/src/stm32f4xx_rtc.c ****     RTC->DR = (uint32_t)0x00002101;
 395:./Libraries/src/stm32f4xx_rtc.c ****     /* Reset All CR bits except CR[2:0] */
 396:./Libraries/src/stm32f4xx_rtc.c ****     RTC->CR &= (uint32_t)0x00000007;
 397:./Libraries/src/stm32f4xx_rtc.c ****   
 398:./Libraries/src/stm32f4xx_rtc.c ****     /* Wait till RTC WUTWF flag is set and if Time out is reached exit */
 399:./Libraries/src/stm32f4xx_rtc.c ****     do
 400:./Libraries/src/stm32f4xx_rtc.c ****     {
 401:./Libraries/src/stm32f4xx_rtc.c ****       wutwfstatus = RTC->ISR & RTC_ISR_WUTWF;
 402:./Libraries/src/stm32f4xx_rtc.c ****       wutcounter++;  
 403:./Libraries/src/stm32f4xx_rtc.c ****     } while((wutcounter != INITMODE_TIMEOUT) && (wutwfstatus == 0x00));
 404:./Libraries/src/stm32f4xx_rtc.c ****     
 405:./Libraries/src/stm32f4xx_rtc.c ****     if ((RTC->ISR & RTC_ISR_WUTWF) == RESET)
 406:./Libraries/src/stm32f4xx_rtc.c ****     {
 407:./Libraries/src/stm32f4xx_rtc.c ****       status = ERROR;
 408:./Libraries/src/stm32f4xx_rtc.c ****     }
 409:./Libraries/src/stm32f4xx_rtc.c ****     else
 410:./Libraries/src/stm32f4xx_rtc.c ****     {
 411:./Libraries/src/stm32f4xx_rtc.c ****       /* Reset all RTC CR register bits */
 412:./Libraries/src/stm32f4xx_rtc.c ****       RTC->CR &= (uint32_t)0x00000000;
 413:./Libraries/src/stm32f4xx_rtc.c ****       RTC->WUTR = (uint32_t)0x0000FFFF;
 414:./Libraries/src/stm32f4xx_rtc.c ****       RTC->PRER = (uint32_t)0x007F00FF;
 415:./Libraries/src/stm32f4xx_rtc.c ****       RTC->CALIBR = (uint32_t)0x00000000;
 416:./Libraries/src/stm32f4xx_rtc.c ****       RTC->ALRMAR = (uint32_t)0x00000000;        
 417:./Libraries/src/stm32f4xx_rtc.c ****       RTC->ALRMBR = (uint32_t)0x00000000;
 418:./Libraries/src/stm32f4xx_rtc.c ****       RTC->SHIFTR = (uint32_t)0x00000000;
 419:./Libraries/src/stm32f4xx_rtc.c ****       RTC->CALR = (uint32_t)0x00000000;
 420:./Libraries/src/stm32f4xx_rtc.c ****       RTC->ALRMASSR = (uint32_t)0x00000000;
 421:./Libraries/src/stm32f4xx_rtc.c ****       RTC->ALRMBSSR = (uint32_t)0x00000000;
 422:./Libraries/src/stm32f4xx_rtc.c ****       
 423:./Libraries/src/stm32f4xx_rtc.c ****       /* Reset ISR register and exit initialization mode */
 424:./Libraries/src/stm32f4xx_rtc.c ****       RTC->ISR = (uint32_t)0x00000000;
 425:./Libraries/src/stm32f4xx_rtc.c ****       
 426:./Libraries/src/stm32f4xx_rtc.c ****       /* Reset Tamper and alternate functions configuration register */
 427:./Libraries/src/stm32f4xx_rtc.c ****       RTC->TAFCR = 0x00000000;
 428:./Libraries/src/stm32f4xx_rtc.c ****   
 429:./Libraries/src/stm32f4xx_rtc.c ****       if(RTC_WaitForSynchro() == ERROR)
ARM GAS  /tmp/ccgzaD3d.s 			page 9


 430:./Libraries/src/stm32f4xx_rtc.c ****       {
 431:./Libraries/src/stm32f4xx_rtc.c ****         status = ERROR;
 432:./Libraries/src/stm32f4xx_rtc.c ****       }
 433:./Libraries/src/stm32f4xx_rtc.c ****       else
 434:./Libraries/src/stm32f4xx_rtc.c ****       {
 435:./Libraries/src/stm32f4xx_rtc.c ****         status = SUCCESS;      
 436:./Libraries/src/stm32f4xx_rtc.c ****       }
 437:./Libraries/src/stm32f4xx_rtc.c ****     }
 438:./Libraries/src/stm32f4xx_rtc.c ****   }
 439:./Libraries/src/stm32f4xx_rtc.c ****   
 440:./Libraries/src/stm32f4xx_rtc.c ****   /* Enable the write protection for RTC registers */
 441:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xFF;  
 442:./Libraries/src/stm32f4xx_rtc.c ****   
 443:./Libraries/src/stm32f4xx_rtc.c ****   return status;
 444:./Libraries/src/stm32f4xx_rtc.c **** }
 445:./Libraries/src/stm32f4xx_rtc.c **** 
 446:./Libraries/src/stm32f4xx_rtc.c **** /**
 447:./Libraries/src/stm32f4xx_rtc.c ****   * @brief  Initializes the RTC registers according to the specified parameters 
 448:./Libraries/src/stm32f4xx_rtc.c ****   *         in RTC_InitStruct.
 449:./Libraries/src/stm32f4xx_rtc.c ****   * @param  RTC_InitStruct: pointer to a RTC_InitTypeDef structure that contains 
 450:./Libraries/src/stm32f4xx_rtc.c ****   *         the configuration information for the RTC peripheral.
 451:./Libraries/src/stm32f4xx_rtc.c ****   * @note   The RTC Prescaler register is write protected and can be written in 
 452:./Libraries/src/stm32f4xx_rtc.c ****   *         initialization mode only.  
 453:./Libraries/src/stm32f4xx_rtc.c ****   * @retval An ErrorStatus enumeration value:
 454:./Libraries/src/stm32f4xx_rtc.c ****   *          - SUCCESS: RTC registers are initialized
 455:./Libraries/src/stm32f4xx_rtc.c ****   *          - ERROR: RTC registers are not initialized  
 456:./Libraries/src/stm32f4xx_rtc.c ****   */
 457:./Libraries/src/stm32f4xx_rtc.c **** ErrorStatus RTC_Init(RTC_InitTypeDef* RTC_InitStruct)
 458:./Libraries/src/stm32f4xx_rtc.c **** {
 459:./Libraries/src/stm32f4xx_rtc.c ****   ErrorStatus status = ERROR;
 460:./Libraries/src/stm32f4xx_rtc.c ****   
 461:./Libraries/src/stm32f4xx_rtc.c ****   /* Check the parameters */
 462:./Libraries/src/stm32f4xx_rtc.c ****   assert_param(IS_RTC_HOUR_FORMAT(RTC_InitStruct->RTC_HourFormat));
 463:./Libraries/src/stm32f4xx_rtc.c ****   assert_param(IS_RTC_ASYNCH_PREDIV(RTC_InitStruct->RTC_AsynchPrediv));
 464:./Libraries/src/stm32f4xx_rtc.c ****   assert_param(IS_RTC_SYNCH_PREDIV(RTC_InitStruct->RTC_SynchPrediv));
 465:./Libraries/src/stm32f4xx_rtc.c **** 
 466:./Libraries/src/stm32f4xx_rtc.c ****   /* Disable the write protection for RTC registers */
 467:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xCA;
 468:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0x53;
 469:./Libraries/src/stm32f4xx_rtc.c **** 
 470:./Libraries/src/stm32f4xx_rtc.c ****   /* Set Initialization mode */
 471:./Libraries/src/stm32f4xx_rtc.c ****   if (RTC_EnterInitMode() == ERROR)
 472:./Libraries/src/stm32f4xx_rtc.c ****   {
 473:./Libraries/src/stm32f4xx_rtc.c ****     status = ERROR;
 474:./Libraries/src/stm32f4xx_rtc.c ****   } 
 475:./Libraries/src/stm32f4xx_rtc.c ****   else
 476:./Libraries/src/stm32f4xx_rtc.c ****   {
 477:./Libraries/src/stm32f4xx_rtc.c ****     /* Clear RTC CR FMT Bit */
 478:./Libraries/src/stm32f4xx_rtc.c ****     RTC->CR &= ((uint32_t)~(RTC_CR_FMT));
 479:./Libraries/src/stm32f4xx_rtc.c ****     /* Set RTC_CR register */
 480:./Libraries/src/stm32f4xx_rtc.c ****     RTC->CR |=  ((uint32_t)(RTC_InitStruct->RTC_HourFormat));
 481:./Libraries/src/stm32f4xx_rtc.c ****   
 482:./Libraries/src/stm32f4xx_rtc.c ****     /* Configure the RTC PRER */
 483:./Libraries/src/stm32f4xx_rtc.c ****     RTC->PRER = (uint32_t)(RTC_InitStruct->RTC_SynchPrediv);
