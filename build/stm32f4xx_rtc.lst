2444:./Libraries/src/stm32f4xx_rtc.c ****   assert_param(IS_RTC_SHIFT_SUBFS(RTC_ShiftSubFS));
2445:./Libraries/src/stm32f4xx_rtc.c **** 
2446:./Libraries/src/stm32f4xx_rtc.c ****   /* Disable the write protection for RTC registers */
2447:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xCA;
