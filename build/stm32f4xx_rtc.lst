1497:./Libraries/src/stm32f4xx_rtc.c ****   assert_param(IS_RTC_WAKEUP_CLOCK(RTC_WakeUpClock));
1498:./Libraries/src/stm32f4xx_rtc.c **** 
1499:./Libraries/src/stm32f4xx_rtc.c ****   /* Disable the write protection for RTC registers */
1500:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xCA;
1501:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0x53;
1502:./Libraries/src/stm32f4xx_rtc.c **** 
