1508:./Libraries/src/stm32f4xx_rtc.c ****   
1509:./Libraries/src/stm32f4xx_rtc.c ****   /* Enable the write protection for RTC registers */
1510:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xFF; 
