2544:./Libraries/src/stm32f4xx_rtc.c **** /**
2545:./Libraries/src/stm32f4xx_rtc.c ****   * @brief  Enables or disables the specified RTC interrupts.
2546:./Libraries/src/stm32f4xx_rtc.c ****   * @param  RTC_IT: specifies the RTC interrupt sources to be enabled or disabled. 
2547:./Libraries/src/stm32f4xx_rtc.c ****   *          This parameter can be any combination of the following values:
2548:./Libraries/src/stm32f4xx_rtc.c ****   *            @arg RTC_IT_TS:  Time Stamp interrupt mask
2549:./Libraries/src/stm32f4xx_rtc.c ****   *            @arg RTC_IT_WUT:  WakeUp Timer interrupt mask
2550:./Libraries/src/stm32f4xx_rtc.c ****   *            @arg RTC_IT_ALRB:  Alarm B interrupt mask
2551:./Libraries/src/stm32f4xx_rtc.c ****   *            @arg RTC_IT_ALRA:  Alarm A interrupt mask
2552:./Libraries/src/stm32f4xx_rtc.c ****   *            @arg RTC_IT_TAMP: Tamper event interrupt mask
2553:./Libraries/src/stm32f4xx_rtc.c ****   * @param  NewState: new state of the specified RTC interrupts.
2554:./Libraries/src/stm32f4xx_rtc.c ****   *          This parameter can be: ENABLE or DISABLE.
2555:./Libraries/src/stm32f4xx_rtc.c ****   * @retval None
2556:./Libraries/src/stm32f4xx_rtc.c ****   */
2557:./Libraries/src/stm32f4xx_rtc.c **** void RTC_ITConfig(uint32_t RTC_IT, FunctionalState NewState)
2558:./Libraries/src/stm32f4xx_rtc.c **** {
2559:./Libraries/src/stm32f4xx_rtc.c ****   /* Check the parameters */
2560:./Libraries/src/stm32f4xx_rtc.c ****   assert_param(IS_RTC_CONFIG_IT(RTC_IT));
2561:./Libraries/src/stm32f4xx_rtc.c ****   assert_param(IS_FUNCTIONAL_STATE(NewState));
2562:./Libraries/src/stm32f4xx_rtc.c **** 
2563:./Libraries/src/stm32f4xx_rtc.c ****   /* Disable the write protection for RTC registers */
2564:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xCA;
2565:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0x53;
2566:./Libraries/src/stm32f4xx_rtc.c **** 
2567:./Libraries/src/stm32f4xx_rtc.c ****   if (NewState != DISABLE)
2568:./Libraries/src/stm32f4xx_rtc.c ****   {
2569:./Libraries/src/stm32f4xx_rtc.c ****     /* Configure the Interrupts in the RTC_CR register */
2570:./Libraries/src/stm32f4xx_rtc.c ****     RTC->CR |= (uint32_t)(RTC_IT & ~RTC_TAFCR_TAMPIE);
2571:./Libraries/src/stm32f4xx_rtc.c ****     /* Configure the Tamper Interrupt in the RTC_TAFCR */
2572:./Libraries/src/stm32f4xx_rtc.c ****     RTC->TAFCR |= (uint32_t)(RTC_IT & RTC_TAFCR_TAMPIE);
2573:./Libraries/src/stm32f4xx_rtc.c ****   }
2574:./Libraries/src/stm32f4xx_rtc.c ****   else
2575:./Libraries/src/stm32f4xx_rtc.c ****   {
2576:./Libraries/src/stm32f4xx_rtc.c ****     /* Configure the Interrupts in the RTC_CR register */
2577:./Libraries/src/stm32f4xx_rtc.c ****     RTC->CR &= (uint32_t)~(RTC_IT & (uint32_t)~RTC_TAFCR_TAMPIE);
2578:./Libraries/src/stm32f4xx_rtc.c ****     /* Configure the Tamper Interrupt in the RTC_TAFCR */
2579:./Libraries/src/stm32f4xx_rtc.c ****     RTC->TAFCR &= (uint32_t)~(RTC_IT & RTC_TAFCR_TAMPIE);
2580:./Libraries/src/stm32f4xx_rtc.c ****   }
2581:./Libraries/src/stm32f4xx_rtc.c ****   /* Enable the write protection for RTC registers */
2582:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xFF; 
2583:./Libraries/src/stm32f4xx_rtc.c **** }
2584:./Libraries/src/stm32f4xx_rtc.c **** 
