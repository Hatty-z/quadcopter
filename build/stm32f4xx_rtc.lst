 695:./Libraries/src/stm32f4xx_rtc.c ****   
 696:./Libraries/src/stm32f4xx_rtc.c ****   /* Enable the write protection for RTC registers */
 697:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xFF;  
