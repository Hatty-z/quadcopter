 515:./Libraries/src/stm32f4xx_rtc.c **** /**
 516:./Libraries/src/stm32f4xx_rtc.c ****   * @brief  Enables or disables the RTC registers write protection.
 517:./Libraries/src/stm32f4xx_rtc.c ****   * @note   All the RTC registers are write protected except for RTC_ISR[13:8], 
 518:./Libraries/src/stm32f4xx_rtc.c ****   *         RTC_TAFCR and RTC_BKPxR.
 519:./Libraries/src/stm32f4xx_rtc.c ****   * @note   Writing a wrong key reactivates the write protection.
 520:./Libraries/src/stm32f4xx_rtc.c ****   * @note   The protection mechanism is not affected by system reset.  
 521:./Libraries/src/stm32f4xx_rtc.c ****   * @param  NewState: new state of the write protection.
 522:./Libraries/src/stm32f4xx_rtc.c ****   *          This parameter can be: ENABLE or DISABLE.
 523:./Libraries/src/stm32f4xx_rtc.c ****   * @retval None
 524:./Libraries/src/stm32f4xx_rtc.c ****   */
 525:./Libraries/src/stm32f4xx_rtc.c **** void RTC_WriteProtectionCmd(FunctionalState NewState)
 526:./Libraries/src/stm32f4xx_rtc.c **** {
 527:./Libraries/src/stm32f4xx_rtc.c ****   /* Check the parameters */
 528:./Libraries/src/stm32f4xx_rtc.c ****   assert_param(IS_FUNCTIONAL_STATE(NewState));
 529:./Libraries/src/stm32f4xx_rtc.c ****     
 530:./Libraries/src/stm32f4xx_rtc.c ****   if (NewState != DISABLE)
 531:./Libraries/src/stm32f4xx_rtc.c ****   {
 532:./Libraries/src/stm32f4xx_rtc.c ****     /* Enable the write protection for RTC registers */
 533:./Libraries/src/stm32f4xx_rtc.c ****     RTC->WPR = 0xFF;   
 534:./Libraries/src/stm32f4xx_rtc.c ****   }
 535:./Libraries/src/stm32f4xx_rtc.c ****   else
 536:./Libraries/src/stm32f4xx_rtc.c ****   {
 537:./Libraries/src/stm32f4xx_rtc.c ****     /* Disable the write protection for RTC registers */
 538:./Libraries/src/stm32f4xx_rtc.c ****     RTC->WPR = 0xCA;
 539:./Libraries/src/stm32f4xx_rtc.c ****     RTC->WPR = 0x53;    
 540:./Libraries/src/stm32f4xx_rtc.c ****   }
 541:./Libraries/src/stm32f4xx_rtc.c **** }
