1301:./Libraries/src/stm32f4xx_rtc.c ****   *          This parameter can be any combination of the following values:
1302:./Libraries/src/stm32f4xx_rtc.c ****   *            @arg RTC_Alarm_A: to select Alarm A
1303:./Libraries/src/stm32f4xx_rtc.c ****   *            @arg RTC_Alarm_B: to select Alarm B  
1304:./Libraries/src/stm32f4xx_rtc.c ****   * @param  NewState: new state of the specified alarm.
1305:./Libraries/src/stm32f4xx_rtc.c ****   *          This parameter can be: ENABLE or DISABLE.
1306:./Libraries/src/stm32f4xx_rtc.c ****   * @retval An ErrorStatus enumeration value:
1307:./Libraries/src/stm32f4xx_rtc.c ****   *          - SUCCESS: RTC Alarm is enabled/disabled
1308:./Libraries/src/stm32f4xx_rtc.c ****   *          - ERROR: RTC Alarm is not enabled/disabled  
1309:./Libraries/src/stm32f4xx_rtc.c ****   */
1310:./Libraries/src/stm32f4xx_rtc.c **** ErrorStatus RTC_AlarmCmd(uint32_t RTC_Alarm, FunctionalState NewState)
1311:./Libraries/src/stm32f4xx_rtc.c **** {
1312:./Libraries/src/stm32f4xx_rtc.c ****   __IO uint32_t alarmcounter = 0x00;
1313:./Libraries/src/stm32f4xx_rtc.c ****   uint32_t alarmstatus = 0x00;
1314:./Libraries/src/stm32f4xx_rtc.c ****   ErrorStatus status = ERROR;
1315:./Libraries/src/stm32f4xx_rtc.c ****     
1316:./Libraries/src/stm32f4xx_rtc.c ****   /* Check the parameters */
1317:./Libraries/src/stm32f4xx_rtc.c ****   assert_param(IS_RTC_CMD_ALARM(RTC_Alarm));
1318:./Libraries/src/stm32f4xx_rtc.c ****   assert_param(IS_FUNCTIONAL_STATE(NewState));
1319:./Libraries/src/stm32f4xx_rtc.c **** 
1320:./Libraries/src/stm32f4xx_rtc.c ****   /* Disable the write protection for RTC registers */
1321:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xCA;
1322:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0x53;
1323:./Libraries/src/stm32f4xx_rtc.c **** 
1324:./Libraries/src/stm32f4xx_rtc.c ****   /* Configure the Alarm state */
1325:./Libraries/src/stm32f4xx_rtc.c ****   if (NewState != DISABLE)
1326:./Libraries/src/stm32f4xx_rtc.c ****   {
1327:./Libraries/src/stm32f4xx_rtc.c ****     RTC->CR |= (uint32_t)RTC_Alarm;
1328:./Libraries/src/stm32f4xx_rtc.c **** 
1329:./Libraries/src/stm32f4xx_rtc.c ****     status = SUCCESS;    
1330:./Libraries/src/stm32f4xx_rtc.c ****   }
1331:./Libraries/src/stm32f4xx_rtc.c ****   else
1332:./Libraries/src/stm32f4xx_rtc.c ****   { 
1333:./Libraries/src/stm32f4xx_rtc.c ****     /* Disable the Alarm in RTC_CR register */
1334:./Libraries/src/stm32f4xx_rtc.c ****     RTC->CR &= (uint32_t)~RTC_Alarm;
1335:./Libraries/src/stm32f4xx_rtc.c ****    
1336:./Libraries/src/stm32f4xx_rtc.c ****     /* Wait till RTC ALRxWF flag is set and if Time out is reached exit */
1337:./Libraries/src/stm32f4xx_rtc.c ****     do
1338:./Libraries/src/stm32f4xx_rtc.c ****     {
1339:./Libraries/src/stm32f4xx_rtc.c ****       alarmstatus = RTC->ISR & (RTC_Alarm >> 8);
1340:./Libraries/src/stm32f4xx_rtc.c ****       alarmcounter++;  
1341:./Libraries/src/stm32f4xx_rtc.c ****     } while((alarmcounter != INITMODE_TIMEOUT) && (alarmstatus == 0x00));
