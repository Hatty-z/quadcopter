1548:./Libraries/src/stm32f4xx_rtc.c **** /**
1549:./Libraries/src/stm32f4xx_rtc.c ****   * @brief  Enables or Disables the RTC WakeUp timer.
1550:./Libraries/src/stm32f4xx_rtc.c ****   * @param  NewState: new state of the WakeUp timer.
1551:./Libraries/src/stm32f4xx_rtc.c ****   *          This parameter can be: ENABLE or DISABLE.
1552:./Libraries/src/stm32f4xx_rtc.c ****   * @retval None
1553:./Libraries/src/stm32f4xx_rtc.c ****   */
1554:./Libraries/src/stm32f4xx_rtc.c **** ErrorStatus RTC_WakeUpCmd(FunctionalState NewState)
1555:./Libraries/src/stm32f4xx_rtc.c **** {
1556:./Libraries/src/stm32f4xx_rtc.c ****   __IO uint32_t wutcounter = 0x00;
1557:./Libraries/src/stm32f4xx_rtc.c ****   uint32_t wutwfstatus = 0x00;
1558:./Libraries/src/stm32f4xx_rtc.c ****   ErrorStatus status = ERROR;
1559:./Libraries/src/stm32f4xx_rtc.c ****   
1560:./Libraries/src/stm32f4xx_rtc.c ****   /* Check the parameters */
1561:./Libraries/src/stm32f4xx_rtc.c ****   assert_param(IS_FUNCTIONAL_STATE(NewState));
1562:./Libraries/src/stm32f4xx_rtc.c **** 
1563:./Libraries/src/stm32f4xx_rtc.c ****   /* Disable the write protection for RTC registers */
1564:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xCA;
1565:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0x53;
1566:./Libraries/src/stm32f4xx_rtc.c **** 
1567:./Libraries/src/stm32f4xx_rtc.c ****   if (NewState != DISABLE)
1568:./Libraries/src/stm32f4xx_rtc.c ****   {
1569:./Libraries/src/stm32f4xx_rtc.c ****     /* Enable the Wakeup Timer */
ARM GAS  /tmp/ccgzaD3d.s 			page 29


1570:./Libraries/src/stm32f4xx_rtc.c ****     RTC->CR |= (uint32_t)RTC_CR_WUTE;
1571:./Libraries/src/stm32f4xx_rtc.c ****     status = SUCCESS;    
1572:./Libraries/src/stm32f4xx_rtc.c ****   }
1573:./Libraries/src/stm32f4xx_rtc.c ****   else
1574:./Libraries/src/stm32f4xx_rtc.c ****   {
1575:./Libraries/src/stm32f4xx_rtc.c ****     /* Disable the Wakeup Timer */
1576:./Libraries/src/stm32f4xx_rtc.c ****     RTC->CR &= (uint32_t)~RTC_CR_WUTE;
1577:./Libraries/src/stm32f4xx_rtc.c ****     /* Wait till RTC WUTWF flag is set and if Time out is reached exit */
1578:./Libraries/src/stm32f4xx_rtc.c ****     do
1579:./Libraries/src/stm32f4xx_rtc.c ****     {
1580:./Libraries/src/stm32f4xx_rtc.c ****       wutwfstatus = RTC->ISR & RTC_ISR_WUTWF;
1581:./Libraries/src/stm32f4xx_rtc.c ****       wutcounter++;  
1582:./Libraries/src/stm32f4xx_rtc.c ****     } while((wutcounter != INITMODE_TIMEOUT) && (wutwfstatus == 0x00));
1583:./Libraries/src/stm32f4xx_rtc.c ****     
1584:./Libraries/src/stm32f4xx_rtc.c ****     if ((RTC->ISR & RTC_ISR_WUTWF) == RESET)
1585:./Libraries/src/stm32f4xx_rtc.c ****     {
1586:./Libraries/src/stm32f4xx_rtc.c ****       status = ERROR;
1587:./Libraries/src/stm32f4xx_rtc.c ****     }
1588:./Libraries/src/stm32f4xx_rtc.c ****     else
1589:./Libraries/src/stm32f4xx_rtc.c ****     {
1590:./Libraries/src/stm32f4xx_rtc.c ****       status = SUCCESS;
1591:./Libraries/src/stm32f4xx_rtc.c ****     }    
1592:./Libraries/src/stm32f4xx_rtc.c ****   }
1593:./Libraries/src/stm32f4xx_rtc.c **** 
1594:./Libraries/src/stm32f4xx_rtc.c ****   /* Enable the write protection for RTC registers */
1595:./Libraries/src/stm32f4xx_rtc.c ****   RTC->WPR = 0xFF; 
1596:./Libraries/src/stm32f4xx_rtc.c ****   
1597:./Libraries/src/stm32f4xx_rtc.c ****   return status;
1598:./Libraries/src/stm32f4xx_rtc.c **** }
