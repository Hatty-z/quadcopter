 400:./ucos/Core/os_q.c **** /*
 401:./ucos/Core/os_q.c **** ***************************************************************************************************
 402:./ucos/Core/os_q.c **** *                                    PEND ON A QUEUE FOR A MESSAGE
 403:./ucos/Core/os_q.c **** *
 404:./ucos/Core/os_q.c **** * Description: This function waits for a message to be sent to a queue
 405:./ucos/Core/os_q.c **** *
 406:./ucos/Core/os_q.c **** * Arguments  : pevent        is a pointer to the event control block associated with the desired qu
ARM GAS  /tmp/ccz2mqua.s 			page 23


 407:./ucos/Core/os_q.c **** *
 408:./ucos/Core/os_q.c **** *              timeout       is an optional timeout period (in clock ticks).  If non-zero, your tas
 409:./ucos/Core/os_q.c **** *                            wait for a message to arrive at the queue up to the amount of time
 410:./ucos/Core/os_q.c **** *                            specified by this argument.  If you specify 0, however, your task will
 411:./ucos/Core/os_q.c **** *                            forever at the specified queue or, until a message arrives.
 412:./ucos/Core/os_q.c **** *
 413:./ucos/Core/os_q.c **** *              perr          is a pointer to where an error message will be deposited.  Possible er
 414:./ucos/Core/os_q.c **** *                            messages are:
 415:./ucos/Core/os_q.c **** *
 416:./ucos/Core/os_q.c **** *                            OS_ERR_NONE         The call was successful and your task received a
 417:./ucos/Core/os_q.c **** *                                                message.
 418:./ucos/Core/os_q.c **** *                            OS_ERR_TIMEOUT      A message was not received within the specified 't
 419:./ucos/Core/os_q.c **** *                            OS_ERR_PEND_ABORT   The wait on the queue was aborted.
 420:./ucos/Core/os_q.c **** *                            OS_ERR_EVENT_TYPE   You didn't pass a pointer to a queue
 421:./ucos/Core/os_q.c **** *                            OS_ERR_PEVENT_NULL  If 'pevent' is a NULL pointer
 422:./ucos/Core/os_q.c **** *                            OS_ERR_PEND_ISR     If you called this function from an ISR and the re
 423:./ucos/Core/os_q.c **** *                                                would lead to a suspension.
 424:./ucos/Core/os_q.c **** *                            OS_ERR_PEND_LOCKED  If you called this function with the scheduler is 
 425:./ucos/Core/os_q.c **** *
 426:./ucos/Core/os_q.c **** * Returns    : != (void *)0  is a pointer to the message received
 427:./ucos/Core/os_q.c **** *              == (void *)0  if you received a NULL pointer message or,
 428:./ucos/Core/os_q.c **** *                            if no message was received or,
 429:./ucos/Core/os_q.c **** *                            if 'pevent' is a NULL pointer or,
 430:./ucos/Core/os_q.c **** *                            if you didn't pass a pointer to a queue.
 431:./ucos/Core/os_q.c **** *
 432:./ucos/Core/os_q.c **** * Note(s)    : As of V2.60, this function allows you to receive NULL pointer messages.
 433:./ucos/Core/os_q.c **** ***************************************************************************************************
 434:./ucos/Core/os_q.c **** */
