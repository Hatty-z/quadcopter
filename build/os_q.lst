 195:./ucos/Core/os_q.c **** /*
 196:./ucos/Core/os_q.c **** ***************************************************************************************************
 197:./ucos/Core/os_q.c **** *                                       DELETE A MESSAGE QUEUE
 198:./ucos/Core/os_q.c **** *
 199:./ucos/Core/os_q.c **** * Description: This function deletes a message queue and readies all tasks pending on the queue.
 200:./ucos/Core/os_q.c **** *
 201:./ucos/Core/os_q.c **** * Arguments  : pevent        is a pointer to the event control block associated with the desired
 202:./ucos/Core/os_q.c **** *                            queue.
 203:./ucos/Core/os_q.c **** *
 204:./ucos/Core/os_q.c **** *              opt           determines delete options as follows:
 205:./ucos/Core/os_q.c **** *                            opt == OS_DEL_NO_PEND   Delete the queue ONLY if no task pending
 206:./ucos/Core/os_q.c **** *                            opt == OS_DEL_ALWAYS    Deletes the queue even if tasks are waiting.
 207:./ucos/Core/os_q.c **** *                                                    In this case, all the tasks pending will be re
 208:./ucos/Core/os_q.c **** *
 209:./ucos/Core/os_q.c **** *              perr          is a pointer to an error code that can contain one of the following va
 210:./ucos/Core/os_q.c **** *                            OS_ERR_NONE                  The call was successful and the queue was
 211:./ucos/Core/os_q.c **** *                            OS_ERR_DEL_ISR               If you tried to delete the queue from an 
ARM GAS  /tmp/ccz2mqua.s 			page 11


 212:./ucos/Core/os_q.c **** *                            OS_ERR_ILLEGAL_DEL_RUN_TIME  If you tried to delete the queue after sa
 213:./ucos/Core/os_q.c **** *                                                         critical operation started.
 214:./ucos/Core/os_q.c **** *                            OS_ERR_INVALID_OPT           An invalid option was specified
 215:./ucos/Core/os_q.c **** *                            OS_ERR_TASK_WAITING          One or more tasks were waiting on the que
 216:./ucos/Core/os_q.c **** *                            OS_ERR_EVENT_TYPE            If you didn't pass a pointer to a queue
 217:./ucos/Core/os_q.c **** *                            OS_ERR_PEVENT_NULL           If 'pevent' is a NULL pointer.
 218:./ucos/Core/os_q.c **** *
 219:./ucos/Core/os_q.c **** * Returns    : pevent        upon error
 220:./ucos/Core/os_q.c **** *              (OS_EVENT *)0 if the queue was successfully deleted.
 221:./ucos/Core/os_q.c **** *
 222:./ucos/Core/os_q.c **** * Note(s)    : 1) This function must be used with care.  Tasks that would normally expect the prese
 223:./ucos/Core/os_q.c **** *                 the queue MUST check the return code of OSQPend().
 224:./ucos/Core/os_q.c **** *              2) OSQAccept() callers will not know that the intended queue has been deleted unless
 225:./ucos/Core/os_q.c **** *                 they check 'pevent' to see that it's a NULL pointer.
 226:./ucos/Core/os_q.c **** *              3) This call can potentially disable interrupts for a long time.  The interrupt disa
 227:./ucos/Core/os_q.c **** *                 time is directly proportional to the number of tasks waiting on the queue.
 228:./ucos/Core/os_q.c **** *              4) Because ALL tasks pending on the queue will be readied, you MUST be careful in
 229:./ucos/Core/os_q.c **** *                 applications where the queue is used for mutual exclusion because the resource(s)
 230:./ucos/Core/os_q.c **** *                 will no longer be guarded by the queue.
 231:./ucos/Core/os_q.c **** *              5) If the storage for the message queue was allocated dynamically (i.e. using a mall
 232:./ucos/Core/os_q.c **** *                 type call) then your application MUST release the memory storage by call the coun
 233:./ucos/Core/os_q.c **** *                 call of the dynamic allocation scheme used.  If the queue storage was created sta
 234:./ucos/Core/os_q.c **** *                 then, the storage can be reused.
 235:./ucos/Core/os_q.c **** *              6) All tasks that were waiting for the queue will be readied and returned an
 236:./ucos/Core/os_q.c **** *                 OS_ERR_PEND_ABORT if OSQDel() was called with OS_DEL_ALWAYS
 237:./ucos/Core/os_q.c **** ***************************************************************************************************
 238:./ucos/Core/os_q.c **** */
 239:./ucos/Core/os_q.c **** 
