 117:./ucos/Core/os_q.c **** /*
 118:./ucos/Core/os_q.c **** ***************************************************************************************************
 119:./ucos/Core/os_q.c **** *                                       CREATE A MESSAGE QUEUE
 120:./ucos/Core/os_q.c **** *
 121:./ucos/Core/os_q.c **** * Description: This function creates a message queue if free event control blocks are available.
 122:./ucos/Core/os_q.c **** *
 123:./ucos/Core/os_q.c **** * Arguments  : start         is a pointer to the base address of the message queue storage area.  T
 124:./ucos/Core/os_q.c **** *                            storage area MUST be declared as an array of pointers to 'void' as fol
 125:./ucos/Core/os_q.c **** *
 126:./ucos/Core/os_q.c **** *                            void *MessageStorage[size]
 127:./ucos/Core/os_q.c **** *
 128:./ucos/Core/os_q.c **** *              size          is the number of elements in the storage area
 129:./ucos/Core/os_q.c **** *
 130:./ucos/Core/os_q.c **** * Returns    : != (OS_EVENT *)0  is a pointer to the event control clock (OS_EVENT) associated with
 131:./ucos/Core/os_q.c **** *                                created queue
 132:./ucos/Core/os_q.c **** *              == (OS_EVENT *)0  if no event control blocks were available or an error was detected
 133:./ucos/Core/os_q.c **** ***************************************************************************************************
 134:./ucos/Core/os_q.c **** */
