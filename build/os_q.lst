 529:./ucos/Core/os_q.c **** 
 530:./ucos/Core/os_q.c **** 
 531:./ucos/Core/os_q.c **** /*
 532:./ucos/Core/os_q.c **** ***************************************************************************************************
 533:./ucos/Core/os_q.c **** *                                  ABORT WAITING ON A MESSAGE QUEUE
 534:./ucos/Core/os_q.c **** *
 535:./ucos/Core/os_q.c **** * Description: This function aborts & readies any tasks currently waiting on a queue.  This functio
 536:./ucos/Core/os_q.c **** *              should be used to fault-abort the wait on the queue, rather than to normally signal
 537:./ucos/Core/os_q.c **** *              the queue via OSQPost(), OSQPostFront() or OSQPostOpt().
 538:./ucos/Core/os_q.c **** *
 539:./ucos/Core/os_q.c **** * Arguments  : pevent        is a pointer to the event control block associated with the desired qu
 540:./ucos/Core/os_q.c **** *
 541:./ucos/Core/os_q.c **** *              opt           determines the type of ABORT performed:
 542:./ucos/Core/os_q.c **** *                            OS_PEND_OPT_NONE         ABORT wait for a single task (HPT) waiting on
 543:./ucos/Core/os_q.c **** *                                                     queue
 544:./ucos/Core/os_q.c **** *                            OS_PEND_OPT_BROADCAST    ABORT wait for ALL tasks that are  waiting on
 545:./ucos/Core/os_q.c **** *                                                     queue
 546:./ucos/Core/os_q.c **** *
 547:./ucos/Core/os_q.c **** *              perr          is a pointer to where an error message will be deposited.  Possible er
 548:./ucos/Core/os_q.c **** *                            messages are:
 549:./ucos/Core/os_q.c **** *
 550:./ucos/Core/os_q.c **** *                            OS_ERR_NONE         No tasks were     waiting on the queue.
 551:./ucos/Core/os_q.c **** *                            OS_ERR_PEND_ABORT   At least one task waiting on the queue was readied
 552:./ucos/Core/os_q.c **** *                                                and informed of the aborted wait; check return val
 553:./ucos/Core/os_q.c **** *                                                for the number of tasks whose wait on the queue
 554:./ucos/Core/os_q.c **** *                                                was aborted.
 555:./ucos/Core/os_q.c **** *                            OS_ERR_EVENT_TYPE   If you didn't pass a pointer to a queue.
 556:./ucos/Core/os_q.c **** *                            OS_ERR_PEVENT_NULL  If 'pevent' is a NULL pointer.
 557:./ucos/Core/os_q.c **** *
 558:./ucos/Core/os_q.c **** * Returns    : == 0          if no tasks were waiting on the queue, or upon error.
 559:./ucos/Core/os_q.c **** *              >  0          if one or more tasks waiting on the queue are now readied and informed
 560:./ucos/Core/os_q.c **** ***************************************************************************************************
 561:./ucos/Core/os_q.c **** */
 562:./ucos/Core/os_q.c **** 
 563:./ucos/Core/os_q.c **** #if OS_Q_PEND_ABORT_EN > 0u
 564:./ucos/Core/os_q.c **** INT8U  OSQPendAbort (OS_EVENT  *pevent,
 565:./ucos/Core/os_q.c ****                      INT8U      opt,
 566:./ucos/Core/os_q.c ****                      INT8U     *perr)
