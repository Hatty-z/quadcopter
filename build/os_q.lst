 690:./ucos/Core/os_q.c **** /*
 691:./ucos/Core/os_q.c **** ***************************************************************************************************
 692:./ucos/Core/os_q.c **** *                                POST MESSAGE TO THE FRONT OF A QUEUE
 693:./ucos/Core/os_q.c **** *
 694:./ucos/Core/os_q.c **** * Description: This function sends a message to a queue but unlike OSQPost(), the message is posted
 695:./ucos/Core/os_q.c **** *              the front instead of the end of the queue.  Using OSQPostFront() allows you to send
 696:./ucos/Core/os_q.c **** *              'priority' messages.
 697:./ucos/Core/os_q.c **** *
 698:./ucos/Core/os_q.c **** * Arguments  : pevent        is a pointer to the event control block associated with the desired qu
 699:./ucos/Core/os_q.c **** *
 700:./ucos/Core/os_q.c **** *              pmsg          is a pointer to the message to send.
 701:./ucos/Core/os_q.c **** *
 702:./ucos/Core/os_q.c **** * Returns    : OS_ERR_NONE           The call was successful and the message was sent
 703:./ucos/Core/os_q.c **** *              OS_ERR_Q_FULL         If the queue cannot accept any more messages because it is ful
 704:./ucos/Core/os_q.c **** *              OS_ERR_EVENT_TYPE     If you didn't pass a pointer to a queue.
 705:./ucos/Core/os_q.c **** *              OS_ERR_PEVENT_NULL    If 'pevent' is a NULL pointer
 706:./ucos/Core/os_q.c **** *
ARM GAS  /tmp/ccz2mqua.s 			page 43


 707:./ucos/Core/os_q.c **** * Note(s)    : As of V2.60, this function allows you to send NULL pointer messages.
 708:./ucos/Core/os_q.c **** ***************************************************************************************************
