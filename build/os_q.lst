 762:./ucos/Core/os_q.c **** /*
 763:./ucos/Core/os_q.c **** ***************************************************************************************************
 764:./ucos/Core/os_q.c **** *                                       POST MESSAGE TO A QUEUE
 765:./ucos/Core/os_q.c **** *
 766:./ucos/Core/os_q.c **** * Description: This function sends a message to a queue.  This call has been added to reduce code s
 767:./ucos/Core/os_q.c **** *              since it can replace both OSQPost() and OSQPostFront().  Also, this function adds th
 768:./ucos/Core/os_q.c **** *              capability to broadcast a message to ALL tasks waiting on the message queue.
 769:./ucos/Core/os_q.c **** *
 770:./ucos/Core/os_q.c **** * Arguments  : pevent        is a pointer to the event control block associated with the desired qu
 771:./ucos/Core/os_q.c **** *
 772:./ucos/Core/os_q.c **** *              pmsg          is a pointer to the message to send.
 773:./ucos/Core/os_q.c **** *
 774:./ucos/Core/os_q.c **** *              opt           determines the type of POST performed:
 775:./ucos/Core/os_q.c **** *                            OS_POST_OPT_NONE         POST to a single waiting task
 776:./ucos/Core/os_q.c **** *                                                     (Identical to OSQPost())
 777:./ucos/Core/os_q.c **** *                            OS_POST_OPT_BROADCAST    POST to ALL tasks that are waiting on the que
 778:./ucos/Core/os_q.c **** *                            OS_POST_OPT_FRONT        POST as LIFO (Simulates OSQPostFront())
 779:./ucos/Core/os_q.c **** *                            OS_POST_OPT_NO_SCHED     Indicates that the scheduler will NOT be invo
 780:./ucos/Core/os_q.c **** *
 781:./ucos/Core/os_q.c **** * Returns    : OS_ERR_NONE           The call was successful and the message was sent
 782:./ucos/Core/os_q.c **** *              OS_ERR_Q_FULL         If the queue cannot accept any more messages because it is ful
 783:./ucos/Core/os_q.c **** *              OS_ERR_EVENT_TYPE     If you didn't pass a pointer to a queue.
 784:./ucos/Core/os_q.c **** *              OS_ERR_PEVENT_NULL    If 'pevent' is a NULL pointer
 785:./ucos/Core/os_q.c **** *
 786:./ucos/Core/os_q.c **** * Warning    : Interrupts can be disabled for a long time if you do a 'broadcast'.  In fact, the
 787:./ucos/Core/os_q.c **** *              interrupt disable time is proportional to the number of tasks waiting on the queue.
 788:./ucos/Core/os_q.c **** ***************************************************************************************************
 789:./ucos/Core/os_q.c **** */
 790:./ucos/Core/os_q.c **** 
