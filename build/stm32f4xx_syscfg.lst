  64:./Libraries/src/stm32f4xx_syscfg.c **** /* ------------ RCC registers bit address in the alias region ----------- */
  65:./Libraries/src/stm32f4xx_syscfg.c **** #define SYSCFG_OFFSET             (SYSCFG_BASE - PERIPH_BASE)
  66:./Libraries/src/stm32f4xx_syscfg.c **** /* ---  MEMRMP Register ---*/ 
  67:./Libraries/src/stm32f4xx_syscfg.c **** /* Alias word address of UFB_MODE bit */ 
  68:./Libraries/src/stm32f4xx_syscfg.c **** #define MEMRMP_OFFSET             SYSCFG_OFFSET 
  69:./Libraries/src/stm32f4xx_syscfg.c **** #define UFB_MODE_BitNumber        ((uint8_t)0x8) 
  70:./Libraries/src/stm32f4xx_syscfg.c **** #define UFB_MODE_BB               (PERIPH_BB_BASE + (MEMRMP_OFFSET * 32) + (UFB_MODE_BitNumber * 4)
  71:./Libraries/src/stm32f4xx_syscfg.c ****     
  72:./Libraries/src/stm32f4xx_syscfg.c **** /* ---  PMC Register ---*/ 
  73:./Libraries/src/stm32f4xx_syscfg.c **** /* Alias word address of MII_RMII_SEL bit */ 
  74:./Libraries/src/stm32f4xx_syscfg.c **** #define PMC_OFFSET                (SYSCFG_OFFSET + 0x04) 
  75:./Libraries/src/stm32f4xx_syscfg.c **** #define MII_RMII_SEL_BitNumber    ((uint8_t)0x17) 
  76:./Libraries/src/stm32f4xx_syscfg.c **** #define PMC_MII_RMII_SEL_BB       (PERIPH_BB_BASE + (PMC_OFFSET * 32) + (MII_RMII_SEL_BitNumber * 4
  77:./Libraries/src/stm32f4xx_syscfg.c ****     
  78:./Libraries/src/stm32f4xx_syscfg.c **** /* ---  CMPCR Register ---*/ 
  79:./Libraries/src/stm32f4xx_syscfg.c **** /* Alias word address of CMP_PD bit */ 
  80:./Libraries/src/stm32f4xx_syscfg.c **** #define CMPCR_OFFSET              (SYSCFG_OFFSET + 0x20) 
  81:./Libraries/src/stm32f4xx_syscfg.c **** #define CMP_PD_BitNumber          ((uint8_t)0x00) 
  82:./Libraries/src/stm32f4xx_syscfg.c **** #define CMPCR_CMP_PD_BB           (PERIPH_BB_BASE + (CMPCR_OFFSET * 32) + (CMP_PD_BitNumber * 4)) 
