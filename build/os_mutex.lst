  59:./ucos/Core/os_mutex.c **** /*
  60:./ucos/Core/os_mutex.c **** ***************************************************************************************************
  61:./ucos/Core/os_mutex.c **** *                                  ACCEPT MUTUAL EXCLUSION SEMAPHORE
  62:./ucos/Core/os_mutex.c **** *
  63:./ucos/Core/os_mutex.c **** * Description: This  function checks the mutual exclusion semaphore to see if a resource is availab
  64:./ucos/Core/os_mutex.c **** *              Unlike OSMutexPend(), OSMutexAccept() does not suspend the calling task if the resou
  65:./ucos/Core/os_mutex.c **** *              not available or the event did not occur.
  66:./ucos/Core/os_mutex.c **** *
  67:./ucos/Core/os_mutex.c **** * Arguments  : pevent     is a pointer to the event control block
  68:./ucos/Core/os_mutex.c **** *
  69:./ucos/Core/os_mutex.c **** *              perr       is a pointer to an error code which will be returned to your application:
  70:./ucos/Core/os_mutex.c **** *                            OS_ERR_NONE         if the call was successful.
  71:./ucos/Core/os_mutex.c **** *                            OS_ERR_EVENT_TYPE   if 'pevent' is not a pointer to a mutex
  72:./ucos/Core/os_mutex.c **** *                            OS_ERR_PEVENT_NULL  'pevent' is a NULL pointer
  73:./ucos/Core/os_mutex.c **** *                            OS_ERR_PEND_ISR     if you called this function from an ISR
  74:./ucos/Core/os_mutex.c **** *                            OS_ERR_PCP_LOWER    If the priority of the task that owns the Mutex is
  75:./ucos/Core/os_mutex.c **** *                                                HIGHER (i.e. a lower number) than the PCP.  This e
  76:./ucos/Core/os_mutex.c **** *                                                indicates that you did not set the PCP higher (low
  77:./ucos/Core/os_mutex.c **** *                                                number) than ALL the tasks that compete for the Mu
  78:./ucos/Core/os_mutex.c **** *                                                Unfortunately, this is something that could not be
  79:./ucos/Core/os_mutex.c **** *                                                detected when the Mutex is created because we don'
  80:./ucos/Core/os_mutex.c **** *                                                what tasks will be using the Mutex.
  81:./ucos/Core/os_mutex.c **** *
  82:./ucos/Core/os_mutex.c **** * Returns    : == OS_TRUE    if the resource is available, the mutual exclusion semaphore is acquir
  83:./ucos/Core/os_mutex.c **** *              == OS_FALSE   a) if the resource is not available
  84:./ucos/Core/os_mutex.c **** *                            b) you didn't pass a pointer to a mutual exclusion semaphore
  85:./ucos/Core/os_mutex.c **** *                            c) you called this function from an ISR
  86:./ucos/Core/os_mutex.c **** *
  87:./ucos/Core/os_mutex.c **** * Warning(s) : This function CANNOT be called from an ISR because mutual exclusion semaphores are
ARM GAS  /tmp/ccMlMuy7.s 			page 3


  88:./ucos/Core/os_mutex.c **** *              intended to be used by tasks only.
  89:./ucos/Core/os_mutex.c **** ***************************************************************************************************
  90:./ucos/Core/os_mutex.c **** */
  91:./ucos/Core/os_mutex.c **** 
  92:./ucos/Core/os_mutex.c **** #if OS_MUTEX_ACCEPT_EN > 0u
  93:./ucos/Core/os_mutex.c **** BOOLEAN  OSMutexAccept (OS_EVENT  *pevent,
  94:./ucos/Core/os_mutex.c ****                         INT8U     *perr)
  95:./ucos/Core/os_mutex.c **** {
  96:./ucos/Core/os_mutex.c ****     INT8U      pcp;                                    /* Priority Ceiling Priority (PCP)          
  97:./ucos/Core/os_mutex.c **** #if OS_CRITICAL_METHOD == 3u                           /* Allocate storage for CPU status register 
  98:./ucos/Core/os_mutex.c ****     OS_CPU_SR  cpu_sr = 0u;
  99:./ucos/Core/os_mutex.c **** #endif
 100:./ucos/Core/os_mutex.c **** 
 101:./ucos/Core/os_mutex.c **** 
 102:./ucos/Core/os_mutex.c **** 
 103:./ucos/Core/os_mutex.c **** #ifdef OS_SAFETY_CRITICAL
 104:./ucos/Core/os_mutex.c ****     if (perr == (INT8U *)0) {
 105:./ucos/Core/os_mutex.c ****         OS_SAFETY_CRITICAL_EXCEPTION();
 106:./ucos/Core/os_mutex.c ****         return (OS_FALSE);
 107:./ucos/Core/os_mutex.c ****     }
 108:./ucos/Core/os_mutex.c **** #endif
 109:./ucos/Core/os_mutex.c **** 
 110:./ucos/Core/os_mutex.c **** #if OS_ARG_CHK_EN > 0u
 111:./ucos/Core/os_mutex.c ****     if (pevent == (OS_EVENT *)0) {                     /* Validate 'pevent'                        
 112:./ucos/Core/os_mutex.c ****         *perr = OS_ERR_PEVENT_NULL;
 113:./ucos/Core/os_mutex.c ****         return (OS_FALSE);
 114:./ucos/Core/os_mutex.c ****     }
 115:./ucos/Core/os_mutex.c **** #endif
 116:./ucos/Core/os_mutex.c ****     if (pevent->OSEventType != OS_EVENT_TYPE_MUTEX) {  /* Validate event block type                
 117:./ucos/Core/os_mutex.c ****         *perr = OS_ERR_EVENT_TYPE;
 118:./ucos/Core/os_mutex.c ****         return (OS_FALSE);
 119:./ucos/Core/os_mutex.c ****     }
 120:./ucos/Core/os_mutex.c ****     if (OSIntNesting > 0u) {                           /* Make sure it's not called from an ISR    
 121:./ucos/Core/os_mutex.c ****         *perr = OS_ERR_PEND_ISR;
 122:./ucos/Core/os_mutex.c ****         return (OS_FALSE);
 123:./ucos/Core/os_mutex.c ****     }
 124:./ucos/Core/os_mutex.c ****     OS_ENTER_CRITICAL();                               /* Get value (0 or 1) of Mutex              
 125:./ucos/Core/os_mutex.c ****     pcp = (INT8U)(pevent->OSEventCnt >> 8u);           /* Get PCP from mutex                       
 126:./ucos/Core/os_mutex.c ****     if ((pevent->OSEventCnt & OS_MUTEX_KEEP_LOWER_8) == OS_MUTEX_AVAILABLE) {
 127:./ucos/Core/os_mutex.c ****         pevent->OSEventCnt &= OS_MUTEX_KEEP_UPPER_8;   /*      Mask off LSByte (Acquire Mutex)     
 128:./ucos/Core/os_mutex.c ****         pevent->OSEventCnt |= (INT16U)OSTCBCur->OSTCBPrio;  /* Save current task priority in LSByte
 129:./ucos/Core/os_mutex.c ****         pevent->OSEventPtr  = (void *)OSTCBCur;        /*      Link TCB of task owning Mutex       
 130:./ucos/Core/os_mutex.c ****         if ((pcp != OS_PRIO_MUTEX_CEIL_DIS) &&
 131:./ucos/Core/os_mutex.c ****             (OSTCBCur->OSTCBPrio <= pcp)) {            /*      PCP 'must' have a SMALLER prio ...  
 132:./ucos/Core/os_mutex.c ****              OS_EXIT_CRITICAL();                       /*      ... than current task!              
 133:./ucos/Core/os_mutex.c ****             *perr = OS_ERR_PCP_LOWER;
 134:./ucos/Core/os_mutex.c ****         } else {
 135:./ucos/Core/os_mutex.c ****              OS_EXIT_CRITICAL();
 136:./ucos/Core/os_mutex.c ****             *perr = OS_ERR_NONE;
 137:./ucos/Core/os_mutex.c ****         }
 138:./ucos/Core/os_mutex.c ****         return (OS_TRUE);
 139:./ucos/Core/os_mutex.c ****     }
 140:./ucos/Core/os_mutex.c ****     OS_EXIT_CRITICAL();
 141:./ucos/Core/os_mutex.c ****     *perr = OS_ERR_NONE;
 142:./ucos/Core/os_mutex.c ****     return (OS_FALSE);
 143:./ucos/Core/os_mutex.c **** }
 144:./ucos/Core/os_mutex.c **** #endif
