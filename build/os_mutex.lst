 147:./ucos/Core/os_mutex.c **** /*
 148:./ucos/Core/os_mutex.c **** ***************************************************************************************************
 149:./ucos/Core/os_mutex.c **** *                                 CREATE A MUTUAL EXCLUSION SEMAPHORE
 150:./ucos/Core/os_mutex.c **** *
 151:./ucos/Core/os_mutex.c **** * Description: This function creates a mutual exclusion semaphore.
 152:./ucos/Core/os_mutex.c **** *
 153:./ucos/Core/os_mutex.c **** * Arguments  : prio          is the priority to use when accessing the mutual exclusion semaphore. 
 154:./ucos/Core/os_mutex.c **** *                            other words, when the semaphore is acquired and a higher priority task
 155:./ucos/Core/os_mutex.c **** *                            attempts to obtain the semaphore then the priority of the task owning 
 156:./ucos/Core/os_mutex.c **** *                            semaphore is raised to this priority.  It is assumed that you will spe
 157:./ucos/Core/os_mutex.c **** *                            a priority that is LOWER in value than ANY of the tasks competing for 
 158:./ucos/Core/os_mutex.c **** *                            mutex. If the priority is specified as OS_PRIO_MUTEX_CEIL_DIS, then th
 159:./ucos/Core/os_mutex.c **** *                            priority ceiling promotion is disabled. This way, the tasks accessing 
 160:./ucos/Core/os_mutex.c **** *                            semaphore do not have their priority promoted.
 161:./ucos/Core/os_mutex.c **** *
 162:./ucos/Core/os_mutex.c **** *              perr          is a pointer to an error code which will be returned to your applicati
 163:./ucos/Core/os_mutex.c **** *                               OS_ERR_NONE                     if the call was successful.
 164:./ucos/Core/os_mutex.c **** *                               OS_ERR_CREATE_ISR               if you attempted to create a MUTEX 
 165:./ucos/Core/os_mutex.c **** *                                                               ISR
 166:./ucos/Core/os_mutex.c **** *                               OS_ERR_ILLEGAL_CREATE_RUN_TIME  if you tried to create a mutex afte
 167:./ucos/Core/os_mutex.c **** *                                                               safety critical operation started.
 168:./ucos/Core/os_mutex.c **** *                               OS_ERR_PRIO_EXIST               if a task at the priority ceiling p
 169:./ucos/Core/os_mutex.c **** *                                                               already exist.
 170:./ucos/Core/os_mutex.c **** *                               OS_ERR_PEVENT_NULL              No more event control blocks availa
 171:./ucos/Core/os_mutex.c **** *                               OS_ERR_PRIO_INVALID             if the priority you specify is high
 172:./ucos/Core/os_mutex.c **** *                                                               the maximum allowed (i.e. > OS_LOWE
 173:./ucos/Core/os_mutex.c **** *
 174:./ucos/Core/os_mutex.c **** * Returns    : != (void *)0  is a pointer to the event control clock (OS_EVENT) associated with the
 175:./ucos/Core/os_mutex.c **** *                            created mutex.
 176:./ucos/Core/os_mutex.c **** *              == (void *)0  if an error is detected.
 177:./ucos/Core/os_mutex.c **** *
 178:./ucos/Core/os_mutex.c **** * Note(s)    : 1) The LEAST significant 8 bits of '.OSEventCnt' hold the priority number of the tas
 179:./ucos/Core/os_mutex.c **** *                 owning the mutex or 0xFF if no task owns the mutex.
 180:./ucos/Core/os_mutex.c **** *
 181:./ucos/Core/os_mutex.c **** *              2) The MOST  significant 8 bits of '.OSEventCnt' hold the priority number used to
 182:./ucos/Core/os_mutex.c **** *                 reduce priority inversion or 0xFF (OS_PRIO_MUTEX_CEIL_DIS) if priority ceiling
 183:./ucos/Core/os_mutex.c **** *                 promotion is disabled.
 184:./ucos/Core/os_mutex.c **** ***************************************************************************************************
 185:./ucos/Core/os_mutex.c **** */
 186:./ucos/Core/os_mutex.c **** 
 187:./ucos/Core/os_mutex.c **** OS_EVENT  *OSMutexCreate (INT8U   prio,
 188:./ucos/Core/os_mutex.c ****                           INT8U  *perr)
 189:./ucos/Core/os_mutex.c **** {
 190:./ucos/Core/os_mutex.c ****     OS_EVENT  *pevent;
 191:./ucos/Core/os_mutex.c **** #if OS_CRITICAL_METHOD == 3u                               /* Allocate storage for CPU status regis
 192:./ucos/Core/os_mutex.c ****     OS_CPU_SR  cpu_sr = 0u;
 193:./ucos/Core/os_mutex.c **** #endif
 194:./ucos/Core/os_mutex.c **** 
 195:./ucos/Core/os_mutex.c **** 
 196:./ucos/Core/os_mutex.c **** 
 197:./ucos/Core/os_mutex.c **** #ifdef OS_SAFETY_CRITICAL
 198:./ucos/Core/os_mutex.c ****     if (perr == (INT8U *)0) {
 199:./ucos/Core/os_mutex.c ****         OS_SAFETY_CRITICAL_EXCEPTION();
 200:./ucos/Core/os_mutex.c ****         return ((OS_EVENT *)0);
 201:./ucos/Core/os_mutex.c ****     }
ARM GAS  /tmp/ccMlMuy7.s 			page 5


 202:./ucos/Core/os_mutex.c **** #endif
 203:./ucos/Core/os_mutex.c **** 
 204:./ucos/Core/os_mutex.c **** #ifdef OS_SAFETY_CRITICAL_IEC61508
 205:./ucos/Core/os_mutex.c ****     if (OSSafetyCriticalStartFlag == OS_TRUE) {
 206:./ucos/Core/os_mutex.c ****         OS_SAFETY_CRITICAL_EXCEPTION();
 207:./ucos/Core/os_mutex.c ****         *perr = OS_ERR_ILLEGAL_CREATE_RUN_TIME;
 208:./ucos/Core/os_mutex.c ****         return ((OS_EVENT *)0);
 209:./ucos/Core/os_mutex.c ****     }
 210:./ucos/Core/os_mutex.c **** #endif
 211:./ucos/Core/os_mutex.c **** 
 212:./ucos/Core/os_mutex.c **** #if OS_ARG_CHK_EN > 0u
 213:./ucos/Core/os_mutex.c ****     if (prio != OS_PRIO_MUTEX_CEIL_DIS) {
 214:./ucos/Core/os_mutex.c ****         if (prio >= OS_LOWEST_PRIO) {                      /* Validate PCP                         
 215:./ucos/Core/os_mutex.c ****            *perr = OS_ERR_PRIO_INVALID;
 216:./ucos/Core/os_mutex.c ****             return ((OS_EVENT *)0);
 217:./ucos/Core/os_mutex.c ****         }
 218:./ucos/Core/os_mutex.c ****     }
 219:./ucos/Core/os_mutex.c **** #endif
 220:./ucos/Core/os_mutex.c ****     if (OSIntNesting > 0u) {                               /* See if called from ISR ...           
 221:./ucos/Core/os_mutex.c ****         *perr = OS_ERR_CREATE_ISR;                         /* ... can't CREATE mutex from an ISR   
 222:./ucos/Core/os_mutex.c ****         return ((OS_EVENT *)0);
 223:./ucos/Core/os_mutex.c ****     }
 224:./ucos/Core/os_mutex.c ****     OS_ENTER_CRITICAL();
 225:./ucos/Core/os_mutex.c ****     if (prio != OS_PRIO_MUTEX_CEIL_DIS) {
 226:./ucos/Core/os_mutex.c ****         if (OSTCBPrioTbl[prio] != (OS_TCB *)0) {           /* Mutex priority must not already exist
 227:./ucos/Core/os_mutex.c ****             OS_EXIT_CRITICAL();                            /* Task already exist at priority ...   
 228:./ucos/Core/os_mutex.c ****            *perr = OS_ERR_PRIO_EXIST;                      /* ... ceiling priority                 
 229:./ucos/Core/os_mutex.c ****             return ((OS_EVENT *)0);
 230:./ucos/Core/os_mutex.c ****         }
 231:./ucos/Core/os_mutex.c ****         OSTCBPrioTbl[prio] = OS_TCB_RESERVED;              /* Reserve the table entry              
 232:./ucos/Core/os_mutex.c ****     }
 233:./ucos/Core/os_mutex.c **** 
 234:./ucos/Core/os_mutex.c ****     pevent = OSEventFreeList;                              /* Get next free event control block    
 235:./ucos/Core/os_mutex.c ****     if (pevent == (OS_EVENT *)0) {                         /* See if an ECB was available          
 236:./ucos/Core/os_mutex.c ****         if (prio != OS_PRIO_MUTEX_CEIL_DIS) {
 237:./ucos/Core/os_mutex.c ****             OSTCBPrioTbl[prio] = (OS_TCB *)0;              /* No, Release the table entry          
 238:./ucos/Core/os_mutex.c ****         }
 239:./ucos/Core/os_mutex.c ****         OS_EXIT_CRITICAL();
 240:./ucos/Core/os_mutex.c ****        *perr = OS_ERR_PEVENT_NULL;                         /* No more event control blocks         
 241:./ucos/Core/os_mutex.c ****         return (pevent);
 242:./ucos/Core/os_mutex.c ****     }
 243:./ucos/Core/os_mutex.c ****     OSEventFreeList     = (OS_EVENT *)OSEventFreeList->OSEventPtr; /* Adjust the free list         
 244:./ucos/Core/os_mutex.c ****     OS_EXIT_CRITICAL();
 245:./ucos/Core/os_mutex.c ****     pevent->OSEventType = OS_EVENT_TYPE_MUTEX;
 246:./ucos/Core/os_mutex.c ****     pevent->OSEventCnt  = (INT16U)((INT16U)prio << 8u) | OS_MUTEX_AVAILABLE; /* Resource is avail. 
 247:./ucos/Core/os_mutex.c ****     pevent->OSEventPtr  = (void *)0;                       /* No task owning the mutex             
 248:./ucos/Core/os_mutex.c **** #if OS_EVENT_NAME_EN > 0u
 249:./ucos/Core/os_mutex.c ****     pevent->OSEventName = (INT8U *)(void *)"?";
 250:./ucos/Core/os_mutex.c **** #endif
 251:./ucos/Core/os_mutex.c ****     OS_EventWaitListInit(pevent);
 252:./ucos/Core/os_mutex.c ****     OS_TRACE_MUTEX_CREATE(pevent, pevent->OSEventName);
 253:./ucos/Core/os_mutex.c ****    *perr = OS_ERR_NONE;
 254:./ucos/Core/os_mutex.c ****     return (pevent);
 255:./ucos/Core/os_mutex.c **** }
