 258:./ucos/Core/os_mutex.c **** /*
ARM GAS  /tmp/ccMlMuy7.s 			page 6


 259:./ucos/Core/os_mutex.c **** ***************************************************************************************************
 260:./ucos/Core/os_mutex.c **** *                                           DELETE A MUTEX
 261:./ucos/Core/os_mutex.c **** *
 262:./ucos/Core/os_mutex.c **** * Description: This function deletes a mutual exclusion semaphore and readies all tasks pending on 
 263:./ucos/Core/os_mutex.c **** *
 264:./ucos/Core/os_mutex.c **** * Arguments  : pevent        is a pointer to the event control block associated with the desired mu
 265:./ucos/Core/os_mutex.c **** *
 266:./ucos/Core/os_mutex.c **** *              opt           determines delete options as follows:
 267:./ucos/Core/os_mutex.c **** *                            opt == OS_DEL_NO_PEND   Delete mutex ONLY if no task pending
 268:./ucos/Core/os_mutex.c **** *                            opt == OS_DEL_ALWAYS    Deletes the mutex even if tasks are waiting.
 269:./ucos/Core/os_mutex.c **** *                                                    In this case, all the tasks pending will be re
 270:./ucos/Core/os_mutex.c **** *
 271:./ucos/Core/os_mutex.c **** *              perr          is a pointer to an error code that can contain one of the following va
 272:./ucos/Core/os_mutex.c **** *                            OS_ERR_NONE                  The call was successful and the mutex was
 273:./ucos/Core/os_mutex.c **** *                            OS_ERR_DEL_ISR               If you attempted to delete the MUTEX from
 274:./ucos/Core/os_mutex.c **** *                            OS_ERR_INVALID_OPT           An invalid option was specified
 275:./ucos/Core/os_mutex.c **** *                            OS_ERR_ILLEGAL_DEL_RUN_TIME  If you tried to delete a mutex after safe
 276:./ucos/Core/os_mutex.c **** *                                                         critical operation started.
