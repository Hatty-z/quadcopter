 985:./Libraries/src/stm32f4xx_usart.c **** /** @defgroup USART_Group7 IrDA mode functions
 986:./Libraries/src/stm32f4xx_usart.c ****  *  @brief   IrDA mode functions 
 987:./Libraries/src/stm32f4xx_usart.c ****  *
 988:./Libraries/src/stm32f4xx_usart.c **** @verbatim   
 989:./Libraries/src/stm32f4xx_usart.c ****  ===============================================================================
 990:./Libraries/src/stm32f4xx_usart.c ****                         ##### IrDA mode functions #####
 991:./Libraries/src/stm32f4xx_usart.c ****  ===============================================================================  
 992:./Libraries/src/stm32f4xx_usart.c ****     [..]
 993:./Libraries/src/stm32f4xx_usart.c ****     This subsection provides a set of functions allowing to manage the USART 
 994:./Libraries/src/stm32f4xx_usart.c ****     IrDA communication.
 995:./Libraries/src/stm32f4xx_usart.c ****     [..]
 996:./Libraries/src/stm32f4xx_usart.c ****     IrDA is a half duplex communication protocol. If the Transmitter is busy, any data
 997:./Libraries/src/stm32f4xx_usart.c ****     on the IrDA receive line will be ignored by the IrDA decoder and if the Receiver 
 998:./Libraries/src/stm32f4xx_usart.c ****     is busy, data on the TX from the USART to IrDA will not be encoded by IrDA.
 999:./Libraries/src/stm32f4xx_usart.c ****     While receiving data, transmission should be avoided as the data to be transmitted
1000:./Libraries/src/stm32f4xx_usart.c ****     could be corrupted.
1001:./Libraries/src/stm32f4xx_usart.c ****     [..]
1002:./Libraries/src/stm32f4xx_usart.c ****     IrDA communication is possible through the following procedure:
1003:./Libraries/src/stm32f4xx_usart.c ****       (#) Program the Baud rate, Word length = 8 bits, Stop bits, Parity, Transmitter/Receiver 
1004:./Libraries/src/stm32f4xx_usart.c ****           modes and hardware flow control values using the USART_Init() function.
1005:./Libraries/src/stm32f4xx_usart.c ****       (#) Enable the USART using the USART_Cmd() function.
1006:./Libraries/src/stm32f4xx_usart.c ****       (#) Configures the IrDA pulse width by configuring the prescaler using  
1007:./Libraries/src/stm32f4xx_usart.c ****           the USART_SetPrescaler() function.
1008:./Libraries/src/stm32f4xx_usart.c ****       (#) Configures the IrDA  USART_IrDAMode_LowPower or USART_IrDAMode_Normal mode
1009:./Libraries/src/stm32f4xx_usart.c ****           using the USART_IrDAConfig() function.
1010:./Libraries/src/stm32f4xx_usart.c ****       (#) Enable the IrDA using the USART_IrDACmd() function.
1011:./Libraries/src/stm32f4xx_usart.c **** 
ARM GAS  /tmp/ccdQ2tkR.s 			page 40


1012:./Libraries/src/stm32f4xx_usart.c ****       -@- A pulse of width less than two and greater than one PSC period(s) may or may
1013:./Libraries/src/stm32f4xx_usart.c ****           not be rejected.
1014:./Libraries/src/stm32f4xx_usart.c ****       -@- The receiver set up time should be managed by software. The IrDA physical layer
1015:./Libraries/src/stm32f4xx_usart.c ****           specification specifies a minimum of 10 ms delay between transmission and 
1016:./Libraries/src/stm32f4xx_usart.c ****           reception (IrDA is a half duplex protocol).
1017:./Libraries/src/stm32f4xx_usart.c ****       -@- In IrDA mode, the following bits must be kept cleared:
1018:./Libraries/src/stm32f4xx_usart.c ****         (+@) LINEN, STOP and CLKEN bits in the USART_CR2 register.
1019:./Libraries/src/stm32f4xx_usart.c ****         (+@) SCEN and HDSEL bits in the USART_CR3 register.
1020:./Libraries/src/stm32f4xx_usart.c **** 
1021:./Libraries/src/stm32f4xx_usart.c **** @endverbatim
1022:./Libraries/src/stm32f4xx_usart.c ****   * @{
1023:./Libraries/src/stm32f4xx_usart.c ****   */
1024:./Libraries/src/stm32f4xx_usart.c **** 
1025:./Libraries/src/stm32f4xx_usart.c **** /**
1026:./Libraries/src/stm32f4xx_usart.c ****   * @brief  Configures the USART's IrDA interface.
1027:./Libraries/src/stm32f4xx_usart.c ****   * @param  USARTx: where x can be 1, 2, 3, 4, 5, 6, 7 or 8 to select the USART or 
1028:./Libraries/src/stm32f4xx_usart.c ****   *         UART peripheral.
1029:./Libraries/src/stm32f4xx_usart.c ****   * @param  USART_IrDAMode: specifies the IrDA mode.
1030:./Libraries/src/stm32f4xx_usart.c ****   *          This parameter can be one of the following values:
1031:./Libraries/src/stm32f4xx_usart.c ****   *            @arg USART_IrDAMode_LowPower
1032:./Libraries/src/stm32f4xx_usart.c ****   *            @arg USART_IrDAMode_Normal
1033:./Libraries/src/stm32f4xx_usart.c ****   * @retval None
1034:./Libraries/src/stm32f4xx_usart.c ****   */
1035:./Libraries/src/stm32f4xx_usart.c **** void USART_IrDAConfig(USART_TypeDef* USARTx, uint16_t USART_IrDAMode)
1036:./Libraries/src/stm32f4xx_usart.c **** {
 1215              		.loc 1 1036 1 is_stmt 1 view -0
 1216              		.cfi_startproc
 1217              		@ args = 0, pretend = 0, frame = 0
