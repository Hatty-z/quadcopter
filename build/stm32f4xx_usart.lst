1124:./Libraries/src/stm32f4xx_usart.c **** /** @defgroup USART_Group9 Interrupts and flags management functions
1125:./Libraries/src/stm32f4xx_usart.c ****  *  @brief   Interrupts and flags management functions 
1126:./Libraries/src/stm32f4xx_usart.c ****  *
1127:./Libraries/src/stm32f4xx_usart.c **** @verbatim   
1128:./Libraries/src/stm32f4xx_usart.c ****  ===============================================================================
1129:./Libraries/src/stm32f4xx_usart.c ****             ##### Interrupts and flags management functions #####
1130:./Libraries/src/stm32f4xx_usart.c ****  ===============================================================================  
1131:./Libraries/src/stm32f4xx_usart.c ****     [..]
1132:./Libraries/src/stm32f4xx_usart.c ****     This subsection provides a set of functions allowing to configure the USART 
1133:./Libraries/src/stm32f4xx_usart.c ****     Interrupts sources, DMA channels requests and check or clear the flags or 
1134:./Libraries/src/stm32f4xx_usart.c ****     pending bits status.
1135:./Libraries/src/stm32f4xx_usart.c ****     The user should identify which mode will be used in his application to manage 
1136:./Libraries/src/stm32f4xx_usart.c ****     the communication: Polling mode, Interrupt mode or DMA mode. 
1137:./Libraries/src/stm32f4xx_usart.c ****     
1138:./Libraries/src/stm32f4xx_usart.c ****     *** Polling Mode ***
1139:./Libraries/src/stm32f4xx_usart.c ****     ====================
1140:./Libraries/src/stm32f4xx_usart.c ****     [..]
1141:./Libraries/src/stm32f4xx_usart.c ****     In Polling Mode, the SPI communication can be managed by 10 flags:
1142:./Libraries/src/stm32f4xx_usart.c ****       (#) USART_FLAG_TXE : to indicate the status of the transmit buffer register
1143:./Libraries/src/stm32f4xx_usart.c ****       (#) USART_FLAG_RXNE : to indicate the status of the receive buffer register
1144:./Libraries/src/stm32f4xx_usart.c ****       (#) USART_FLAG_TC : to indicate the status of the transmit operation
1145:./Libraries/src/stm32f4xx_usart.c ****       (#) USART_FLAG_IDLE : to indicate the status of the Idle Line             
1146:./Libraries/src/stm32f4xx_usart.c ****       (#) USART_FLAG_CTS : to indicate the status of the nCTS input
1147:./Libraries/src/stm32f4xx_usart.c ****       (#) USART_FLAG_LBD : to indicate the status of the LIN break detection
1148:./Libraries/src/stm32f4xx_usart.c ****       (#) USART_FLAG_NE : to indicate if a noise error occur
1149:./Libraries/src/stm32f4xx_usart.c ****       (#) USART_FLAG_FE : to indicate if a frame error occur
1150:./Libraries/src/stm32f4xx_usart.c ****       (#) USART_FLAG_PE : to indicate if a parity error occur
1151:./Libraries/src/stm32f4xx_usart.c ****       (#) USART_FLAG_ORE : to indicate if an Overrun error occur
1152:./Libraries/src/stm32f4xx_usart.c ****     [..]
1153:./Libraries/src/stm32f4xx_usart.c ****     In this Mode it is advised to use the following functions:
1154:./Libraries/src/stm32f4xx_usart.c ****       (+) FlagStatus USART_GetFlagStatus(USART_TypeDef* USARTx, uint16_t USART_FLAG);
1155:./Libraries/src/stm32f4xx_usart.c ****       (+) void USART_ClearFlag(USART_TypeDef* USARTx, uint16_t USART_FLAG);
1156:./Libraries/src/stm32f4xx_usart.c **** 
1157:./Libraries/src/stm32f4xx_usart.c ****     *** Interrupt Mode ***
1158:./Libraries/src/stm32f4xx_usart.c ****     ======================
1159:./Libraries/src/stm32f4xx_usart.c ****     [..]
1160:./Libraries/src/stm32f4xx_usart.c ****     In Interrupt Mode, the USART communication can be managed by 8 interrupt sources
1161:./Libraries/src/stm32f4xx_usart.c ****     and 10 pending bits: 
1162:./Libraries/src/stm32f4xx_usart.c **** 
1163:./Libraries/src/stm32f4xx_usart.c ****       (#) Pending Bits:
1164:./Libraries/src/stm32f4xx_usart.c **** 
1165:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_TXE : to indicate the status of the transmit buffer register
1166:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_RXNE : to indicate the status of the receive buffer register
1167:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_TC : to indicate the status of the transmit operation
1168:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_IDLE : to indicate the status of the Idle Line             
1169:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_CTS : to indicate the status of the nCTS input
1170:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_LBD : to indicate the status of the LIN break detection
1171:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_NE : to indicate if a noise error occur
1172:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_FE : to indicate if a frame error occur
1173:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_PE : to indicate if a parity error occur
1174:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_ORE : to indicate if an Overrun error occur
1175:./Libraries/src/stm32f4xx_usart.c **** 
1176:./Libraries/src/stm32f4xx_usart.c ****       (#) Interrupt Source:
1177:./Libraries/src/stm32f4xx_usart.c **** 
ARM GAS  /tmp/ccdQ2tkR.s 			page 45


1178:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_TXE : specifies the interrupt source for the Tx buffer empty 
1179:./Libraries/src/stm32f4xx_usart.c ****                             interrupt. 
1180:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_RXNE : specifies the interrupt source for the Rx buffer not 
1181:./Libraries/src/stm32f4xx_usart.c ****                              empty interrupt.
1182:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_TC : specifies the interrupt source for the Transmit complete 
1183:./Libraries/src/stm32f4xx_usart.c ****                            interrupt. 
1184:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_IDLE : specifies the interrupt source for the Idle Line interrupt.           
1185:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_CTS : specifies the interrupt source for the CTS interrupt. 
1186:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_LBD : specifies the interrupt source for the LIN break detection
1187:./Libraries/src/stm32f4xx_usart.c ****                             interrupt. 
1188:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_PE : specifies the interrupt source for the parity error interrupt. 
1189:./Libraries/src/stm32f4xx_usart.c ****         (##) USART_IT_ERR :  specifies the interrupt source for the errors interrupt.
1190:./Libraries/src/stm32f4xx_usart.c **** 
1191:./Libraries/src/stm32f4xx_usart.c ****       -@@- Some parameters are coded in order to use them as interrupt source 
1192:./Libraries/src/stm32f4xx_usart.c ****           or as pending bits.
1193:./Libraries/src/stm32f4xx_usart.c ****     [..]
1194:./Libraries/src/stm32f4xx_usart.c ****     In this Mode it is advised to use the following functions:
1195:./Libraries/src/stm32f4xx_usart.c ****       (+) void USART_ITConfig(USART_TypeDef* USARTx, uint16_t USART_IT, FunctionalState NewState);
1196:./Libraries/src/stm32f4xx_usart.c ****       (+) ITStatus USART_GetITStatus(USART_TypeDef* USARTx, uint16_t USART_IT);
1197:./Libraries/src/stm32f4xx_usart.c ****       (+) void USART_ClearITPendingBit(USART_TypeDef* USARTx, uint16_t USART_IT);
1198:./Libraries/src/stm32f4xx_usart.c **** 
1199:./Libraries/src/stm32f4xx_usart.c ****     *** DMA Mode ***
1200:./Libraries/src/stm32f4xx_usart.c ****     ================
1201:./Libraries/src/stm32f4xx_usart.c ****     [..]
1202:./Libraries/src/stm32f4xx_usart.c ****     In DMA Mode, the USART communication can be managed by 2 DMA Channel requests:
1203:./Libraries/src/stm32f4xx_usart.c ****       (#) USART_DMAReq_Tx: specifies the Tx buffer DMA transfer request
1204:./Libraries/src/stm32f4xx_usart.c ****       (#) USART_DMAReq_Rx: specifies the Rx buffer DMA transfer request
1205:./Libraries/src/stm32f4xx_usart.c ****     [..]
1206:./Libraries/src/stm32f4xx_usart.c ****     In this Mode it is advised to use the following function:
1207:./Libraries/src/stm32f4xx_usart.c ****       (+) void USART_DMACmd(USART_TypeDef* USARTx, uint16_t USART_DMAReq, FunctionalState NewState)
1208:./Libraries/src/stm32f4xx_usart.c **** 
1209:./Libraries/src/stm32f4xx_usart.c **** @endverbatim
1210:./Libraries/src/stm32f4xx_usart.c ****   * @{
1211:./Libraries/src/stm32f4xx_usart.c ****   */
