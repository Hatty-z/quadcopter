 184:./Libraries/src/stm32f4xx_usart.c ****   *         UART peripheral.
 185:./Libraries/src/stm32f4xx_usart.c ****   * @retval None
 186:./Libraries/src/stm32f4xx_usart.c ****   */
 187:./Libraries/src/stm32f4xx_usart.c **** void USART_DeInit(USART_TypeDef* USARTx)
 188:./Libraries/src/stm32f4xx_usart.c **** {
