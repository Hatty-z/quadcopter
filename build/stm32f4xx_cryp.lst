 167:./Libraries/src/stm32f4xx_cryp.c **** /** @addtogroup STM32F4xx_StdPeriph_Driver
 168:./Libraries/src/stm32f4xx_cryp.c ****   * @{
 169:./Libraries/src/stm32f4xx_cryp.c ****   */
 170:./Libraries/src/stm32f4xx_cryp.c **** 
 171:./Libraries/src/stm32f4xx_cryp.c **** /** @defgroup CRYP 
 172:./Libraries/src/stm32f4xx_cryp.c ****   * @brief CRYP driver modules
 173:./Libraries/src/stm32f4xx_cryp.c ****   * @{
 174:./Libraries/src/stm32f4xx_cryp.c ****   */ 
 175:./Libraries/src/stm32f4xx_cryp.c **** 
 176:./Libraries/src/stm32f4xx_cryp.c **** /* Private typedef -----------------------------------------------------------*/
 177:./Libraries/src/stm32f4xx_cryp.c **** /* Private define ------------------------------------------------------------*/
 178:./Libraries/src/stm32f4xx_cryp.c **** #define FLAG_MASK     ((uint8_t)0x20)
 179:./Libraries/src/stm32f4xx_cryp.c **** #define MAX_TIMEOUT   ((uint16_t)0xFFFF)
 180:./Libraries/src/stm32f4xx_cryp.c **** 
 181:./Libraries/src/stm32f4xx_cryp.c **** /* Private macro -------------------------------------------------------------*/
 182:./Libraries/src/stm32f4xx_cryp.c **** /* Private variables ---------------------------------------------------------*/
 183:./Libraries/src/stm32f4xx_cryp.c **** /* Private function prototypes -----------------------------------------------*/
 184:./Libraries/src/stm32f4xx_cryp.c **** /* Private functions ---------------------------------------------------------*/
 185:./Libraries/src/stm32f4xx_cryp.c **** 
 186:./Libraries/src/stm32f4xx_cryp.c **** /** @defgroup CRYP_Private_Functions
 187:./Libraries/src/stm32f4xx_cryp.c ****   * @{
 188:./Libraries/src/stm32f4xx_cryp.c ****   */ 
 189:./Libraries/src/stm32f4xx_cryp.c **** 
 190:./Libraries/src/stm32f4xx_cryp.c **** /** @defgroup CRYP_Group1 Initialization and Configuration functions
 191:./Libraries/src/stm32f4xx_cryp.c ****  *  @brief    Initialization and Configuration functions 
 192:./Libraries/src/stm32f4xx_cryp.c ****  *
 193:./Libraries/src/stm32f4xx_cryp.c **** @verbatim    
 194:./Libraries/src/stm32f4xx_cryp.c ****  ===============================================================================
 195:./Libraries/src/stm32f4xx_cryp.c ****              ##### Initialization and Configuration functions #####
 196:./Libraries/src/stm32f4xx_cryp.c ****  ===============================================================================  
 197:./Libraries/src/stm32f4xx_cryp.c ****  [..] This section provides functions allowing to 
 198:./Libraries/src/stm32f4xx_cryp.c ****    (+) Initialize the cryptographic Processor using CRYP_Init() function 
 199:./Libraries/src/stm32f4xx_cryp.c ****        (++)  Encrypt or Decrypt 
 200:./Libraries/src/stm32f4xx_cryp.c ****        (++)  mode : TDES-ECB, TDES-CBC, 
 201:./Libraries/src/stm32f4xx_cryp.c ****                     DES-ECB, DES-CBC, 
ARM GAS  /tmp/cc52A741.s 			page 5


 202:./Libraries/src/stm32f4xx_cryp.c ****                     AES-ECB, AES-CBC, AES-CTR, AES-Key, AES-GCM, AES-CCM 
 203:./Libraries/src/stm32f4xx_cryp.c ****        (++) DataType :  32-bit data, 16-bit data, bit data or bit-string
 204:./Libraries/src/stm32f4xx_cryp.c ****        (++) Key Size (only in AES modes)
 205:./Libraries/src/stm32f4xx_cryp.c ****    (+) Configure the Encrypt or Decrypt Key using CRYP_KeyInit() function 
 206:./Libraries/src/stm32f4xx_cryp.c ****    (+) Configure the Initialization Vectors(IV) for CBC and CTR modes using 
 207:./Libraries/src/stm32f4xx_cryp.c ****        CRYP_IVInit() function.  
 208:./Libraries/src/stm32f4xx_cryp.c ****    (+) Flushes the IN and OUT FIFOs : using CRYP_FIFOFlush() function.                         
 209:./Libraries/src/stm32f4xx_cryp.c ****    (+) Enable or disable the CRYP Processor using CRYP_Cmd() function 
 210:./Libraries/src/stm32f4xx_cryp.c ****        
 211:./Libraries/src/stm32f4xx_cryp.c **** @endverbatim
 212:./Libraries/src/stm32f4xx_cryp.c ****   * @{
 213:./Libraries/src/stm32f4xx_cryp.c ****   */
 214:./Libraries/src/stm32f4xx_cryp.c **** /**
 215:./Libraries/src/stm32f4xx_cryp.c ****   * @brief  Deinitializes the CRYP peripheral registers to their default reset values
 216:./Libraries/src/stm32f4xx_cryp.c ****   * @param  None
 217:./Libraries/src/stm32f4xx_cryp.c ****   * @retval None
 218:./Libraries/src/stm32f4xx_cryp.c ****   */
 219:./Libraries/src/stm32f4xx_cryp.c **** void CRYP_DeInit(void)
 220:./Libraries/src/stm32f4xx_cryp.c **** {
  29              		.loc 1 220 1 view -0
  30              		.cfi_startproc
  31              		@ args = 0, pretend = 0, frame = 0
  32              		@ frame_needed = 0, uses_anonymous_args = 0
  33 0000 08B5     		push	{r3, lr}
  34              	.LCFI0:
  35              		.cfi_def_cfa_offset 8
  36              		.cfi_offset 3, -8
  37              		.cfi_offset 14, -4
 221:./Libraries/src/stm32f4xx_cryp.c ****   /* Enable CRYP reset state */
 222:./Libraries/src/stm32f4xx_cryp.c ****   RCC_AHB2PeriphResetCmd(RCC_AHB2Periph_CRYP, ENABLE);
  38              		.loc 1 222 3 view .LVU1
  39 0002 0121     		movs	r1, #1
  40 0004 1020     		movs	r0, #16
  41 0006 FFF7FEFF 		bl	RCC_AHB2PeriphResetCmd
  42              	.LVL0:
 223:./Libraries/src/stm32f4xx_cryp.c **** 
 224:./Libraries/src/stm32f4xx_cryp.c ****   /* Release CRYP from reset state */
 225:./Libraries/src/stm32f4xx_cryp.c ****   RCC_AHB2PeriphResetCmd(RCC_AHB2Periph_CRYP, DISABLE);
  43              		.loc 1 225 3 view .LVU2
  44 000a 0021     		movs	r1, #0
  45 000c 1020     		movs	r0, #16
  46 000e FFF7FEFF 		bl	RCC_AHB2PeriphResetCmd
