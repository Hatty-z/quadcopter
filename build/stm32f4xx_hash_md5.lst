  86:./system/core_cmInstr.h **** /** \brief  Instruction Synchronization Barrier
  87:./system/core_cmInstr.h **** 
  88:./system/core_cmInstr.h ****     Instruction Synchronization Barrier flushes the pipeline in the processor,
  89:./system/core_cmInstr.h ****     so that all instructions following the ISB are fetched from cache or
  90:./system/core_cmInstr.h ****     memory, after the instruction has been completed.
  91:./system/core_cmInstr.h ****  */
  92:./system/core_cmInstr.h **** #define __ISB() do {\
  93:./system/core_cmInstr.h ****                    __schedule_barrier();\
  94:./system/core_cmInstr.h ****                    __isb(0xF);\
  95:./system/core_cmInstr.h ****                    __schedule_barrier();\
  96:./system/core_cmInstr.h ****                 } while (0)
  97:./system/core_cmInstr.h **** 
  98:./system/core_cmInstr.h **** /** \brief  Data Synchronization Barrier
  99:./system/core_cmInstr.h **** 
 100:./system/core_cmInstr.h ****     This function acts as a special kind of Data Memory Barrier.
 101:./system/core_cmInstr.h ****     It completes when all explicit memory accesses before this instruction complete.
 102:./system/core_cmInstr.h ****  */
 103:./system/core_cmInstr.h **** #define __DSB() do {\
 104:./system/core_cmInstr.h ****                    __schedule_barrier();\
 105:./system/core_cmInstr.h ****                    __dsb(0xF);\
 106:./system/core_cmInstr.h ****                    __schedule_barrier();\
 107:./system/core_cmInstr.h ****                 } while (0)
 108:./system/core_cmInstr.h **** 
 109:./system/core_cmInstr.h **** /** \brief  Data Memory Barrier
 110:./system/core_cmInstr.h **** 
 111:./system/core_cmInstr.h ****     This function ensures the apparent order of the explicit memory operations before
 112:./system/core_cmInstr.h ****     and after the instruction, without ensuring their completion.
 113:./system/core_cmInstr.h ****  */
 114:./system/core_cmInstr.h **** #define __DMB() do {\
 115:./system/core_cmInstr.h ****                    __schedule_barrier();\
 116:./system/core_cmInstr.h ****                    __dmb(0xF);\
 117:./system/core_cmInstr.h ****                    __schedule_barrier();\
 118:./system/core_cmInstr.h ****                 } while (0)
