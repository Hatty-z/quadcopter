  38:./ucos/Core/os_mem.c **** /*
  39:./ucos/Core/os_mem.c **** ***************************************************************************************************
  40:./ucos/Core/os_mem.c **** *                                      CREATE A MEMORY PARTITION
  41:./ucos/Core/os_mem.c **** *
  42:./ucos/Core/os_mem.c **** * Description : Create a fixed-sized memory partition that will be managed by uC/OS-II.
  43:./ucos/Core/os_mem.c **** *
  44:./ucos/Core/os_mem.c **** * Arguments   : addr     is the starting address of the memory partition
  45:./ucos/Core/os_mem.c **** *
  46:./ucos/Core/os_mem.c **** *               nblks    is the number of memory blocks to create from the partition.
  47:./ucos/Core/os_mem.c **** *
  48:./ucos/Core/os_mem.c **** *               blksize  is the size (in bytes) of each block in the memory partition.
  49:./ucos/Core/os_mem.c **** *
  50:./ucos/Core/os_mem.c **** *               perr     is a pointer to a variable containing an error message which will be set b
  51:./ucos/Core/os_mem.c **** *                        this function to either:
  52:./ucos/Core/os_mem.c **** *
  53:./ucos/Core/os_mem.c **** *                        OS_ERR_NONE                     if the memory partition has been created c
  54:./ucos/Core/os_mem.c **** *                        OS_ERR_ILLEGAL_CREATE_RUN_TIME  if you tried to create a memory partition 
  55:./ucos/Core/os_mem.c **** *                                                        safety critical operation started.
  56:./ucos/Core/os_mem.c **** *                        OS_ERR_MEM_INVALID_ADDR         if you are specifying an invalid address f
  57:./ucos/Core/os_mem.c **** *                                                        storage of the partition or, the block doe
  58:./ucos/Core/os_mem.c **** *                                                        on a pointer boundary
  59:./ucos/Core/os_mem.c **** *                        OS_ERR_MEM_INVALID_PART         no free partitions available
  60:./ucos/Core/os_mem.c **** *                        OS_ERR_MEM_INVALID_BLKS         user specified an invalid number of blocks
  61:./ucos/Core/os_mem.c **** *                        OS_ERR_MEM_INVALID_SIZE         user specified an invalid block size
  62:./ucos/Core/os_mem.c **** *                                                          - must be greater than the size of a poi
  63:./ucos/Core/os_mem.c **** *                                                          - must be able to hold an integral numbe
  64:./ucos/Core/os_mem.c **** * Returns    : != (OS_MEM *)0  is the partition was created
  65:./ucos/Core/os_mem.c **** *              == (OS_MEM *)0  if the partition was not created because of invalid arguments or, no
  66:./ucos/Core/os_mem.c **** *                              free partition is available.
  67:./ucos/Core/os_mem.c **** ***************************************************************************************************
  68:./ucos/Core/os_mem.c **** */
