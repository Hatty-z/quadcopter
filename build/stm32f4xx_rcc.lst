 296:./Libraries/src/stm32f4xx_rcc.c **** /**
 297:./Libraries/src/stm32f4xx_rcc.c ****   * @brief  Waits for HSE start-up.
 298:./Libraries/src/stm32f4xx_rcc.c ****   * @note   This functions waits on HSERDY flag to be set and return SUCCESS if 
 299:./Libraries/src/stm32f4xx_rcc.c ****   *         this flag is set, otherwise returns ERROR if the timeout is reached 
 300:./Libraries/src/stm32f4xx_rcc.c ****   *         and this flag is not set. The timeout value is defined by the constant
 301:./Libraries/src/stm32f4xx_rcc.c ****   *         HSE_STARTUP_TIMEOUT in stm32f4xx.h file. You can tailor it depending
 302:./Libraries/src/stm32f4xx_rcc.c ****   *         on the HSE crystal used in your application. 
 303:./Libraries/src/stm32f4xx_rcc.c ****   * @param  None
 304:./Libraries/src/stm32f4xx_rcc.c ****   * @retval An ErrorStatus enumeration value:
 305:./Libraries/src/stm32f4xx_rcc.c ****   *          - SUCCESS: HSE oscillator is stable and ready to use
 306:./Libraries/src/stm32f4xx_rcc.c ****   *          - ERROR: HSE oscillator not yet ready
 307:./Libraries/src/stm32f4xx_rcc.c ****   */
 308:./Libraries/src/stm32f4xx_rcc.c **** ErrorStatus RCC_WaitForHSEStartUp(void)
 309:./Libraries/src/stm32f4xx_rcc.c **** {
 310:./Libraries/src/stm32f4xx_rcc.c ****   __IO uint32_t startupcounter = 0;
 311:./Libraries/src/stm32f4xx_rcc.c ****   ErrorStatus status = ERROR;
 312:./Libraries/src/stm32f4xx_rcc.c ****   FlagStatus hsestatus = RESET;
 313:./Libraries/src/stm32f4xx_rcc.c ****   /* Wait till HSE is ready and if Time out is reached exit */
 314:./Libraries/src/stm32f4xx_rcc.c ****   do
 315:./Libraries/src/stm32f4xx_rcc.c ****   {
 316:./Libraries/src/stm32f4xx_rcc.c ****     hsestatus = RCC_GetFlagStatus(RCC_FLAG_HSERDY);
 317:./Libraries/src/stm32f4xx_rcc.c ****     startupcounter++;
 318:./Libraries/src/stm32f4xx_rcc.c ****   } while((startupcounter != HSE_STARTUP_TIMEOUT) && (hsestatus == RESET));
 319:./Libraries/src/stm32f4xx_rcc.c **** 
 320:./Libraries/src/stm32f4xx_rcc.c ****   if (RCC_GetFlagStatus(RCC_FLAG_HSERDY) != RESET)
 321:./Libraries/src/stm32f4xx_rcc.c ****   {
 322:./Libraries/src/stm32f4xx_rcc.c ****     status = SUCCESS;
 323:./Libraries/src/stm32f4xx_rcc.c ****   }
 324:./Libraries/src/stm32f4xx_rcc.c ****   else
 325:./Libraries/src/stm32f4xx_rcc.c ****   {
 326:./Libraries/src/stm32f4xx_rcc.c ****     status = ERROR;
 327:./Libraries/src/stm32f4xx_rcc.c ****   }
 328:./Libraries/src/stm32f4xx_rcc.c ****   return (status);
 329:./Libraries/src/stm32f4xx_rcc.c **** }
 330:./Libraries/src/stm32f4xx_rcc.c **** 
