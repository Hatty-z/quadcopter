  77:./Libraries/src/stm32f4xx_rcc.c **** #define HSION_BitNumber           0x00
  78:./Libraries/src/stm32f4xx_rcc.c **** #define CR_HSION_BB               (PERIPH_BB_BASE + (CR_OFFSET * 32) + (HSION_BitNumber * 4))
  79:./Libraries/src/stm32f4xx_rcc.c **** /* Alias word address of CSSON bit */
