  81:./Libraries/src/stm32f4xx_rcc.c **** #define CR_CSSON_BB               (PERIPH_BB_BASE + (CR_OFFSET * 32) + (CSSON_BitNumber * 4))
  82:./Libraries/src/stm32f4xx_rcc.c **** /* Alias word address of PLLON bit */
  83:./Libraries/src/stm32f4xx_rcc.c **** #define PLLON_BitNumber           0x18
  84:./Libraries/src/stm32f4xx_rcc.c **** #define CR_PLLON_BB               (PERIPH_BB_BASE + (CR_OFFSET * 32) + (PLLON_BitNumber * 4))
  85:./Libraries/src/stm32f4xx_rcc.c **** /* Alias word address of PLLI2SON bit */
  86:./Libraries/src/stm32f4xx_rcc.c **** #define PLLI2SON_BitNumber        0x1A
  87:./Libraries/src/stm32f4xx_rcc.c **** #define CR_PLLI2SON_BB            (PERIPH_BB_BASE + (CR_OFFSET * 32) + (PLLI2SON_BitNumber * 4))
