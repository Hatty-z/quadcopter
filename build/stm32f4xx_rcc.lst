 162:./Libraries/src/stm32f4xx_rcc.c **** /** @defgroup RCC_Group1 Internal and external clocks, PLL, CSS and MCO configuration functions
 163:./Libraries/src/stm32f4xx_rcc.c ****  *  @brief   Internal and external clocks, PLL, CSS and MCO configuration functions 
 164:./Libraries/src/stm32f4xx_rcc.c ****  *
 165:./Libraries/src/stm32f4xx_rcc.c **** @verbatim   
 166:./Libraries/src/stm32f4xx_rcc.c ****  ===================================================================================
 167:./Libraries/src/stm32f4xx_rcc.c ****  ##### Internal and  external clocks, PLL, CSS and MCO configuration functions #####
 168:./Libraries/src/stm32f4xx_rcc.c ****  ===================================================================================
 169:./Libraries/src/stm32f4xx_rcc.c ****     [..]
 170:./Libraries/src/stm32f4xx_rcc.c ****       This section provide functions allowing to configure the internal/external clocks,
 171:./Libraries/src/stm32f4xx_rcc.c ****       PLLs, CSS and MCO pins.
 172:./Libraries/src/stm32f4xx_rcc.c ****   
 173:./Libraries/src/stm32f4xx_rcc.c ****       (#) HSI (high-speed internal), 16 MHz factory-trimmed RC used directly or through
 174:./Libraries/src/stm32f4xx_rcc.c ****           the PLL as System clock source.
 175:./Libraries/src/stm32f4xx_rcc.c **** 
 176:./Libraries/src/stm32f4xx_rcc.c ****       (#) LSI (low-speed internal), 32 KHz low consumption RC used as IWDG and/or RTC
 177:./Libraries/src/stm32f4xx_rcc.c ****           clock source.
 178:./Libraries/src/stm32f4xx_rcc.c **** 
 179:./Libraries/src/stm32f4xx_rcc.c ****       (#) HSE (high-speed external), 4 to 26 MHz crystal oscillator used directly or
 180:./Libraries/src/stm32f4xx_rcc.c ****           through the PLL as System clock source. Can be used also as RTC clock source.
 181:./Libraries/src/stm32f4xx_rcc.c **** 
 182:./Libraries/src/stm32f4xx_rcc.c ****       (#) LSE (low-speed external), 32 KHz oscillator used as RTC clock source.   
 183:./Libraries/src/stm32f4xx_rcc.c **** 
 184:./Libraries/src/stm32f4xx_rcc.c ****       (#) PLL (clocked by HSI or HSE), featuring two different output clocks:
 185:./Libraries/src/stm32f4xx_rcc.c ****         (++) The first output is used to generate the high speed system clock (up to 168 MHz)
 186:./Libraries/src/stm32f4xx_rcc.c ****         (++) The second output is used to generate the clock for the USB OTG FS (48 MHz),
 187:./Libraries/src/stm32f4xx_rcc.c ****              the random analog generator (<=48 MHz) and the SDIO (<= 48 MHz).
 188:./Libraries/src/stm32f4xx_rcc.c **** 
 189:./Libraries/src/stm32f4xx_rcc.c ****       (#) PLLI2S (clocked by HSI or HSE), used to generate an accurate clock to achieve 
 190:./Libraries/src/stm32f4xx_rcc.c ****           high-quality audio performance on the I2S interface or SAI interface in case 
 191:./Libraries/src/stm32f4xx_rcc.c ****           of STM32F429x/439x devices.
 192:./Libraries/src/stm32f4xx_rcc.c ****      
 193:./Libraries/src/stm32f4xx_rcc.c ****       (#) PLLSAI clocked by (HSI or HSE), used to generate an accurate clock to SAI 
 194:./Libraries/src/stm32f4xx_rcc.c ****           interface and LCD TFT controller available only for STM32F42xxx/43xxx/446xx/469xx/479xx d
 195:./Libraries/src/stm32f4xx_rcc.c ****   
 196:./Libraries/src/stm32f4xx_rcc.c ****       (#) CSS (Clock security system), once enable and if a HSE clock failure occurs 
 197:./Libraries/src/stm32f4xx_rcc.c ****          (HSE used directly or through PLL as System clock source), the System clock
 198:./Libraries/src/stm32f4xx_rcc.c ****          is automatically switched to HSI and an interrupt is generated if enabled. 
 199:./Libraries/src/stm32f4xx_rcc.c ****          The interrupt is linked to the Cortex-M4 NMI (Non-Maskable Interrupt) 
 200:./Libraries/src/stm32f4xx_rcc.c ****          exception vector.   
 201:./Libraries/src/stm32f4xx_rcc.c **** 
ARM GAS  /tmp/cc9hYLCi.s 			page 5


 202:./Libraries/src/stm32f4xx_rcc.c ****       (#) MCO1 (microcontroller clock output), used to output HSI, LSE, HSE or PLL
 203:./Libraries/src/stm32f4xx_rcc.c ****           clock (through a configurable prescaler) on PA8 pin.
 204:./Libraries/src/stm32f4xx_rcc.c **** 
 205:./Libraries/src/stm32f4xx_rcc.c ****       (#) MCO2 (microcontroller clock output), used to output HSE, PLL, SYSCLK or PLLI2S
 206:./Libraries/src/stm32f4xx_rcc.c ****           clock (through a configurable prescaler) on PC9 pin.
 207:./Libraries/src/stm32f4xx_rcc.c ****  @endverbatim
 208:./Libraries/src/stm32f4xx_rcc.c ****   * @{
 209:./Libraries/src/stm32f4xx_rcc.c ****   */
 210:./Libraries/src/stm32f4xx_rcc.c **** 
 211:./Libraries/src/stm32f4xx_rcc.c **** /**
 212:./Libraries/src/stm32f4xx_rcc.c ****   * @brief  Resets the RCC clock configuration to the default reset state.
 213:./Libraries/src/stm32f4xx_rcc.c ****   * @note   The default reset state of the clock configuration is given below:
 214:./Libraries/src/stm32f4xx_rcc.c ****   *            - HSI ON and used as system clock source
 215:./Libraries/src/stm32f4xx_rcc.c ****   *            - HSE, PLL and PLLI2S OFF
 216:./Libraries/src/stm32f4xx_rcc.c ****   *            - AHB, APB1 and APB2 prescaler set to 1.
 217:./Libraries/src/stm32f4xx_rcc.c ****   *            - CSS, MCO1 and MCO2 OFF
 218:./Libraries/src/stm32f4xx_rcc.c ****   *            - All interrupts disabled
 219:./Libraries/src/stm32f4xx_rcc.c ****   * @note   This function doesn't modify the configuration of the
 220:./Libraries/src/stm32f4xx_rcc.c ****   *            - Peripheral clocks  
 221:./Libraries/src/stm32f4xx_rcc.c ****   *            - LSI, LSE and RTC clocks 
