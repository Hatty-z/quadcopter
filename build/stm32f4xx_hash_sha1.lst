 192:./system/core_cmInstr.h **** #else
 193:./system/core_cmInstr.h **** __attribute__((always_inline)) __STATIC_INLINE uint32_t __RBIT(uint32_t value)
 194:./system/core_cmInstr.h **** {
 195:./system/core_cmInstr.h ****   uint32_t result;
 196:./system/core_cmInstr.h ****   int32_t s = 4 /*sizeof(v)*/ * 8 - 1; // extra shift needed at end
 197:./system/core_cmInstr.h **** 
 198:./system/core_cmInstr.h ****   result = value;                      // r will be reversed bits of v; first get LSB of v
 199:./system/core_cmInstr.h ****   for (value >>= 1; value; value >>= 1)
