 924:./Libraries/src/stm32f4xx_ltdc.c **** /** @defgroup LTDC_Group2 Interrupts and flags management functions
 925:./Libraries/src/stm32f4xx_ltdc.c ****  *  @brief   Interrupts and flags management functions
 926:./Libraries/src/stm32f4xx_ltdc.c ****  *
 927:./Libraries/src/stm32f4xx_ltdc.c **** @verbatim
 928:./Libraries/src/stm32f4xx_ltdc.c ****  ===============================================================================
 929:./Libraries/src/stm32f4xx_ltdc.c ****             ##### Interrupts and flags management functions #####
 930:./Libraries/src/stm32f4xx_ltdc.c ****  ===============================================================================
 931:./Libraries/src/stm32f4xx_ltdc.c **** 
 932:./Libraries/src/stm32f4xx_ltdc.c ****     [..] This section provides functions allowing to configure the LTDC Interrupts 
 933:./Libraries/src/stm32f4xx_ltdc.c ****          and to get the status and clear flags and Interrupts pending bits.
 934:./Libraries/src/stm32f4xx_ltdc.c ****   
 935:./Libraries/src/stm32f4xx_ltdc.c ****     [..] The LTDC provides 4 Interrupts sources and 4 Flags
 936:./Libraries/src/stm32f4xx_ltdc.c ****     
 937:./Libraries/src/stm32f4xx_ltdc.c ****     *** Flags ***
 938:./Libraries/src/stm32f4xx_ltdc.c ****     =============
 939:./Libraries/src/stm32f4xx_ltdc.c ****     [..]
 940:./Libraries/src/stm32f4xx_ltdc.c ****       (+) LTDC_FLAG_LI:   Line Interrupt flag.
 941:./Libraries/src/stm32f4xx_ltdc.c ****       (+) LTDC_FLAG_FU:   FIFO Underrun Interrupt flag.
 942:./Libraries/src/stm32f4xx_ltdc.c ****       (+) LTDC_FLAG_TERR: Transfer Error Interrupt flag.
 943:./Libraries/src/stm32f4xx_ltdc.c ****       (+) LTDC_FLAG_RR:   Register Reload interrupt flag.
 944:./Libraries/src/stm32f4xx_ltdc.c ****       
 945:./Libraries/src/stm32f4xx_ltdc.c ****     *** Interrupts ***
 946:./Libraries/src/stm32f4xx_ltdc.c ****     ==================
 947:./Libraries/src/stm32f4xx_ltdc.c ****     [..]
 948:./Libraries/src/stm32f4xx_ltdc.c ****       (+) LTDC_IT_LI: Line Interrupt is generated when a programmed line 
 949:./Libraries/src/stm32f4xx_ltdc.c ****                       is reached. The line interrupt position is programmed in 
 950:./Libraries/src/stm32f4xx_ltdc.c ****                       the LTDC_LIPR register.
 951:./Libraries/src/stm32f4xx_ltdc.c ****       (+) LTDC_IT_FU: FIFO Underrun interrupt is generated when a pixel is requested 
 952:./Libraries/src/stm32f4xx_ltdc.c ****                       from an empty layer FIFO
 953:./Libraries/src/stm32f4xx_ltdc.c ****       (+) LTDC_IT_TERR: Transfer Error interrupt is generated when an AHB bus 
 954:./Libraries/src/stm32f4xx_ltdc.c ****                         error occurs during data transfer.
ARM GAS  /tmp/cciVGXQG.s 			page 48


 955:./Libraries/src/stm32f4xx_ltdc.c ****       (+) LTDC_IT_RR: Register Reload interrupt is generated when the shadow 
 956:./Libraries/src/stm32f4xx_ltdc.c ****                       registers reload was performed during the vertical blanking 
 957:./Libraries/src/stm32f4xx_ltdc.c ****                       period.
 958:./Libraries/src/stm32f4xx_ltdc.c ****                
 959:./Libraries/src/stm32f4xx_ltdc.c **** @endverbatim
 960:./Libraries/src/stm32f4xx_ltdc.c ****   * @{
 961:./Libraries/src/stm32f4xx_ltdc.c ****   */
 962:./Libraries/src/stm32f4xx_ltdc.c **** 
 963:./Libraries/src/stm32f4xx_ltdc.c **** /**
 964:./Libraries/src/stm32f4xx_ltdc.c ****   * @brief  Enables or disables the specified LTDC's interrupts.
 965:./Libraries/src/stm32f4xx_ltdc.c ****   * @param  LTDC_IT: specifies the LTDC interrupts sources to be enabled or disabled.
 966:./Libraries/src/stm32f4xx_ltdc.c ****   *   This parameter can be any combination of the following values:
 967:./Libraries/src/stm32f4xx_ltdc.c ****   *     @arg LTDC_IT_LI: Line Interrupt Enable.
