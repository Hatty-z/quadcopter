 103:./Libraries/src/stm32f4xx_wwdg.c **** #define EWI_BitNumber     0x09
 104:./Libraries/src/stm32f4xx_wwdg.c **** #define CFR_EWI_BB        (PERIPH_BB_BASE + (CFR_OFFSET * 32) + (EWI_BitNumber * 4))
