1183:./ucos/Core/os_flag.c **** /*
1184:./ucos/Core/os_flag.c **** ***************************************************************************************************
1185:./ucos/Core/os_flag.c **** *                              MAKE TASK READY-TO-RUN, EVENT(s) OCCURRED
1186:./ucos/Core/os_flag.c **** *
1187:./ucos/Core/os_flag.c **** * Description: This function is internal to uC/OS-II and is used to make a task ready-to-run becaus
1188:./ucos/Core/os_flag.c **** *              desired event flag bits have been set.
1189:./ucos/Core/os_flag.c **** *
1190:./ucos/Core/os_flag.c **** * Arguments  : pnode         is a pointer to a structure which contains data about the task waiting
1191:./ucos/Core/os_flag.c **** *                            event flag bit(s) to be set.
1192:./ucos/Core/os_flag.c **** *
1193:./ucos/Core/os_flag.c **** *              flags_rdy     contains the bit pattern of the event flags that cause the task to bec
1194:./ucos/Core/os_flag.c **** *                            ready-to-run.
1195:./ucos/Core/os_flag.c **** *
ARM GAS  /tmp/ccjnSGoX.s 			page 45


1196:./ucos/Core/os_flag.c **** *              pend_stat   is used to indicate the readied task's pending status:
1197:./ucos/Core/os_flag.c **** *
1198:./ucos/Core/os_flag.c **** *
1199:./ucos/Core/os_flag.c **** * Returns    : OS_TRUE       If the task has been placed in the ready list and thus needs schedulin
1200:./ucos/Core/os_flag.c **** *              OS_FALSE      The task is still not ready to run and thus scheduling is not necessar
1201:./ucos/Core/os_flag.c **** *
1202:./ucos/Core/os_flag.c **** * Called by  : OSFlagsPost() OS_FLAG.C
1203:./ucos/Core/os_flag.c **** *
1204:./ucos/Core/os_flag.c **** * Note(s)    : 1) This function assumes that interrupts are disabled.
1205:./ucos/Core/os_flag.c **** *              2) This function is INTERNAL to uC/OS-II and your application should not call it.
1206:./ucos/Core/os_flag.c **** ***************************************************************************************************
1207:./ucos/Core/os_flag.c **** */
1208:./ucos/Core/os_flag.c **** 
1209:./ucos/Core/os_flag.c **** static  BOOLEAN  OS_FlagTaskRdy (OS_FLAG_NODE *pnode,
1210:./ucos/Core/os_flag.c ****                                  OS_FLAGS      flags_rdy,
1211:./ucos/Core/os_flag.c ****                                  INT8U         pend_stat)
1212:./ucos/Core/os_flag.c **** {
1213:./ucos/Core/os_flag.c ****     OS_TCB   *ptcb;
1214:./ucos/Core/os_flag.c ****     BOOLEAN   sched;
1215:./ucos/Core/os_flag.c **** 
1216:./ucos/Core/os_flag.c **** 
1217:./ucos/Core/os_flag.c ****     ptcb                 = (OS_TCB *)pnode->OSFlagNodeTCB; /* Point to TCB of waiting task         
1218:./ucos/Core/os_flag.c ****     ptcb->OSTCBDly       = 0u;
1219:./ucos/Core/os_flag.c ****     ptcb->OSTCBFlagsRdy  = flags_rdy;
1220:./ucos/Core/os_flag.c ****     ptcb->OSTCBStat     &= (INT8U)~(INT8U)OS_STAT_FLAG;
1221:./ucos/Core/os_flag.c ****     ptcb->OSTCBStatPend  = pend_stat;
1222:./ucos/Core/os_flag.c ****     if (ptcb->OSTCBStat == OS_STAT_RDY) {                  /* Task now ready?                      
1223:./ucos/Core/os_flag.c ****         OSRdyGrp               |= ptcb->OSTCBBitY;         /* Put task into ready list             
1224:./ucos/Core/os_flag.c ****         OSRdyTbl[ptcb->OSTCBY] |= ptcb->OSTCBBitX;
1225:./ucos/Core/os_flag.c ****         OS_TRACE_TASK_READY(ptcb);
1226:./ucos/Core/os_flag.c ****         sched                   = OS_TRUE;
1227:./ucos/Core/os_flag.c ****     } else {
1228:./ucos/Core/os_flag.c ****         sched                   = OS_FALSE;
1229:./ucos/Core/os_flag.c ****     }
1230:./ucos/Core/os_flag.c ****     OS_FlagUnlink(pnode);
1231:./ucos/Core/os_flag.c ****     return (sched);
1232:./ucos/Core/os_flag.c **** }
