 183:./ucos/Core/os_flag.c ****                  if (consume == OS_TRUE) {                 /* See if we need to consume the flags  
 184:./ucos/Core/os_flag.c ****                      pgrp->OSFlagFlags |= flags_rdy;       /* Set ONLY the flags that we got       
 185:./ucos/Core/os_flag.c ****                  }
 186:./ucos/Core/os_flag.c ****              } else {
 187:./ucos/Core/os_flag.c ****                  *perr = OS_ERR_FLAG_NOT_RDY;
