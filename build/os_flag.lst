  48:./ucos/Core/os_flag.c **** /*
  49:./ucos/Core/os_flag.c **** ***************************************************************************************************
  50:./ucos/Core/os_flag.c **** *                          CHECK THE STATUS OF FLAGS IN AN EVENT FLAG GROUP
  51:./ucos/Core/os_flag.c **** *
  52:./ucos/Core/os_flag.c **** * Description: This function is called to check the status of a combination of bits to be set or cl
  53:./ucos/Core/os_flag.c **** *              in an event flag group.  Your application can check for ANY bit to be set/cleared or
  54:./ucos/Core/os_flag.c **** *              bits to be set/cleared.
  55:./ucos/Core/os_flag.c **** *
  56:./ucos/Core/os_flag.c **** *              This call does not block if the desired flags are not present.
  57:./ucos/Core/os_flag.c **** *
  58:./ucos/Core/os_flag.c **** * Arguments  : pgrp          is a pointer to the desired event flag group.
  59:./ucos/Core/os_flag.c **** *
  60:./ucos/Core/os_flag.c **** *              flags         Is a bit pattern indicating which bit(s) (i.e. flags) you wish to chec
  61:./ucos/Core/os_flag.c **** *                            The bits you want are specified by setting the corresponding bits in
  62:./ucos/Core/os_flag.c **** *                            'flags'.  e.g. if your application wants to wait for bits 0 and 1 then
  63:./ucos/Core/os_flag.c **** *                            'flags' would contain 0x03.
  64:./ucos/Core/os_flag.c **** *
  65:./ucos/Core/os_flag.c **** *              wait_type     specifies whether you want ALL bits to be set/cleared or ANY of the bi
  66:./ucos/Core/os_flag.c **** *                            to be set/cleared.
  67:./ucos/Core/os_flag.c **** *                            You can specify the following argument:
  68:./ucos/Core/os_flag.c **** *
  69:./ucos/Core/os_flag.c **** *                            OS_FLAG_WAIT_CLR_ALL   You will check ALL bits in 'flags' to be clear 
  70:./ucos/Core/os_flag.c **** *                            OS_FLAG_WAIT_CLR_ANY   You will check ANY bit  in 'flags' to be clear 
  71:./ucos/Core/os_flag.c **** *                            OS_FLAG_WAIT_SET_ALL   You will check ALL bits in 'flags' to be set   
  72:./ucos/Core/os_flag.c **** *                            OS_FLAG_WAIT_SET_ANY   You will check ANY bit  in 'flags' to be set   
  73:./ucos/Core/os_flag.c **** *
  74:./ucos/Core/os_flag.c **** *                            NOTE: Add OS_FLAG_CONSUME if you want the event flag to be 'consumed' 
  75:./ucos/Core/os_flag.c **** *                                  the call.  Example, to wait for any flag in a group AND then cle
  76:./ucos/Core/os_flag.c **** *                                  the flags that are present, set 'wait_type' to:
  77:./ucos/Core/os_flag.c **** *
  78:./ucos/Core/os_flag.c **** *                                  OS_FLAG_WAIT_SET_ANY + OS_FLAG_CONSUME
  79:./ucos/Core/os_flag.c **** *
  80:./ucos/Core/os_flag.c **** *              perr          is a pointer to an error code and can be:
  81:./ucos/Core/os_flag.c **** *                            OS_ERR_NONE               No error
  82:./ucos/Core/os_flag.c **** *                            OS_ERR_EVENT_TYPE         You are not pointing to an event flag group
  83:./ucos/Core/os_flag.c **** *                            OS_ERR_FLAG_WAIT_TYPE     You didn't specify a proper 'wait_type' argu
  84:./ucos/Core/os_flag.c **** *                            OS_ERR_FLAG_INVALID_PGRP  You passed a NULL pointer instead of the eve
  85:./ucos/Core/os_flag.c **** *                                                      group handle.
  86:./ucos/Core/os_flag.c **** *                            OS_ERR_FLAG_NOT_RDY       The desired flags you are waiting for are no
  87:./ucos/Core/os_flag.c **** *                                                      available.
ARM GAS  /tmp/ccjnSGoX.s 			page 3


  88:./ucos/Core/os_flag.c **** *
  89:./ucos/Core/os_flag.c **** * Returns    : The flags in the event flag group that made the task ready or, 0 if a timeout or an 
  90:./ucos/Core/os_flag.c **** *              occurred.
  91:./ucos/Core/os_flag.c **** *
  92:./ucos/Core/os_flag.c **** * Called from: Task or ISR
  93:./ucos/Core/os_flag.c **** *
  94:./ucos/Core/os_flag.c **** * Note(s)    : 1) IMPORTANT, the behavior of this function has changed from PREVIOUS versions.  The
  95:./ucos/Core/os_flag.c **** *                 function NOW returns the flags that were ready INSTEAD of the current state of th
  96:./ucos/Core/os_flag.c **** *                 event flags.
  97:./ucos/Core/os_flag.c **** ***************************************************************************************************
  98:./ucos/Core/os_flag.c **** */
  99:./ucos/Core/os_flag.c **** 
 100:./ucos/Core/os_flag.c **** #if OS_FLAG_ACCEPT_EN > 0u
 101:./ucos/Core/os_flag.c **** OS_FLAGS  OSFlagAccept (OS_FLAG_GRP  *pgrp,
 102:./ucos/Core/os_flag.c ****                         OS_FLAGS      flags,
 103:./ucos/Core/os_flag.c ****                         INT8U         wait_type,
 104:./ucos/Core/os_flag.c ****                         INT8U        *perr)
 105:./ucos/Core/os_flag.c **** {
 106:./ucos/Core/os_flag.c ****     OS_FLAGS      flags_rdy;
 107:./ucos/Core/os_flag.c ****     INT8U         result;
 108:./ucos/Core/os_flag.c ****     BOOLEAN       consume;
 109:./ucos/Core/os_flag.c **** #if OS_CRITICAL_METHOD == 3u                               /* Allocate storage for CPU status regis
 110:./ucos/Core/os_flag.c ****     OS_CPU_SR     cpu_sr = 0u;
 111:./ucos/Core/os_flag.c **** #endif
 112:./ucos/Core/os_flag.c **** 
 113:./ucos/Core/os_flag.c **** 
 114:./ucos/Core/os_flag.c **** 
 115:./ucos/Core/os_flag.c **** #ifdef OS_SAFETY_CRITICAL
 116:./ucos/Core/os_flag.c ****     if (perr == (INT8U *)0) {
 117:./ucos/Core/os_flag.c ****         OS_SAFETY_CRITICAL_EXCEPTION();
 118:./ucos/Core/os_flag.c ****         return ((OS_FLAGS)0);
 119:./ucos/Core/os_flag.c ****     }
 120:./ucos/Core/os_flag.c **** #endif
 121:./ucos/Core/os_flag.c **** 
 122:./ucos/Core/os_flag.c **** #if OS_ARG_CHK_EN > 0u
 123:./ucos/Core/os_flag.c ****     if (pgrp == (OS_FLAG_GRP *)0) {                        /* Validate 'pgrp'                      
 124:./ucos/Core/os_flag.c ****         *perr = OS_ERR_FLAG_INVALID_PGRP;
 125:./ucos/Core/os_flag.c ****         return ((OS_FLAGS)0);
 126:./ucos/Core/os_flag.c ****     }
 127:./ucos/Core/os_flag.c **** #endif
 128:./ucos/Core/os_flag.c ****     if (pgrp->OSFlagType != OS_EVENT_TYPE_FLAG) {          /* Validate event block type            
 129:./ucos/Core/os_flag.c ****         *perr = OS_ERR_EVENT_TYPE;
 130:./ucos/Core/os_flag.c ****         return ((OS_FLAGS)0);
 131:./ucos/Core/os_flag.c ****     }
 132:./ucos/Core/os_flag.c ****     result = (INT8U)(wait_type & OS_FLAG_CONSUME);
 133:./ucos/Core/os_flag.c ****     if (result != (INT8U)0) {                              /* See if we need to consume the flags  
 134:./ucos/Core/os_flag.c ****         wait_type &= ~OS_FLAG_CONSUME;
 135:./ucos/Core/os_flag.c ****         consume    = OS_TRUE;
 136:./ucos/Core/os_flag.c ****     } else {
 137:./ucos/Core/os_flag.c ****         consume    = OS_FALSE;
 138:./ucos/Core/os_flag.c ****     }
 139:./ucos/Core/os_flag.c **** 
 140:./ucos/Core/os_flag.c ****     *perr = OS_ERR_NONE;                                   /* Assume NO error until proven otherwis
 141:./ucos/Core/os_flag.c ****     OS_ENTER_CRITICAL();
 142:./ucos/Core/os_flag.c ****     switch (wait_type) {
 143:./ucos/Core/os_flag.c ****         case OS_FLAG_WAIT_SET_ALL:                         /* See if all required flags are set    
 144:./ucos/Core/os_flag.c ****              flags_rdy = (OS_FLAGS)(pgrp->OSFlagFlags & flags);     /* Extract only the bits we wan
ARM GAS  /tmp/ccjnSGoX.s 			page 4


 145:./ucos/Core/os_flag.c ****              if (flags_rdy == flags) {                     /* Must match ALL the bits that we want 
 146:./ucos/Core/os_flag.c ****                  if (consume == OS_TRUE) {                 /* See if we need to consume the flags  
 147:./ucos/Core/os_flag.c ****                      pgrp->OSFlagFlags &= (OS_FLAGS)~flags_rdy;     /* Clear ONLY the flags we want
 148:./ucos/Core/os_flag.c ****                  }
 149:./ucos/Core/os_flag.c ****              } else {
 150:./ucos/Core/os_flag.c ****                  *perr = OS_ERR_FLAG_NOT_RDY;
 151:./ucos/Core/os_flag.c ****              }
 152:./ucos/Core/os_flag.c ****              OS_EXIT_CRITICAL();
 153:./ucos/Core/os_flag.c ****              break;
 154:./ucos/Core/os_flag.c **** 
 155:./ucos/Core/os_flag.c ****         case OS_FLAG_WAIT_SET_ANY:
 156:./ucos/Core/os_flag.c ****              flags_rdy = (OS_FLAGS)(pgrp->OSFlagFlags & flags);     /* Extract only the bits we wan
 157:./ucos/Core/os_flag.c ****              if (flags_rdy != (OS_FLAGS)0) {               /* See if any flag set                  
 158:./ucos/Core/os_flag.c ****                  if (consume == OS_TRUE) {                 /* See if we need to consume the flags  
 159:./ucos/Core/os_flag.c ****                      pgrp->OSFlagFlags &= (OS_FLAGS)~flags_rdy;     /* Clear ONLY the flags we got 
 160:./ucos/Core/os_flag.c ****                  }
 161:./ucos/Core/os_flag.c ****              } else {
 162:./ucos/Core/os_flag.c ****                  *perr = OS_ERR_FLAG_NOT_RDY;
 163:./ucos/Core/os_flag.c ****              }
 164:./ucos/Core/os_flag.c ****              OS_EXIT_CRITICAL();
 165:./ucos/Core/os_flag.c ****              break;
 166:./ucos/Core/os_flag.c **** 
 167:./ucos/Core/os_flag.c **** #if OS_FLAG_WAIT_CLR_EN > 0u
 168:./ucos/Core/os_flag.c ****         case OS_FLAG_WAIT_CLR_ALL:                         /* See if all required flags are cleared
 169:./ucos/Core/os_flag.c ****              flags_rdy = (OS_FLAGS)~pgrp->OSFlagFlags & flags;    /* Extract only the bits we want 
